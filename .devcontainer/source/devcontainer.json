{
  // Configuration SOURCE : fabrique l'image publiée sur ghcr.io (voir le workflow
  // devcontainer-publish), et sert de secours si l'image est indisponible : dans GitHub,
  // « New with options… » puis cette configuration reconstruit tout sur place.
  "name": "Youth AI Lab — build the image locally (fallback)",
  "build": {
    "dockerfile": "Dockerfile",
    // Racine du dépôt, pour que le Dockerfile lise .devcontainer/bin et claude-version.
    "context": "../.."
  },
  // Docker dans le Codespace, pour la commande openwebui (démo RAG et chatbot du binôme dans
  // Open WebUI). Intégré à l'image publiée : ses réglages (privileged, démarrage du démon)
  // voyagent dans les métadonnées de l'image, la configuration distribuée n'a rien à ajouter.
  "features": {
    // Version 4: the docker-init script chooses iptables when the container starts (legacy only if
    // the host has loaded ip_tables, nft otherwise), so the Docker inside works on recent kernels
    // that do not load the legacy tables (Ubuntu 26.04, kernel 7.0) without changing the host.
    "ghcr.io/devcontainers/features/docker-in-docker:4": {},
    // zsh et oh-my-zsh pour l'utilisateur vscode, comme dans les TP R2.02 (déjà dans l'image de
    // base : la feature le garantit). Pas de mise à jour des paquets : l'image reste reproductible.
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "installOhMyZsh": true,
      "upgradePackages": false,
      "username": "vscode",
      "uid": "1000",
      "gid": "1000"
    }
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "WORKSHOP_HOME": "${containerWorkspaceFolder}"
  },
  // Open WebUI occupe environ 1,5 Go : 8 Go de mémoire (machine à 2 cœurs, celle par défaut).
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  // Lecteur PDF (mathematic.vscode-pdf : tomoki1207.pdf est désactivée dans le navigateur).
  // Bloc F : la carte du wiki (wiki-explore) s'ouvre d'elle-même dans un onglet du navigateur.
  // Open WebUI : la commande affiche l'adresse quand tout est chargé (pas d'onglet ouvert avant).
  "portsAttributes": {
    "8765": { "label": "Wiki graph", "onAutoForward": "openBrowser" },
    "3000": { "label": "Open WebUI", "onAutoForward": "silent" }
  },
  // Ces réglages voyagent eux aussi dans les métadonnées de l'image : le kit et les guides ont zsh
  // dans chaque nouveau terminal sans rien ajouter à leur configuration.
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.profiles.linux": { "zsh": { "path": "zsh" } },
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": ["mathematic.vscode-pdf", "bierner.markdown-mermaid"]
    }
  }
}
