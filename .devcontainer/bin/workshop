#!/usr/bin/env bash
# Starts the workshop chatbot in one of the modes of the grid.
#
#   workshop bare   the model alone: no system prompt file, no tools, no skills, no MCP
#   workshop A      + system prompt (AGENTS.md)
#   workshop B      + everything in the context from the start: summaries/ and corpus/
#   workshop C      system prompt + file search + skills + MCP (nothing preloaded)
#   workshop W      system prompt + reading wiki/ only (summaries/, corpus/ blocked)
#
# Without a mode: C. Arguments after the mode are passed to claude
# (this is how `replay` asks its questions: workshop B -p "question").
set -euo pipefail

KIT="${WORKSHOP_HOME:-$HOME/workshop}"
BARE_DIR="${WORKSHOP_BARE_DIR:-$HOME/.workshop-bare}"
RUN_DIR="${WORKSHOP_RUN_DIR:-$HOME/.workshop-run}"
MOD_DIR="${WORKSHOP_MOD_DIR:-/opt/workshop/claude-code-playground/claude-code/mods/token-weather}"

mode="C"
if [[ $# -gt 0 && "$1" != -* ]]; then mode="$1"; shift; fi

if [[ "$mode" != help && "$mode" != -h && "$mode" != --help ]] \
   && ! grep -qsE '"apiKeyHelper"|"ANTHROPIC_AUTH_TOKEN"' "$HOME/.claude/settings.json"; then
  echo "No API key yet. Type: workshop-login" >&2
  exit 1
fi

# All modes: only the kit's MCP server can be loaded, and only in C.
args=(--strict-mcp-config)
[[ -d "$MOD_DIR" ]] && args+=(--plugin-dir "$MOD_DIR")

# Read-only commands allowed without confirmation in C (file search goes through Bash).
read_only=("Bash(ls:*)" "Bash(grep:*)" "Bash(rg:*)" "Bash(cat:*)" "Bash(head:*)" "Bash(wc:*)"
           "Bash(find:*)" "mcp__fire-danger")

case "$mode" in
  bare|Bare|BARE)
    # Empty directory outside the kit: no CLAUDE.md can be found from here.
    mkdir -p "$BARE_DIR"
    cd "$BARE_DIR"
    args+=(--tools "" --disable-slash-commands)
    ;;
  A|a)
    cd "$KIT"
    args+=(--tools "" --disable-slash-commands)
    ;;
  B|b)
    cd "$KIT"
    mkdir -p "$RUN_DIR"
    everything="$RUN_DIR/knowledge-in-context.md"
    {
      echo "# Reference knowledge, loaded in full at startup:"
      echo "# summaries/ (short verified summaries, one per source) and corpus/ (the full official texts)"
      # The summaries and the readable copy of every official document (corpus/text/);
      # never the originals (HTML, PDF, Word), which are far too big or not text.
      for f in summaries/*.md corpus/text/*.md; do
        case "$(basename "$f")" in index.md|README.md|00-*) continue ;; esac
        printf '\n\n## Document: %s\n\n' "$f"
        cat "$f"
      done
    } > "$everything"
    args+=(--tools "" --disable-slash-commands --append-system-prompt-file "$everything")
    ;;
  C|c)
    # The model knows where the knowledge is; it decides what to read.
    cd "$KIT"
    args+=(--tools "Read,Bash,Edit,Write,Skill" --allowedTools "${read_only[@]}"
           --mcp-config "$KIT/.mcp.json"
           --append-system-prompt "The reference knowledge is in two folders, each with an index.md catalogue: summaries/ (short verified summaries in English, one per source: start there) and corpus/ (the full official documents in their original language: go there for details or when the summaries are not enough; read and search their readable copies in corpus/text/, not the original HTML, PDF or Word files). For a question about the topic, search them before answering, and say which document you used.")
    ;;
  W|w)
    # Only reading, and reading summaries/ and corpus/ is denied by permission rules (not just
    # asked): the answer can only come from wiki/ (and the system prompt).
    cd "$KIT"
    args+=(--tools "Read" --disallowedTools "Read(./summaries/**)" "Read(./corpus/**)" --disable-slash-commands
           --append-system-prompt "To answer, first read wiki/index.md, then the relevant pages of wiki/. You cannot open summaries/ or corpus/. If the wiki does not contain the answer, say so.")
    ;;
  -h|--help|help)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "Unknown mode: $mode. Modes: bare, A, B, C, W (workshop help)." >&2
    exit 1
    ;;
esac

# Banner, except when a question is asked directly (-p): the output must stay clean.
if [[ " $* " != *" -p "* && " $* " != *" --print "* ]]; then
  echo "Workshop — mode $mode. To quit: /exit. Other modes: workshop bare | A | B | C | W" >&2
fi
# WORKSHOP_DRY_RUN=1: print the command instead of running it (used by the smoke test).
if [[ -n "${WORKSHOP_DRY_RUN:-}" ]]; then
  printf '%s\n' "cwd=$PWD" "${args[@]}" "$@"
  exit 0
fi
exec claude "${args[@]}" "$@"
