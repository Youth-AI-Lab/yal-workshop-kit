#!/usr/bin/env bash
# Starts the workshop chatbot in one of the modes of the grid.
#
#   workshop bare   the model alone: no system prompt file, no tools, no skills, no MCP
#   workshop A      + system prompt (AGENTS.md)
#   workshop B      + everything in the context from the start: summaries/ and corpus/
#   workshop C      system prompt + file search + skills (nothing preloaded)
#   workshop D      C + live tools through MCP (today's fire danger level; the time)
#   workshop E      D + the wiki (wiki/), read first: the complete chatbot (after wiki-start)
#   workshop F      E + the wiki as a knowledge graph (graphify), queried through MCP tools
#
# Without a mode: D. Arguments after the mode are passed to claude
# (this is how `replay` asks its questions: workshop B -p "question").
#
# Other instructions, without touching AGENTS.md (modes A to F; bare has none):
#   WORKSHOP_AGENTS=examples/AGENTS.liar.md workshop A
# (this is how `replay A --agents examples/AGENTS.liar.md` tries a demo personality).
#
# Engine: Claude Code, or OpenCode after `workshop-login --engine opencode` (the same modes).
# For one command only: WORKSHOP_ENGINE=opencode workshop C
#
# Workshop 4, to go further (modes D, E, F): WORKSHOP_WEATHER=1 workshop D adds a weather tool
# (Open-Meteo); FIRE_DANGER_RECORDED=1 workshop D adds a past day of fire danger (never today).
set -euo pipefail

KIT="${WORKSHOP_HOME:-$HOME/workshop}"
BARE_DIR="${WORKSHOP_BARE_DIR:-$HOME/.workshop-bare}"
RUN_DIR="${WORKSHOP_RUN_DIR:-$HOME/.workshop-run}"
MOD_DIR="${WORKSHOP_MOD_DIR:-/opt/workshop/claude-code-playground/claude-code/mods/token-weather}"
GRAPHIFY_MCP="${WORKSHOP_GRAPHIFY_MCP:-/opt/workshop/venv/bin/graphify-mcp}"

mode="D"
if [[ $# -gt 0 && "$1" != -* ]]; then mode="$1"; shift; fi

# The engine saved by workshop-login (Claude Code if none), unless WORKSHOP_ENGINE says otherwise.
engine="${WORKSHOP_ENGINE:-}"
if [[ -z "$engine" && -f "$HOME/.workshop-engine" ]]; then
  engine="$(tr -d '[:space:]' < "$HOME/.workshop-engine")"
fi
engine="${engine:-claude}"

if [[ "$mode" != help && "$mode" != -h && "$mode" != --help ]]; then
  case "$engine" in
    claude) grep -qs '"apiKeyHelper"' "$HOME/.claude/settings.json" && key=yes || key="" ;;
    opencode) [[ -s "$HOME/.workshop-key" ]] && key=yes || key="" ;;
    *) echo "Unknown engine: $engine (claude or opencode). Type: workshop-login" >&2; exit 1 ;;
  esac
  if [[ -z "$key" && "$engine" == claude ]] && head -c 6 "$HOME/.workshop-key" 2>/dev/null | grep -qx 'sk-or-'; then
    # A key is saved, but an OpenRouter one: Claude Code in the workshop never gets it.
    echo "The saved key is an OpenRouter key: it works with OpenCode only (workshop-login --engine opencode)." >&2
    echo "For Claude Code, type workshop-login and paste an Anthropic key (it starts with sk-ant-)." >&2
    exit 1
  fi
  if [[ -z "$key" ]]; then
    echo "No API key yet. Type: workshop-login" >&2
    exit 1
  fi
fi

# OpenCode: workshop-opencode sets up the same modes (help and unknown modes: below, shared).
if [[ "$engine" == opencode ]]; then
  case "$mode" in
    bare|Bare|BARE|[AaBbCcDdEeFf])
      oc="$(dirname "$(realpath "$0")")/workshop-opencode"
      [[ -x "$oc" ]] || oc=workshop-opencode
      exec "$oc" "$mode" "$@"
      ;;
  esac
fi

# No link with VS Code: otherwise Claude Code connects to the editor, gives the model its own
# tools (even in modes bare, A and B) and sends it the open files and the selected lines (for
# instance an expected answer of test-questions.md). It also skips installing that extension.
export CLAUDE_CODE_AUTO_CONNECT_IDE=false CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL=1
# No automatic memory (it would carry facts from one conversation to the next, and break the
# fresh session of each replay question), and no git status of the kit in the context.
export CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1

# WORKSHOP_AGENTS=<file>: the chatbot follows this file instead of AGENTS.md, which stays as it
# is. Claude Code still starts in the kit, so search, skills and MCP see the real folders; the
# kit's CLAUDE.md is excluded, and a run folder holding a copy of the file as its CLAUDE.md is
# added as a working directory whose CLAUDE.md is loaded: the same way into the context as
# AGENTS.md, HTML comments left out. A copy, not "@AGENTS.md": Claude Code does not follow an
# import out of the kit without asking (and nobody can answer during replay). Not a copy of the
# kit made of symlinks either: grep -r, find and rg do not follow symlinked folders.
agents_dir=""
excludes=""
case "$mode" in
  help|-h|--help) ;;
  bare|Bare|BARE)
    [[ -n "${WORKSHOP_AGENTS:-}" ]] \
      && echo "Mode bare has no instructions at all: WORKSHOP_AGENTS is ignored." >&2
    ;;
  *)
    if [[ -n "${WORKSHOP_AGENTS:-}" ]]; then
      agents="$WORKSHOP_AGENTS"
      # A relative path: from here, or else from the kit (examples/AGENTS.liar.md).
      [[ "$agents" != /* && ! -f "$agents" && -f "$KIT/$agents" ]] && agents="$KIT/$agents"
      if [[ ! -f "$agents" ]]; then
        echo "Instructions file not found: $WORKSHOP_AGENTS" >&2
        echo "Give the path of a file, for example: examples/AGENTS.feurisson.md" >&2
        exit 1
      fi
      # Name of the run folder: AGENTS.liar.md -> liar, My bot.md -> my-bot (same rule as replay).
      name="$(basename "$agents")"; name="${name%.md}"; name="${name#AGENTS.}"
      name="$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
      # A new folder at each start, so a fresh copy of the file: two sessions with the same file
      # (one person chats while the other runs replay) never delete each other's copy. Run
      # folders older than a day are removed first, so they do not pile up.
      mkdir -p "$RUN_DIR"
      find "$RUN_DIR" -maxdepth 1 -type d -name 'agents-*' -mmin +1440 -exec rm -rf {} + 2>/dev/null || true
      agents_dir="$(mktemp -d "$RUN_DIR/agents-${name:-custom}-XXXXXX")"
      cp "$agents" "$agents_dir/CLAUDE.md"
      # The kit's own instructions are left out (both spellings of its path, in case of a link).
      excludes="$(python3 -c 'import json, sys; print(json.dumps(sorted(set(sys.argv[1:]))))' \
        "$KIT/CLAUDE.md" "$KIT/AGENTS.md" "$(realpath "$KIT")/CLAUDE.md" "$(realpath "$KIT")/AGENTS.md")"
      export CLAUDE_CODE_ADDITIONAL_DIRECTORIES_CLAUDE_MD=1
    fi
    ;;
esac

# All modes: only the kit's MCP servers (.mcp.json) can be loaded, and only in D, E and F. Permission mode
# "manual" (not the default "auto"): Claude Code asks you before it writes a file. The auto and
# bypass modes are switched off, so a permission prompt cannot offer "switch to auto mode".
settings='{"permissions": {"disableAutoMode": "disable", "disableBypassPermissionsMode": "disable"}}'
[[ -n "$excludes" ]] && settings="${settings%\}}, \"claudeMdExcludes\": $excludes}"
args=(--strict-mcp-config --permission-mode manual --settings "$settings")
[[ -n "$agents_dir" ]] && args+=(--add-dir "$agents_dir")
[[ -d "$MOD_DIR" ]] && args+=(--plugin-dir "$MOD_DIR")

# Read-only commands allowed without confirmation from C on (file search goes through Bash).
# No rg: "rg --pre <program>" runs a program, and a Bash(rg:*) rule would let it through.
read_only=("Bash(ls:*)" "Bash(grep:*)" "Bash(cat:*)" "Bash(head:*)" "Bash(wc:*)"
           "Bash(find:*)")
# The test material (expected answers, earlier answers, example prompt) is not a source: the
# prompt says so, and replay flags any answer where the model saw it. No Read() deny rule: with
# one, Claude Code asks permission for every "cd …; grep …", and nobody can answer during replay.
knowledge="The reference knowledge is in two folders, each with an index.md catalogue: summaries/ (short summaries in English, one per source: start there; their OKF header, up to the second ---, says who verified them: \"status: draft\" means not yet checked by a person) and corpus/ (the full official documents in their original language: go there for details or when the summaries are not enough; read and search their readable copies in corpus/text/, not the original HTML, PDF or Word files). For a question about the topic, search them before answering, and say which document you used. Never open or search test-questions.md, scores.md, answers/ or examples/: they are the test material of the workshop, not sources. You are already in the kit folder: run your commands from here, without cd. To create or change a file, use the Write and Edit tools, never shell commands (cat >, sed -i, printf >>): the person sees exactly what changes before accepting."

# Modes A and B have no tools, but Claude Code's own instructions still describe them: an AGENTS.md
# that asks to name a document made the model write fake tool calls as text instead of an answer
# (Haiku, then Sonnet 5.5). The facilitator's choice (2026-10-27): say it plainly.
no_tools="You have no tools in this conversation: you cannot open, search or read any file. Answer from what you know and from these instructions, and never write tool calls."

case "$mode" in
  bare|Bare|BARE)
    # Empty directory outside the kit: no CLAUDE.md can be found from here.
    mkdir -p "$BARE_DIR"
    cd "$BARE_DIR"
    args+=(--tools "" --disable-slash-commands)
    ;;
  A|a)
    cd "$KIT"
    args+=(--tools "" --disable-slash-commands --append-system-prompt "$no_tools")
    ;;
  B|b)
    cd "$KIT"
    mkdir -p "$RUN_DIR"
    everything="$RUN_DIR/knowledge-in-context.md"
    {
      echo "$no_tools"
      echo
      echo "# Reference knowledge, loaded in full at startup:"
      echo "# summaries/ (short summaries, one per source; their header says who verified them) and"
      echo "# corpus/text/ (readable copies of the full official documents)"
      # The summaries and the readable copy of every official document (corpus/text/);
      # never the originals (HTML, PDF, Word), which are far too big or not text.
      for f in summaries/*.md corpus/text/*.md; do
        case "$(basename "$f")" in index.md|README.md|00-*) continue ;; esac
        printf '\n\n## Document: %s\n\n' "$f"
        cat "$f"
      done
    } > "$everything"
    args+=(--tools "" --disable-slash-commands --append-system-prompt-file "$everything")
    ;;
  C|c)
    # The model knows where the knowledge is; it decides what to read. Skills, no MCP.
    cd "$KIT"
    args+=(--tools "Read,Bash,Edit,Write,Skill" --allowedTools "${read_only[@]}"
           --append-system-prompt "$knowledge")
    ;;
  D|d)
    # C + the MCP servers of the kit: deterministic tools that read live data (fire-danger, ours)
    # and give the time (time, the official reference server, installed in the image).
    cd "$KIT"
    args+=(--tools "Read,Bash,Edit,Write,Skill" --allowedTools "${read_only[@]}" "mcp__fire-danger" "mcp__time"
           --mcp-config "$KIT/.mcp.json" --append-system-prompt "$knowledge")
    ;;
  E|e)
    # D + the wiki, installed by wiki-start: pages by topic, read before the sources.
    cd "$KIT"
    if [[ ! -f "$KIT/wiki/index.md" ]]; then
      echo "No wiki yet. First type: wiki-start" >&2
      exit 1
    fi
    args+=(--tools "Read,Bash,Edit,Write,Skill" --allowedTools "${read_only[@]}" "mcp__fire-danger" "mcp__time"
           --mcp-config "$KIT/.mcp.json"
           --append-system-prompt "To answer, first read wiki/index.md, then the relevant pages of wiki/: each fact there has a footnote to its source. If the wiki is not enough, search the sources. $knowledge")
    ;;
  F|f)
    # E + the graph of the wiki built by graphify (wiki/graphify-out/graph.json), served by
    # graphify's MCP server: the model can query the graph before it opens a page.
    cd "$KIT"
    if [[ ! -f "$KIT/wiki/graphify-out/graph.json" ]]; then
      echo "No graph of the wiki yet. First type: wiki-start" >&2
      exit 1
    fi
    mkdir -p "$RUN_DIR"
    python3 - "$KIT/.mcp.json" "$GRAPHIFY_MCP" "$KIT/wiki/graphify-out/graph.json" > "$RUN_DIR/mcp-f.json" <<'PY'
import json, sys
config = json.load(open(sys.argv[1], encoding="utf-8"))
config["mcpServers"]["graphify"] = {"command": sys.argv[2], "args": [sys.argv[3]]}
print(json.dumps(config, indent=2))
PY
    args+=(--tools "Read,Bash,Edit,Write,Skill" --allowedTools "${read_only[@]}" "mcp__fire-danger" "mcp__time" "mcp__graphify"
           --disallowedTools "mcp__graphify__list_prs" "mcp__graphify__get_pr_impact" "mcp__graphify__triage_prs"
           --mcp-config "$RUN_DIR/mcp-f.json"
           --append-system-prompt "The wiki (wiki/) is also available as a knowledge graph, through the graphify tools (query_graph, get_node, get_neighbors, shortest_path): each node is a concept, an organisation, a rule or a page of the wiki, with the page it comes from. To answer, first query the graph to find the relevant nodes and pages, then read only those wiki pages to get the exact facts and their footnotes. If the wiki is not enough, search the sources. $knowledge")
    ;;
  -h|--help|help)
    sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    echo "Unknown mode: $mode. Modes: bare, A, B, C, D, E, F (workshop help)." >&2
    exit 1
    ;;
esac

# Workshop 4, extension: WORKSHOP_WEATHER=1 adds the Open-Meteo server (.mcp.weather.json, installed
# in the image), reduced to two tools: the 15 others are not even shown to the model (their
# descriptions alone are about 100,000 characters). The same list as in workshop-opencode.
if [[ "${WORKSHOP_WEATHER:-}" == 1 ]]; then
  case "$mode" in
    D|d|E|e|F|f)
      hidden=()
      for t in weather_archive air_quality marine_weather elevation flood_forecast dwd_icon_forecast gfs_forecast \
               meteofrance_forecast ecmwf_forecast jma_forecast metno_forecast gem_forecast seasonal_forecast \
               climate_projection ensemble_forecast; do
        hidden+=("mcp__open-meteo__$t")
      done
      args+=(--mcp-config "$KIT/.mcp.weather.json"
             --allowedTools "mcp__open-meteo__weather_forecast" "mcp__open-meteo__geocoding"
             --disallowedTools "${hidden[@]}")
      ;;
    *)
      echo "WORKSHOP_WEATHER=1 works with modes D, E and F only." >&2
      exit 1
      ;;
  esac
fi

# Banner, except when a question is asked directly (-p): the output must stay clean.
if [[ " $* " != *" -p "* && " $* " != *" --print "* ]]; then
  echo "Workshop — mode $mode. To quit: press Ctrl+C twice. Other modes: workshop bare | A | B | C | D | E | F" >&2
  if [[ -n "$agents_dir" ]]; then
    echo "Instructions: $agents (a copy; AGENTS.md is not used)" >&2
    # The demo personalities of examples/ (liar, sophist, storyteller) carry this label.
    if grep -qF "Demo bot:" "$agents_dir/CLAUDE.md"; then
      echo "This demo bot makes deliberate errors." >&2
    fi
  fi
fi
# WORKSHOP_DRY_RUN=1: print the command instead of running it (used by the smoke test).
if [[ -n "${WORKSHOP_DRY_RUN:-}" ]]; then
  printf '%s\n' "cwd=$PWD" "${args[@]}" "$@"
  exit 0
fi
exec claude "${args[@]}" "$@"
