#!/usr/bin/env bash
# Saves the API key of this pair and configures the engine of the workshop chatbot.
#
#   workshop-login                     asks for the key (one * per character while you paste it)
#   workshop-login --key -             same, without asking: reads the key from the input (for scripts)
#   workshop-login --engine opencode   the chatbot runs in OpenCode instead of Claude Code (--engine claude: back)
#   workshop-login --model MODEL       OpenCode only: another model than the default one
#   workshop-login --models            lists the models you can use with the saved key
#   workshop-login --models openrouter the models of one provider (anthropic or openrouter)
#   workshop-login --models free       the free models of OpenRouter
#   workshop-login --europe            OpenRouter key only: from now on, every new chatbot or replay sends its
#                                      requests to zero-data-retention models hosted in Europe, or fails.
#                                      This is the setting for young people. A chatbot already open keeps its
#                                      old rule: close it and start it again
#   workshop-login --no-europe         removes that setting
#
# The key chooses the provider of every tool: sk-ant-... = Anthropic, sk-or-... = OpenRouter.
# Two engines: claude (Claude Code, the default) and opencode (OpenCode). Claude Code in the workshop
# needs an Anthropic key, so an OpenRouter key always runs in OpenCode. The engine comes from --engine,
# then WORKSHOP_ENGINE (for this command only, never saved), then the key, then the last workshop-login.
# Going back to an Anthropic key after an OpenRouter one also goes back to Claude Code, unless OpenCode
# was chosen with --engine.
# The key is tested with a short request, then stored in ~/.workshop-key (only you can read it). A key
# that does not work never replaces a working key of the other provider.
# Enter alone keeps the saved key and its model. A new key goes back to the default model, unless
# --model names one.
# --europe is saved with the provider: later logins with OpenRouter keep it, --no-europe removes it, a key of
# another provider drops it. Turning it on moves to the default model of that route, unless --model names
# another one. After that, a saved model stays. The test of the model says if Mistral does not serve it.
# OpenCode and Open WebUI read the rule when they start: this command says so if one of them is running. A replay
# stops before its next question, but the question it is on finishes under the old rule.
# It chooses where the model runs, not where OpenRouter handles the request (only eu.openrouter.ai, on the
# Business and Enterprise plans, keeps that in Europe). Accounts, billing and security logs may stay in the US.
# Also written: ~/.workshop-engine (claude or opencode), ~/.claude/settings.json (Claude Code) and
# ~/.workshop-opencode.json (OpenCode: provider and model, and for OpenRouter the size of the model's
# window, its price and "europe"). The key is in none of them: Claude Code reads it through apiKeyHelper,
# OpenCode through {file:~/.workshop-key} in its configuration.
set -euo pipefail

ANTHROPIC_MODEL_ID="${WORKSHOP_ANTHROPIC_MODEL:-claude-sonnet-5-5}"
OPENROUTER_API="${WORKSHOP_OPENROUTER_API:-https://openrouter.ai/api/v1}"   # another address: a fake endpoint in the tests
HERE="$(dirname "$(realpath "$0")")"                                       # workshop_provider.py is next to this file
KEY_FILE="$HOME/.workshop-key"
ENGINE_FILE="$HOME/.workshop-engine"
OPENCODE_FILE="$HOME/.workshop-opencode.json"
USAGE="Usage: workshop-login [--engine claude|opencode] [--model MODEL] [--europe|--no-europe]   (or: workshop-login --models [anthropic|openrouter|free])"
NOT_HERE='Type workshop-login alone, press Enter, then paste the key.'

# Class mode (Open WebUI guide, one teacher, no facilitator): the same steps, other words.
if [[ "${OPENWEBUI_MODE:-}" == class ]]; then
  ASK='Paste your API key, then press Enter'
  NEXT='openwebui start'
  REFUSED='Create a new key in the Claude Console (guide: "Your Anthropic API key"), then type workshop-login again.'
  OTHER='Check that your account has credits and that the key belongs to a workspace (guide: "Your Anthropic API key").'
else
  ASK='Paste the API key of your pair, then press Enter'
  NEXT='workshop bare'
  if [[ -f "${WORKSHOP_HOME:-$HOME/workshop}/sorter" ]]; then NEXT='workshop-start 6'; fi   # workshop 6: no chatbot
  REFUSED='Check it with the facilitator.'
  OTHER='Tell the facilitator.'
fi

# Before anything reads the options: --engine and --model repeat their value in their messages.
for arg in "$@"; do
  case "$arg" in *sk-ant-*|*sk-or-*) echo "$NOT_HERE" >&2; exit 1 ;; esac      # never echo a key pasted on the line
done

key=""; key_given=0; keep_model=0; engine=""; model=""; list_models=0; models_provider=""; europe_option=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --key)                                                    # only --key -: a key here would stay in ps and in the history
      [[ "${2:-}" == "-" ]] || { echo "$NOT_HERE" >&2; exit 1; }
      key="-"; key_given=1; shift 2 ;;
    --engine) engine="${2:?--engine needs a value: claude or opencode}"; shift 2 ;;
    --model) model="${2:?--model needs a model name}"; shift 2 ;;
    --europe) europe_option=on; shift ;;
    --no-europe) europe_option=off; shift ;;
    --models)
      list_models=1; shift
      case "${1:-}" in anthropic|openrouter|free) models_provider="$1"; shift ;; esac ;;
    -h|--help) sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; exit 0 ;;
    *) echo "Unknown option: $1" >&2; echo "$USAGE" >&2; exit 1 ;;
  esac
done

# The model ids OpenCode knows for these providers (anthropic, openrouter), one per line. They come
# from the catalogue built into OpenCode: no key and no network needed. Run in a throwaway home and
# temp folder, so that nothing of this run stays behind (OpenCode would otherwise create
# /tmp/opencode for this account only, and on the server the next participant could not use it).
catalogue() {
  local tmp allow="" providers="" p rc=0
  tmp="$(mktemp -d)"
  for p in "$@"; do
    allow+=",{\"action\":\"provider.use\",\"resource\":\"$p\",\"effect\":\"allow\"}"
    providers+="${providers:+,}\"$p\":{}"
  done
  (cd "$tmp" && env -i PATH="$PATH" HOME="$tmp" PWD="$tmp" TMPDIR="$tmp" \
      OPENCODE_DISABLE_AUTOUPDATE=1 OPENCODE_DISABLE_MODELS_FETCH=1 OPENCODE_DISABLE_FREE_MODELS=1 \
      OPENCODE_DISABLE_PROJECT_CONFIG=1 \
      OPENCODE_CONFIG_CONTENT="{\"policies\":[{\"action\":\"provider.use\",\"resource\":\"*\",\"effect\":\"deny\"}$allow],\"providers\":{$providers}}" \
      timeout 60 opencode models --standalone 2>/dev/null) || rc=$?
  rm -rf "$tmp"
  return "$rc"
}

need_opencode() {
  if ! command -v opencode >/dev/null; then
    if [[ "$key" == sk-or-* ]]; then
      echo "OpenCode is not installed here: an OpenRouter key needs it. Ask the facilitator." >&2
    else
      echo "OpenCode is not installed here. Ask the facilitator, or use Claude Code: workshop-login --engine claude" >&2
    fi
    exit 1
  fi
}

# OpenRouter's public list of models, read once and kept in a temp file until the end of this command.
# It needs no key. It prints the models that can use tools, as openrouter/<id>, and fails if the
# answer is not that list (no network, or the login page of a Wi-Fi network).
models_file="$(mktemp)"
trap 'rm -f "$models_file"' EXIT
live_list() {
  curl -s --max-time 20 -o "$models_file" "$OPENROUTER_API/models" 2>/dev/null || return 1
  python3 -I -c '
import json, sys
models = json.load(open(sys.argv[1], encoding="utf-8"))["data"]
ids = sorted(m["id"] for m in models if "tools" in (m.get("supported_parameters") or []))
if not ids:
    sys.exit(1)
print("\n".join("openrouter/" + i for i in ids))' "$models_file" 2>/dev/null
}

# The smallest window among the European companies of this model, from OpenRouter's public list of its
# companies (no key needed): the list of models can give a much larger one, from a company elsewhere.
# Prints nothing when it cannot be told.
europe_window() {
  curl -s --max-time 20 "$OPENROUTER_API/models/$model_id/endpoints" 2>/dev/null | python3 -I -c '
import json, sys
sys.path.insert(0, sys.argv[1])
import workshop_provider
endpoints = json.load(sys.stdin)["data"]["endpoints"]
print(min(e["context_length"] for e in endpoints
          if e.get("tag") in workshop_provider.EUROPE_ENDPOINTS and type(e.get("context_length")) is int and e["context_length"] > 0))' \
    "$HERE" 2>/dev/null || true
}

# What to add to ~/.workshop-opencode.json for this model: its window, and its price in dollars per
# million tokens. From the live list; without it, what was saved for the same model.
# $1: the window to write instead, when there is one (europe_window).
model_facts() {
  python3 -I -c '
import json, sys
from decimal import Decimal
models_file, settings_file, wanted, window = sys.argv[1:]
facts, found = {}, {}
try:
    found = next(m for m in json.load(open(models_file, encoding="utf-8"))["data"] if m.get("id") == wanted)
    if isinstance(found.get("context_length"), int) and found["context_length"] > 0:
        facts["context"] = found["context_length"]
    price = found["pricing"]
    cost = {"input": float(Decimal(price["prompt"]) * 1000000), "output": float(Decimal(price["completion"]) * 1000000)}
    if min(cost.values()) >= 0:  # a router model says -1: its price is not known in advance
        facts["cost"] = cost
except Exception:
    pass
if not found:
    try:
        saved = json.load(open(settings_file, encoding="utf-8"))
        if saved.get("model") == "openrouter/" + wanted:
            facts = {k: saved[k] for k in ("context", "cost") if k in saved}
    except Exception:
        pass
if window:
    facts["context"] = int(window)
print("".join(", %s: %s" % (json.dumps(k), json.dumps(v)) for k, v in facts.items()))' \
    "$models_file" "$OPENCODE_FILE" "$model_id" "${1:-}" 2>/dev/null || true
}

# The models of OpenRouter, one per line, for --models: the live list, else OpenCode's catalogue.
openrouter_models() {
  local ids
  if ! ids="$(live_list)"; then
    need_opencode
    echo "(OpenRouter's list of models could not be read: these names come from OpenCode's catalogue and may be old.)" >&2
    ids="$(catalogue openrouter)" || return 1
  fi
  if [[ "${1:-}" == free ]]; then
    grep ':free$' <<<"$ids" || true
  else
    printf '%s\n' "$ids"
  fi
}

# Close names in $list, the models of THIS key's provider (a dot and a dash count as the same:
# OpenRouter writes claude-sonnet-5.5 where Anthropic writes claude-sonnet-5-5).
show_close_names() {
  local wanted close
  wanted="${oc_model##*/}"; wanted="${wanted,,}"; wanted="${wanted//./-}"
  close="$(awk -v w="$wanted" '{ l = tolower($0); gsub(/\./, "-", l); if (index(l, w)) print "  " $0 }' \
           <<<"$list" | head -n 10)"
  [[ -n "$close" ]] && { echo "Close names for $provider_name:" >&2; echo "$close" >&2; }
  echo "See all the $provider_name models: workshop-login --models $provider" >&2
  echo "Nothing saved." >&2
}

# GET /key: what OpenRouter says of this key. The last line is the HTTP code. The body stays in the
# variable of the caller: it is read for the free quota, never printed.
key_info() {
  printf 'Authorization: Bearer %s\n' "$key" | curl -sS --max-time 30 -w '\n%{http_code}' \
    "$OPENROUTER_API/key" -H @- || true
}

# True when the input is OpenRouter's own answer: the login page of a Wi-Fi network can say 200 too.
key_answer_ok() {
  python3 -I -c '
import json, sys
sys.exit(0 if isinstance(json.load(sys.stdin).get("data"), dict) else 1)' 2>/dev/null
}

# One real request to the chosen model, with the routing of every OpenRouter call. Prints the kind of
# failure (see Reply in workshop_provider.py), or ok, then the HTTP code. The key goes through the input.
model_test() {
  printf '%s' "$key" | python3 -I -c '
import sys
sys.path.insert(0, sys.argv[1])
import workshop_provider
reply = workshop_provider.ask(sys.stdin.read(), ".", ".", model=sys.argv[2], max_tokens=16, url=sys.argv[3], timeout=60)
print(reply.kind or "ok", reply.status or 0, " ".join(reply.message.split())[:160])' "$HERE" "$model_id" "$OPENROUTER_API/chat/completions" 2>/dev/null \
    || echo "other 0"
}

# The name of an engine, for a person.
engine_name() {
  if [[ "$1" == opencode ]]; then echo OpenCode; else echo "Claude Code"; fi
}

# Writes the input to the file $1 in one step: nobody can read it, and a crash leaves the old file whole.
write_file() {
  local tmp
  tmp="$(mktemp "$1.XXXXXX")"
  if cat > "$tmp" && chmod 600 "$tmp" && mv -f "$tmp" "$1"; then return 0; fi
  rm -f "$tmp"
  return 1
}

if [[ "$list_models" == 1 ]]; then
  saved="$(cat "$KEY_FILE" 2>/dev/null || true)"
  [[ -n "$models_provider" ]] && saved="$models_provider"
  case "$saved" in
    anthropic|sk-ant-*) need_opencode; catalogue anthropic ;;
    openrouter|sk-or-*) openrouter_models ;;
    free) openrouter_models free ;;
    *) need_opencode; catalogue anthropic && openrouter_models ;;
  esac || { echo "OpenCode could not list its models. Tell the facilitator." >&2; exit 1; }
  case "$saved" in
    openrouter|sk-or-*|free) echo "To use one: workshop-login --model <name>" >&2 ;;
    *) echo "To use one: workshop-login --engine opencode --model <name>" >&2 ;;
  esac
  exit 0
fi

# Before asking for the key: an --engine or a model name that cannot work.
engine_option="${engine,,}"; engine_env="${WORKSHOP_ENGINE:-}"; engine_env="${engine_env,,}"
for e in "$engine_option" "$engine_env"; do
  case "$e" in
    claude|opencode|"") ;;
    *) echo "Unknown engine: $e. Type: workshop-login --engine claude (or --engine opencode)" >&2; exit 1 ;;
  esac
done
if [[ -n "$model" && ! "$model" =~ ^[A-Za-z0-9._:~/@-]+$ ]]; then
  echo "This does not look like a model name: $model. See the list: workshop-login --models" >&2
  exit 1
fi

if [[ "$key_given" == 1 && "$key" == "-" ]]; then
  IFS= read -r key || true                                    # --key -: one line from the input
elif [[ "$key_given" == 0 ]]; then
  # One * per character: you can see that the paste worked (the key itself is never shown).
  # The first paste in a browser may ask for permission: accept it, then paste once.
  if [[ -s "$KEY_FILE" ]]; then printf '%s (Enter alone keeps the saved key): ' "$ASK"; else printf '%s: ' "$ASK"; fi
  key=""
  while IFS= read -rsn1 c; do
    [[ -z "$c" ]] && break                                    # Enter
    if [[ "$c" == $'\x7f' || "$c" == $'\b' ]]; then           # Backspace
      [[ -n "$key" ]] && { key="${key%?}"; printf '\b \b'; }
      continue
    fi
    key+="$c"; printf '*'
  done
  echo
  if [[ -z "$(printf '%s' "$key" | tr -d '[:space:]')" && -s "$KEY_FILE" ]]; then
    key="$(cat "$KEY_FILE")"
    keep_model=1
    echo "Nothing pasted: the saved key is kept."
  fi
fi
key="$(printf '%s' "$key" | tr -d '[:space:]')"

if [[ -z "$key" ]]; then
  echo "Nothing was pasted. Copy the key again, then type workshop-login and paste it once." >&2
  exit 1
fi
if [[ "$key" =~ sk-(ant|or)-.*sk-(ant|or)- ]]; then
  echo "The key seems to have been pasted twice. Type workshop-login again and paste it only once." >&2
  exit 1
fi

if [[ ! "$key" =~ ^sk-(ant|or)-[A-Za-z0-9_-]+$ ]]; then
  if [[ "${OPENWEBUI_MODE:-}" == class ]]; then
    echo "This does not look like a key (it should start with sk-ant-, or sk-or- for OpenRouter). Nothing saved." >&2
  else
    echo "This does not look like a key (it should start with sk-ant-, or sk-or- for OpenRouter with OpenCode). Nothing saved." >&2
  fi
  exit 1
fi

# Before anything is saved or sent.
if [[ "$key" == sk-ant-* && "$europe_option" == on ]]; then
  echo "--europe needs an OpenRouter key (sk-or-…). This is an Anthropic key. Nothing saved." >&2
  exit 1
fi

# Engine: --engine, else WORKSHOP_ENGINE, else the key, else the saved one, else claude.
saved_key="$(cat "$KEY_FILE" 2>/dev/null || true)"
saved_engine="$(tr -d '[:space:]' 2>/dev/null < "$ENGINE_FILE" || true)"
explicit=false                                                # OpenCode was chosen with --engine
grep -qs '"engine_explicit": *true' "$OPENCODE_FILE" && explicit=true
if [[ "$key" == sk-or-* ]]; then
  from_key=opencode                                           # Claude Code never gets this key
elif [[ "$saved_key" == sk-or-* && "$explicit" == false ]]; then
  from_key=claude                                             # back from OpenRouter
else
  from_key="${saved_engine:-claude}"
fi
kept_engine="${engine_option:-$from_key}"                     # WORKSHOP_ENGINE is for this command only
engine="${engine_option:-${engine_env:-$from_key}}"
case "$engine" in
  claude|opencode) ;;
  *) echo "Unknown engine: $engine. Type: workshop-login --engine claude (or --engine opencode)" >&2; exit 1 ;;
esac
if [[ -n "$engine_option" ]]; then
  [[ "$engine_option" == opencode ]] && explicit=true || explicit=false
elif [[ "$kept_engine" != opencode ]]; then
  explicit=false
fi
if [[ "$key" == sk-or-* && "$engine" == claude ]]; then
  echo "This is an OpenRouter key: Claude Code in the workshop needs an Anthropic key (sk-ant-…)." >&2
  if [[ -n "$engine_option" ]]; then
    echo "OpenRouter works with OpenCode: type workshop-login without --engine claude." >&2
  else
    echo "OpenRouter works with OpenCode: type unset WORKSHOP_ENGINE, then workshop-login." >&2
  fi
  echo "Nothing saved." >&2
  exit 1
fi
if [[ -n "$model" && "$engine" != opencode ]]; then
  echo "--model works with OpenCode only: Claude Code in the workshop always uses $ANTHROPIC_MODEL_ID." >&2
  echo "For OpenCode: workshop-login --engine opencode --model $model" >&2
  exit 1
fi
[[ "$engine" == opencode ]] && need_opencode

# Provider and model. For OpenCode, the model is "<provider>/<model id>" (as in `opencode models`).
saved_europe=off; europe=off
if [[ "$key" == sk-ant-* ]]; then
  provider="anthropic"; provider_name="Anthropic"; oc_model="anthropic/$ANTHROPIC_MODEL_ID"
else
  provider="openrouter"; provider_name="OpenRouter"
  default_model="$(python3 -I -c '
import sys
sys.path.insert(0, sys.argv[1])
import workshop_provider
print(workshop_provider.OPENROUTER.chat, workshop_provider.OPENROUTER.small, workshop_provider.EUROPE_MODEL)' "$HERE" 2>/dev/null)" || {
    echo "workshop_provider.py is missing next to workshop-login. Tell the facilitator." >&2; exit 1; }
  read -r default_model small_model europe_model <<<"$default_model"
  # --europe stays with the provider: the file only says it for the provider it names.
  saved_europe="$(python3 -I -c '
import json, sys
saved = json.load(open(sys.argv[1], encoding="utf-8"))
print("on" if saved.get("provider") == sys.argv[2] and saved.get("europe") is True else "off")' "$OPENCODE_FILE" "$provider" 2>/dev/null || echo off)"
  europe="${europe_option:-$saved_europe}"
  if [[ "$europe" == on ]]; then default_model="$europe_model"; fi
  oc_model="openrouter/$default_model"
  if [[ "${OPENWEBUI_MODE:-}" == class ]]; then
    REFUSED='Create a new key on openrouter.ai, then type workshop-login again.'
    OTHER='Check that your OpenRouter account has credits and that the key is active.'
  fi
fi
# Enter alone keeps the model chosen earlier. A new key does not, and neither does turning --europe on:
# that model was chosen without it. Claude Code has no choice of model.
saved_model="$(python3 -I -c '
import json, sys
saved = json.load(open(sys.argv[1], encoding="utf-8"))
print(saved["model"] if saved.get("provider") == sys.argv[2] else "")' "$OPENCODE_FILE" "$provider" 2>/dev/null || true)"
if [[ "$keep_model" == 1 && "$kept_engine" == opencode && "$saved_model" == "$provider/"* && "$saved_model" =~ ^[A-Za-z0-9._:~/@-]+$
      && ! ( "$europe" == on && "$saved_europe" == off ) ]]; then
  oc_model="$saved_model"
fi
if [[ -n "$model" ]]; then
  oc_model="$model"
  [[ "$oc_model" == "$provider/"* ]] || oc_model="$provider/$oc_model"
fi
if [[ "$engine" == opencode && "$provider" == openrouter ]]; then
  if list="$(live_list)"; then
    # A model of the company openrouter itself: --model openrouter/free is openrouter/openrouter/free.
    if [[ -n "$model" ]] && grep -qxF -- "openrouter/$model" <<<"$list"; then oc_model="openrouter/$model"; fi
    if ! grep -qxF -- "$oc_model" <<<"$list"; then
      echo "OpenRouter has no model $oc_model that can use tools." >&2
      show_close_names
      exit 1
    fi
  else
    list="$(catalogue openrouter)" || list=""
    if grep -qxF -- "$oc_model" <<<"$list"; then
      echo "(OpenRouter's list of models could not be read: OpenCode knows the model $oc_model, but it is not checked.)" >&2
    else
      echo "(OpenRouter's list of models could not be read: the model $oc_model is not checked.)" >&2
    fi
  fi
  model_id="${oc_model#"$provider/"}"                          # the name the provider's API knows
elif [[ "$engine" == opencode ]]; then
  if list="$(catalogue "$provider")" && [[ -n "$list" ]]; then
    if ! grep -qxF -- "$oc_model" <<<"$list"; then
      echo "OpenCode does not know the model $oc_model." >&2
      show_close_names
      exit 1
    fi
  else
    echo "(OpenCode could not list its models: the model $oc_model is not checked.)" >&2
  fi
  model_id="${oc_model#"$provider/"}"                          # the name the provider's API knows
else
  model_id="$ANTHROPIC_MODEL_ID"
fi

echo "Key received: ${key:0:7}…${key: -4} (${#key} characters). Testing it…"

# The key goes to curl through its input (-H @-), never on a command line that `ps` would show.
if [[ "$provider" == anthropic ]]; then
  code="$(printf 'x-api-key: %s\n' "$key" | curl -sS --max-time 30 -o /dev/null -w '%{http_code}' \
    https://api.anthropic.com/v1/messages -H @- \
    -H "anthropic-version: 2023-06-01" -H "content-type: application/json" \
    -d "{\"model\":\"$model_id\",\"max_tokens\":1,\"messages\":[{\"role\":\"user\",\"content\":\".\"}]}")" || true
else
  info="$(key_info)"; code="${info##*$'\n'}"
  if [[ "$code" == 200 ]] && ! key_answer_ok <<<"${info%$'\n'*}"; then code=000; fi
fi
[[ "$code" =~ ^[0-9]{3}$ ]] || code=000

# A refused key never replaces a saved one: nothing is written. (With no saved key it is kept, and the
# message says so: the person can type workshop-login again.)
if [[ "$code" =~ ^(401|403)$ && -n "$saved_key" && "$saved_key" != "$key" ]]; then
  echo "$provider_name refuses this key (HTTP $code). Your earlier key is kept. $REFUSED" >&2
  exit 2
fi
# A working key of the other provider is replaced only by a key that was seen to work.
if [[ "$code" != 200 && ( ( "$saved_key" == sk-ant-* && "$provider" != anthropic ) ||
                          ( "$saved_key" == sk-or-* && "$provider" != openrouter ) ) ]]; then
  if [[ "$code" == 000 ]]; then
    echo "$provider_name could not be reached (network?). Your earlier key is kept. Type workshop-login again." >&2
    exit 3
  fi
  echo "The test answered HTTP $code (model $model_id). Your earlier key is kept. $OTHER" >&2
  exit 4
fi

umask 077
mkdir -p "$HOME/.claude"
printf '%s\n' "$key" | write_file "$KEY_FILE"
printf '%s\n' "$kept_engine" | write_file "$ENGINE_FILE"

# Common settings: same version all session long, a refused key fails in seconds instead of
# ~2 min 30 of retries, a 200k window (not 1M: the gauge must move in mode B), and no fast mode
# (it would change the model and the cost during the session).
common='"DISABLE_AUTOUPDATER": "1", "CLAUDE_CODE_MAX_RETRIES": "3", "CLAUDE_CODE_DISABLE_1M_CONTEXT": "1", "CLAUDE_CODE_DISABLE_FAST_MODE": "1"'

if [[ "$provider" == anthropic ]]; then
  # Claude Code, written with both engines: WORKSHOP_ENGINE=claude works without a new login.
  write_file "$HOME/.claude/settings.json" <<EOF
{
  "apiKeyHelper": "cat $HOME/.workshop-key",
  "env": { "ANTHROPIC_MODEL": "$ANTHROPIC_MODEL_ID", $common }
}
EOF
  facts=""
else
  # An OpenRouter key never reaches Claude Code: no apiKeyHelper (an old one would send this key to Anthropic).
  write_file "$HOME/.claude/settings.json" <<EOF
{
  "env": { $common }
}
EOF
  window=""
  if [[ "$europe" == on ]]; then window="$(europe_window)"; fi
  facts="$(model_facts "$window")"
fi
europe_saved=""
if [[ "$europe" == on ]]; then europe_saved=', "europe": true'; fi
# OpenCode: provider and model, always the provider of the saved key.
write_file "$OPENCODE_FILE" <<EOF
{"provider": "$provider", "model": "$oc_model"$facts$europe_saved, "engine_explicit": $explicit}
EOF

if [[ "${OPENWEBUI_MODE:-}" == class ]]; then
  where="$provider_name, model $model_id"  # the Open WebUI guide quotes this line
elif [[ "$kept_engine" == opencode ]]; then                    # what the next command uses
  where="OpenCode, $provider_name, model $oc_model"
else
  where="Claude Code, $provider_name, model $ANTHROPIC_MODEL_ID"
fi
if [[ "$europe" == on ]]; then where+=", hosted in Europe"; fi

# OpenCode reads the rule when it starts: what is open now goes on without it.
if [[ "$europe" != "$saved_europe" ]] && pgrep -u "$(id -u)" -x opencode > /dev/null 2>&1; then
  echo "OpenCode is already open and keeps the old data rule: close it and start it again. A replay stops by itself before its next question."
fi

# Open WebUI was started with the key of that moment, and does not read this file again.
running="$(timeout 5 docker ps --format '{{.Names}}' 2>/dev/null || true)"
if [[ "$key" != "$saved_key" ]] && grep -qxE 'yal-kit-openwebui|yal-openwebui-class' <<<"$running"; then
  echo "Open WebUI keeps the old key until you type: openwebui start"
elif [[ "$europe" != "$saved_europe" ]] && grep -qxE 'yal-kit-openwebui|yal-openwebui-class' <<<"$running"; then
  echo "Open WebUI keeps the old data rule until you type: openwebui start"
fi
if [[ "$provider" == openrouter && "${OPENWEBUI_MODE:-}" == class && "$europe" != on ]]; then
  echo "Warning: with young people, turn on zero-data-retention models hosted in Europe: workshop-login --europe"
fi

# OpenRouter: the key works, now the model. Each failure has its own sentence.
free_left=""
if [[ "$provider" == openrouter && "$code" == 200 ]]; then
  # What to choose instead. With --europe, the list of models would mostly offer models Mistral does not serve, and
  # a free model has no company in Europe: name a model of this route, never the one that just failed.
  choose='workshop-login --models openrouter'; add_credits='Add credits, or choose a free model: workshop-login --models free'
  if [[ "$europe" == on ]]; then
    choose="workshop-login --model $europe_model"; add_credits='Add credits.'
    if [[ "$oc_model" == "openrouter/$europe_model" ]]; then choose="workshop-login --model $small_model"; fi
  fi
  read -r kind status words <<<"$(model_test)"
  case "$kind" in
    ok) ;;
    credits) echo "Key saved, but this OpenRouter account has no credits left. $add_credits" >&2; exit 4 ;;
    limit) echo "Key saved, but this key has reached its spending limit. $OTHER" >&2; exit 4 ;;
    model)
      if [[ "$europe" == on ]]; then
        echo "Key saved, but Mistral does not serve the model $oc_model in Europe with zero data retention. Choose another model, for example: $choose" >&2
      else
        echo "Key saved, but no company can serve the model $oc_model under the workshop's data rule. Choose another model: workshop-login --models openrouter" >&2
      fi
      exit 4 ;;
    busy)
      if [[ "$status" == 429 ]]; then
        echo "Key saved, but the quota of the model $oc_model is reached for now (HTTP 429). Try again later, or choose another model: $choose" >&2
      else
        echo "Key saved, but the model $oc_model is busy (HTTP $status). Try again in a few minutes, or choose another model: $choose" >&2
      fi
      exit 4 ;;
    network) echo "Key saved, but the model $oc_model could not be reached (network?). Try: $NEXT" >&2; exit 3 ;;
    *) echo "Key saved, but the test answered HTTP $status (model $model_id): ${words:-no details}. $OTHER" >&2; exit 4 ;;
  esac
  if [[ "$oc_model" == *:free ]]; then
    info="$(key_info)"
    free_left="$(printf '%s' "${info%$'\n'*}" | python3 -I -c '
import json, sys
left = (json.load(sys.stdin)["data"].get("free_model_daily_requests") or {}).get("remaining")
if isinstance(left, int):
    print("Free requests left today: %d." % left)' 2>/dev/null || true)"
  fi
fi

case "$code" in
  200)
    echo "Key OK ($where). You can start: $NEXT"
    if [[ -n "$free_left" ]]; then echo "$free_left"; fi
    if [[ "$europe" == on && -z "${window:-}" ]]; then
      echo "(OpenRouter's list of the companies of this model could not be read: the size of its window in Europe is not checked.)"
    fi
    if [[ "$engine" != "$kept_engine" && "${OPENWEBUI_MODE:-}" != class ]]; then
      echo "WORKSHOP_ENGINE=$engine is not saved. Without it, workshop uses $(engine_name "$kept_engine"). To keep $(engine_name "$engine"): workshop-login --engine $engine"
    fi ;;
  401|403) echo "Key saved, but $provider_name refuses it (HTTP $code). $REFUSED" >&2; exit 2 ;;
  000) echo "Key saved, but $provider_name could not be reached (network?). Try: $NEXT" >&2; exit 3 ;;
  *) echo "Key saved, but the test answered HTTP $code (model $model_id). $OTHER" >&2; exit 4 ;;
esac
