#!/usr/bin/env python3
"""Saves your work in one .zip file, to take it to the next workshop.

    workshop-save                      writes my-work.zip
    workshop-save --name "Team Fox"    writes team-fox.zip

Each workshop starts in a new Codespace. Before you close this one, save your work, download
the file (right-click on it in the file list, then "Download..."), and next time type:
    workshop-start <number of the workshop> --from my-work.zip

What goes in the file: only what you made or changed. Your AGENTS.md, your other instructions
(.md files of yours next to AGENTS.md or in examples/, e.g. a draft for replay --agents), your
test questions, your scores, your answers (answers/), your own skills, your summaries and their
checks, the documents you added (corpus/ 80 to 89), today's fire danger data, your wiki pages;
in workshop 6, your examples and your test (messages/), not the fine-tuned model. A file
MANIFEST.md inside lists them. The workshop's own files stay out (SETUP.md, sheet.md,
tools/sorter.py): if you changed one, the command tells you.

If a save with the same name is already here and holds something else, it is kept under another
name (with its date): saving never deletes an earlier save.
"""

import argparse
import datetime
import hashlib
import io
import json
import os
import pathlib
import re
import subprocess
import sys
import tarfile
import unicodedata
import zipfile
import zlib

KIT = pathlib.Path(os.environ.get("WORKSHOP_HOME", pathlib.Path.home() / "workshop"))
PACK = ".workshop/wiki-pack.tar.gz"
# Skills of the kit itself. Used only when git cannot tell what is new (a copy of the kit without git).
KIT_SKILLS = {"source-note", "summarize", "validate-summary"}
# Personalities of the kit (examples/). Used only without git: there, a file of examples/ with
# another name is the pair's; a kit example that the pair edited cannot be told apart, and is
# not saved.
KIT_EXAMPLES = {"AGENTS.feurisson.md", "AGENTS.liar.md", "AGENTS.overcautious.md",
                "AGENTS.sophist.md", "AGENTS.storyteller.md"}
# .md files at the top of the kit that are not other instructions (scores*.md are scores).
NOT_DRAFTS = {"README.md", "SETUP.md", "sheet.md", "CLAUDE.md", "AGENTS.md", "MANIFEST.md", "test-questions.md"}
DRAFT = re.compile(r"(examples/)?[^./\\][^/\\]*\.md")    # "My bot.md", "examples/AGENTS.mine.md"
# Single files of the kit that the pair may change.
SINGLE_FILES = ("test-questions.md", "mcp/fire-danger.json")
# Files of the workshop that a pair may change but a save must not carry: a restore would put them
# over the next workshop's own version. workshop-save only says so.
NOT_KEPT = ("SETUP.md", "sheet.md", "tools/sorter.py")
# Folders where the pair's work lands. corpus/index.md and summaries/index.md are kept line by
# line (index-lines/ in the zip), so that a restore adds lines instead of replacing the index.
FOLDERS = ("answers", ".claude/skills", "summaries", "corpus", "wiki", "messages")
INDEXES = ("corpus/index.md", "summaries/index.md")
SKIP_PARTS = {"__pycache__", "graphify-out", ".DS_Store"}   # rebuilt, or not yours
ADDED = re.compile(r"^8[0-9]-")                             # numbers given by corpus-add
# What a damaged .zip can raise (ValueError: a name that is not UTF-8; RuntimeError: a password).
BAD_ZIP = (OSError, zipfile.BadZipFile, KeyError, RuntimeError, EOFError, ValueError, zlib.error)
LINK = re.compile(r"\]\(([^)\s]+)\)")
LIST_ITEM = re.compile(r"\s*[*+-] \[")                     # "* [Title](…)", "- [Title](…)"
DRAFTS_LABEL = "Your other instructions (.md files, examples/)"
told = set()                                               # the file names bad_name() already reported

CATEGORIES = (                                   # (prefix of the path in the zip, label)
    ("AGENTS.md", "Your chatbot's instructions (AGENTS.md)"),
    ("examples/", DRAFTS_LABEL),
    ("test-questions.md", "Your test questions (test-questions.md)"),
    ("scores", "Your scores"),
    ("answers/", "Your answers (answers/)"),
    (".claude/skills/", "Skills (.claude/skills/)"),
    ("summaries/", "Summaries and their checks (summaries/)"),
    ("corpus/", "Documents you added (corpus/)"),
    ("index-lines/", "Your lines of corpus/index.md and summaries/index.md"),
    ("mcp/", "Today's fire danger data (mcp/fire-danger.json)"),
    ("wiki/", "Your wiki pages (wiki/)"),
    ("messages/", "Your examples and your test (messages/)"),
)


class Item:
    """One file of the save: its path in the zip (= its path in the kit), its content, and
    whether we are sure it is the pair's work (False: no way to compare with the original)."""
    def __init__(self, arcname, data, certain=True):
        self.arcname, self.data, self.certain = arcname, data, certain


def is_draft(rel):
    """Other instructions the pair may write: a .md file at the top of the kit (not a file of
    the kit) or in examples/. Same rule in workshop-start, for what it may restore."""
    return (bool(DRAFT.fullmatch(rel)) and rel not in NOT_DRAFTS
            and not rel.startswith("scores"))


def category(arcname):
    for prefix, label in CATEGORIES:
        if arcname.startswith(prefix):
            return label
    if is_draft(arcname):
        return DRAFTS_LABEL
    return "Other files"


def slug(text):
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:60].strip("-")


def has_content(text):
    """True if AGENTS.md has text of its own: not only titles and hint comments."""
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)
    return any(l.strip() and not l.lstrip().startswith("#") for l in text.splitlines())


def link_target(line):
    """'* [Title](text/80-x.md) - … Original: [80-x.pdf](80-x.pdf)' -> 'text/80-x.md'."""
    match = LINK.search(line)
    return match.group(1) if match else None


class Original:
    """The kit as it was given: git (the commit the pair started from) for the files of the kit,
    the wiki pack for wiki/ and its skills. Without git, `known()` is False for kit files."""

    def __init__(self, kit):
        self.kit = kit
        self.pack = {}
        try:
            with tarfile.open(kit / PACK) as tar:
                for member in tar.getmembers():
                    if member.isfile():
                        self.pack[member.name.removeprefix("./")] = tar.extractfile(member).read()
        except (OSError, tarfile.TarError, EOFError, zlib.error):
            pass
        self.tree, self.algo = {}, hashlib.sha1
        try:
            # The commit the pair was given, not HEAD: what they committed themselves (Source
            # Control tab) is their work. Without a remote: HEAD.
            base = subprocess.run(["git", "-C", str(kit), "merge-base", "HEAD", "origin/HEAD"],
                                  capture_output=True, text=True, timeout=30)
            commit = base.stdout.strip() if base.returncode == 0 and base.stdout.strip() else "HEAD"
            run = subprocess.run(["git", "-C", str(kit), "ls-tree", "-r", "-z", commit, "."],
                                 capture_output=True, timeout=30)
            if run.returncode == 0:
                for entry in run.stdout.split(b"\0"):
                    if b"\t" in entry:
                        meta, path = entry.split(b"\t", 1)
                        self.tree[path.decode("utf-8", "replace")] = meta.split()[2].decode()
        except (OSError, subprocess.SubprocessError):
            pass
        # The kit (or the repository of workshop 6) is the root of a git repository.
        self.git = "AGENTS.md" in self.tree or "sorter" in self.tree
        if self.git and len(next(iter(self.tree.values()))) == 64:
            self.algo = hashlib.sha256          # repository in SHA-256 format

    def in_pack(self, rel):
        return rel.startswith("wiki/") or any(rel.startswith(p.rsplit("/", 1)[0] + "/")
                                              for p in self.pack if p.startswith(".claude/"))

    def known(self, rel):
        """Can we tell whether rel is new or changed?"""
        return self.git or (self.pack and self.in_pack(rel))

    def same(self, rel, data):
        """True if rel exists in the original kit with exactly this content."""
        if self.pack and self.in_pack(rel):
            return self.pack.get(rel) == data
        blob = self.tree.get(rel)
        if blob is None:
            return False
        return self.algo(b"blob %d\0" % len(data) + data).hexdigest() == blob

    def lines(self, rel):
        """Lines of the original version of rel, or None if unknown."""
        if not self.git or rel not in self.tree:
            return None
        run = subprocess.run(["git", "-C", str(self.kit), "cat-file", "-p", self.tree[rel]],
                             capture_output=True, timeout=30)
        return run.stdout.decode("utf-8", "replace").splitlines() if run.returncode == 0 else None


def unknown_but_yours(rel):
    """Without git: files that cannot come from the kit, whatever their content."""
    parts = rel.split("/")
    if parts[0] in ("answers", "wiki") or rel.startswith("summaries/checks/"):
        return True
    if parts[0] in ("summaries", "corpus") and ADDED.match(parts[-1]):
        return True
    return rel.startswith(".claude/skills/") and len(parts) > 3 and parts[2] not in KIT_SKILLS


def bad_name(rel):
    """True if this file name is not UTF-8: it cannot go into a zip. One line for the pair, once."""
    try:
        rel.encode("utf-8")
        return False
    except UnicodeEncodeError:
        if rel not in told:
            told.add(rel)
            print(f"! Not saved: {rel.encode('utf-8', 'replace').decode()}. Its name has odd characters: rename it.")
        return True


def collect(kit=KIT, original=None):
    """Everything the pair made or changed, as a list of Item."""
    original = original or Original(kit)
    items = []

    agents = kit / "AGENTS.md"
    if agents.is_file() and not agents.is_symlink() and has_content(agents.read_text(encoding="utf-8", errors="replace")):
        items.append(Item("AGENTS.md", agents.read_bytes()))

    singles = list(SINGLE_FILES) + sorted(p.name for p in kit.glob("scores*.md"))
    for rel in singles:
        path = kit / rel
        if not path.is_file() or path.is_symlink() or bad_name(rel):
            continue
        data = path.read_bytes()
        if not original.known(rel):
            items.append(Item(rel, data, certain=False))   # no git: kept anyway, to be safe
        elif not original.same(rel, data):
            items.append(Item(rel, data))

    # Other instructions: drafts for "replay --agents", a new or edited personality of examples/.
    drafts = sorted(kit.glob("*.md")) + sorted((kit / "examples").glob("*.md"))
    for path in drafts:
        rel = path.relative_to(kit).as_posix()
        if not path.is_file() or path.is_symlink() or not is_draft(rel) or bad_name(rel):
            continue
        data = path.read_bytes()
        if original.known(rel):
            if not original.same(rel, data):
                items.append(Item(rel, data))
        elif "/" not in rel or path.name not in KIT_EXAMPLES:
            items.append(Item(rel, data))

    for folder in FOLDERS:
        base = kit / folder
        if not base.is_dir():
            continue
        for path in sorted(base.rglob("*")):
            rel = path.relative_to(kit).as_posix()
            if (not path.is_file() or path.is_symlink() or rel in INDEXES
                    or SKIP_PARTS.intersection(rel.split("/")) or path.name.startswith((".corpus-add-", ".workshop-start-"))
                    or bad_name(rel)):
                continue
            data = path.read_bytes()
            if original.known(rel):
                if not original.same(rel, data):
                    items.append(Item(rel, data))
            elif unknown_but_yours(rel):
                items.append(Item(rel, data))
            elif folder == "messages":
                items.append(Item(rel, data, certain=False))   # no git: kept anyway, to be safe

    for rel in INDEXES:
        path = kit / rel
        if not path.is_file():
            continue
        before = original.lines(rel)
        mine = []
        for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
            target = link_target(line)
            if not LIST_ITEM.match(line) or not target:
                continue
            if (before is not None and line not in before) or \
               (before is None and ADDED.match(target.rsplit("/", 1)[-1])):
                mine.append(line)
        if mine:
            items.append(Item(f"index-lines/{rel}", ("\n".join(mine) + "\n").encode("utf-8")))
    return items


def left_out(original):
    """Files of NOT_KEPT that the pair changed. Without git, nothing can be told."""
    changed = []
    for rel in NOT_KEPT if original.git else ():
        path = original.kit / rel
        if path.is_file() and not path.is_symlink() and not original.same(rel, path.read_bytes()):
            changed.append(rel)
    return changed


def fingerprint(entries):
    """Same files with the same content <=> same fingerprint. entries: {arcname: bytes}."""
    digest = hashlib.sha256()
    for name in sorted(entries):
        digest.update(name.encode() + b"\0" + hashlib.sha256(entries[name]).digest())
    return digest.hexdigest()


def items_fingerprint(items):
    return fingerprint({i.arcname: i.data for i in items})


def zip_fingerprint(path):
    """Fingerprint of a save (without its MANIFEST.md), or None if it is not a save."""
    try:
        with zipfile.ZipFile(path) as archive:
            names = [n for n in archive.namelist() if not n.endswith("/")]
            if "MANIFEST.md" not in names:
                return None
            return fingerprint({n: archive.read(n) for n in names if n != "MANIFEST.md"})
    except BAD_ZIP:
        return None


def workshop_number():
    """The workshop of this work: the repository's README ("# Workshop N - …"), else the last
    workshop-start (.workshop/last-start.json, in the whole kit); None if neither tells.
    Reads KIT when called (workshop-start sets it after loading this file)."""
    kit = KIT
    try:
        found = re.match(r"# Workshop (\d+) ", (kit / "README.md").read_text(encoding="utf-8", errors="replace"))
        if found:
            return int(found.group(1))
    except OSError:
        pass
    try:
        n = json.loads((kit / ".workshop" / "last-start.json").read_text(encoding="utf-8")).get("workshop")
    except (OSError, ValueError, AttributeError):
        return None
    return n if isinstance(n, int) else None


def manifest(items, name):
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    n = workshop_number()
    lines = [f"# Workshop save: {name}", "",
             f"Saved on: {now}"] + ([f"Workshop: {n}"] if n else []) + [f"Files: {len(items)}", "",
             "This file was written by `workshop-save` (Youth AI Lab workshop). It holds only what",
             "you made or changed in the kit.", "", "## What is inside", ""]
    groups = {}
    for item in items:
        groups.setdefault(category(item.arcname), []).append(item.arcname)
    for label, names in groups.items():
        lines.append(f"### {label}")
        lines.append("")
        lines += [f"- `{n}`" for n in names]
        lines.append("")
    if any(not i.certain for i in items):
        lines += ["> ℹ️ **Note.** Some files were kept without being compared with the original kit",
                  "> (no git in this workspace): " + ", ".join(f"`{i.arcname}`" for i in items if not i.certain) + ".",
                  ""]
    if n == 6:                                   # the last workshop: this save only goes back there
        open_it, type_it = "1. Open a new Codespace of workshop 6.", ["3. In the terminal, type this:", ""]
        number, after = 6, ["`workshop-start` puts every file back in its place.", ""]
    else:
        open_it, number = "1. Open a new Codespace for the next workshop.", "<n>"
        type_it = ["3. In the terminal, type this, with the number of the workshop instead of `<n>`",
                   "   (for example `workshop-start 2 --from …` for workshop 2):", ""]
        after = ["`workshop-start` puts every file back in its place. The lines of `index-lines/` are",
                 "added to `corpus/index.md` and `summaries/index.md`.", ""]
    lines += ["## How to restore", "", open_it,
              "2. Drag this .zip file into the file list (left panel), next to `README.md`.",
              *type_it,
              "   ```bash",
              f"   workshop-start {number} --from {name}.zip",
              "   ```", "", *after]
    return "\n".join(lines)


def write_tmp(items, out, name):
    """Writes the whole save next to out and returns its path. If that fails, removes it."""
    tmp = out.with_name(f".{out.name}.tmp")
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as archive:
            archive.writestr("MANIFEST.md", manifest(items, name))
            for item in items:
                # With its permissions: a script of a skill must still run after a restore.
                info = zipfile.ZipInfo(item.arcname, datetime.datetime.now().timetuple()[:6])
                info.compress_type = zipfile.ZIP_DEFLATED
                path = KIT / item.arcname
                info.external_attr = ((path.stat().st_mode & 0o777) if path.is_file() else 0o644) << 16
                archive.writestr(info, item.data)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise
    return tmp


def write_zip(items, out, name):
    os.replace(write_tmp(items, out, name), out)


def keep_previous(out, items):
    """If out is an earlier save that holds something else, renames it (with its date) instead
    of writing over it. Returns (new name, names of its files missing from items) or None."""
    if not out.exists() or zip_fingerprint(out) == items_fingerprint(items):
        return None
    with zipfile.ZipFile(out) as archive:
        names = [n for n in archive.namelist() if not n.endswith("/") and n != "MANIFEST.md"]
        try:
            with archive.open("MANIFEST.md") as manifest_file:     # the top is enough, whatever its size
                top = manifest_file.read(2**20).decode("utf-8", "replace")
        except BAD_ZIP:                           # damaged: it is still kept, with the date of the file
            top = ""
    saved_on = re.search(r"^Saved on: (.+)$", top, re.M)
    stamp = slug(saved_on.group(1)) if saved_on else ""
    if not stamp:
        stamp = datetime.datetime.fromtimestamp(out.stat().st_mtime).strftime("%Y-%m-%d-%H%M")
    kept, k = out.with_name(f"{out.stem}-{stamp}.zip"), 2
    while kept.exists():
        kept, k = out.with_name(f"{out.stem}-{stamp}-{k}.zip"), k + 1
    os.replace(out, kept)
    now = {i.arcname for i in items}
    return kept.name, [n for n in names if n not in now]


def summary_lines(names):
    """Short list for the terminal: one line per category, with a few names."""
    groups = {}
    for n in names:
        groups.setdefault(category(n), []).append(n)
    out = []
    for label, group in groups.items():
        shown = ", ".join(group[:3]) + (f" and {len(group) - 3} more" if len(group) > 3 else "")
        out.append(f"  {label}: {len(group)} file{'s' if len(group) > 1 else ''} ({shown})")
    return out


def main():
    parser = argparse.ArgumentParser(prog="workshop-save", description=__doc__.split("\n\n")[0],
                                     epilog=__doc__.split("\n\n", 1)[1],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--name", default="my-work", help="a name for the file, e.g. your team's name")
    args = parser.parse_args()
    if not ((KIT / "test-questions.md").is_file() or (KIT / "messages" / "examples.md").is_file()):
        sys.exit(f"No workshop kit in {KIT}: run this command in the workshop.")

    name = slug(args.name) or "my-work"
    out = KIT / f"{name}.zip"
    if out.exists() and zip_fingerprint(out) is None:
        sys.exit(f"{out.name} already exists and is not a save of your work (from chatbot-export?).\n"
                 f'Choose another name, for example: workshop-save --name "{name}-work"')

    original = Original(KIT)
    items = collect(KIT, original)
    changed = left_out(original)
    not_saved = (f"! Changed but not saved: {', '.join(changed)}. A save keeps your work, not the workshop's "
                 f'own files.\n  To keep a change, download that file too (right-click on it, then "Download...").')
    if not items:
        if changed:
            print(not_saved)
        else:
            print("Nothing to save yet: AGENTS.md is still empty and nothing else was made or changed."
                  if (KIT / "AGENTS.md").is_file() else "Nothing to save yet: nothing was made or changed.")
        return
    tmp = write_tmp(items, out, name)             # the old save moves only once the new one is whole
    try:
        previous = keep_previous(out, items)
        os.replace(tmp, out)
    finally:
        tmp.unlink(missing_ok=True)
    number = 6 if workshop_number() == 6 else "<number of the workshop>"
    print(f"Saved {len(items)} file{'s' if len(items) > 1 else ''} in {out.name}:")
    print("\n".join(summary_lines([i.arcname for i in items])))
    if changed:
        print(not_saved)
    if previous:
        kept, missing = previous
        print(f"Your earlier {out.name} is kept as {kept}, just in case. The newest is {out.name}.")
        if missing:
            shown = ", ".join(missing[:5]) + (f" and {len(missing) - 5} more" if len(missing) > 5 else "")
            many = len(missing) > 1
            print(f"! It has {len(missing)} file{'s' if many else ''} that {'are' if many else 'is'} not in "
                  f"the new save: {shown}.\n"
                  f"  If you forgot to bring it back with workshop-start, type:\n"
                  f"    workshop-start {number} --from {kept}\n"
                  f"  then workshop-save again.")
    print(f'To keep it: right-click on {out.name} in the file list, then "Download...".')
    print(f"To go on later, in a new Codespace of workshop 6: drag {out.name} into the file list, then type:"
          if number == 6 else f"Next workshop, in a new Codespace: drag {out.name} into the file list, then type:")
    print(f"  workshop-start {number} --from {out.name}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:                        # never a Python traceback for participants
        sys.exit(f"workshop-save stopped on an unexpected error ({type(e).__name__}: {e}). "
                 "This save may not be finished: do not download a .zip yet. "
                 "Your work and your earlier saves are still here. Ask the facilitator.")
