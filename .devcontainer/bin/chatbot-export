#!/usr/bin/env python3
"""Packs the chatbot you built today into one file, to rebuild it in another tool.

    chatbot-export                       writes my-chatbot.zip
    chatbot-export --name "Feurisson"    writes feurisson.zip, with this name inside

The file holds what goes into the two boxes of every chatbot tool:
  - Instructions: your AGENTS.md (workshop 1), without the comments;
  - Knowledge: your summaries (workshops 2 and 3), your wiki pages (workshop 5) and the readable
    copies of the official documents (corpus/text/).
It also holds your own skills (workshop 3, .claude/skills/), but not the kit's skills, which write
files in this Codespace.
To download it: right-click on the file in the file list, then "Download...".
"""

import argparse
import datetime
import os
import pathlib
import re
import sys
import unicodedata
import zipfile

KIT = pathlib.Path(os.environ.get("WORKSHOP_HOME", pathlib.Path.home() / "workshop"))

HOW_TO = """# {name} - your chatbot, ready to rebuild

Exported from the Youth AI Lab workshop on {date}.

## What is inside

- `instructions.md`: the system prompt you wrote in AGENTS.md (workshop 1). This is the
  **Instructions** box.
- `knowledge/`: {count} files. This is the **Knowledge** box.
  - `summaries__…`: the short summaries, checked or not (their header says who verified them);
  - `wiki__…`: the pages of your wiki, each fact with its footnote (workshop 5);
  - `corpus-text__…`: the readable copies of the official documents.
- {skills}

## Rebuild it

- **Claude Project** (claude.ai): create a project, paste `instructions.md` into the project
  instructions, and add the files in `knowledge/` to the project knowledge.
- **Gemini Gem** (gemini.google.com): create a Gem, paste `instructions.md` into its
  instructions, and upload the files in `knowledge/` as its knowledge. On personal accounts, Google
  makes Gems read-only on 2026-11-17 and removes them on 2026-12-17.
- **Open WebUI** (your own server): `openwebui import` takes this file as it is, skills included,
  see https://github.com/Youth-AI-Lab/yal-openwebui-guide#step-2---import-a-chatbot. By hand: create a
  knowledge base with the files in `knowledge/`, then a model with `instructions.md` as its system
  prompt and this knowledge attached. Add each `SKILL.md` in Workspace -> Skills, then attach them
  to the model.

A Claude Project and a Gemini Gem have two boxes only, Instructions and Knowledge: no box for a
skill. To keep one, paste its steps at the end of the instructions, with the sentence that says
when to use them.

## Before young people use it

claude.ai is for adults only (18+): young people cannot have their own account. Read the rules of
the tool you choose, and https://github.com/Youth-AI-Lab/yal-openwebui-guide#the-participants-data
before anyone types in a chatbot of yours.

## Before you trust it

Ask it your test questions again (`test-questions.md`), and compare with your scores from the
workshop (`scores.md`). The tool changes; the test does not.
"""


def slug(text):
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")[:60].strip("-") or "my-chatbot"


def instructions(kit):
    text = (kit / "AGENTS.md").read_text(encoding="utf-8", errors="replace")
    text = re.sub(r"<!--.*?-->", "", text, flags=re.S)          # hints for you, not for the model
    text = re.sub(r"\n{3,}", "\n\n", text).strip() + "\n"
    filled = [l for l in text.splitlines() if l.strip() and not l.startswith("#")]
    return text, bool(filled)


NOT_KNOWLEDGE = {"index.md", "README.md", "log.md", "CLAUDE.md", "AGENTS.md", "graph.md"}


def knowledge(kit):
    files = []
    for folder, prefix in (("summaries", "summaries"), ("wiki", "wiki"), ("corpus/text", "corpus-text")):
        for path in sorted((kit / folder).glob("*.md")):
            # Catalogues and instructions are not knowledge: the same files left out as in workshop B and
            # openwebui (indexes, READMEs, templates), plus the wiki's own files (schema, log, map).
            if path.name in NOT_KNOWLEDGE or path.name.startswith("00-") or path.is_symlink():
                continue
            try:
                path.name.encode("utf-8")
            except UnicodeEncodeError:
                print(f"! Left out: {path.name.encode('utf-8', 'replace').decode()}. "
                      "Its name has odd characters: rename it.")
                continue
            files.append((f"knowledge/{prefix}__{path.name}", path))
    return files


# The kit's own skills (curation, workshop 3; wiki, workshop 5): they write files in the Codespace, which a
# chatbot tool cannot do. Left out by their folder or by the name in their header.
KIT_SKILLS = ("summarize", "validate-summary", "source-note", "ingest", "lint")


def skill_name(text):
    head = re.match(r"\A---[ \t]*\r?\n(.*?)\r?\n---", text, re.S)
    line = re.search(r"^name:[ \t]*(.+?)[ \t]*$", head.group(1), re.M) if head else None
    value = line.group(1) if line else ""
    # YAML: a comment starts with " #", outside quotes.
    return value.strip("'\"").strip() if value[:1] in "'\"" else re.sub(r"\s+#.*$", "", value).strip()


def skills(kit):
    """The pair's own skills: [(arcname, path)] of .claude/skills/<folder>/SKILL.md; and the kit's ones left out."""
    found, left_out = [], []
    folder = kit / ".claude" / "skills"
    for path in sorted(folder.glob("*/SKILL.md")) if folder.is_dir() else []:
        name = path.parent.name
        if path.is_symlink() or path.parent.is_symlink() or not path.is_file():
            continue
        header = skill_name(path.read_text(encoding="utf-8", errors="replace"))
        if name in KIT_SKILLS:
            left_out.append(name)
            continue
        if header in KIT_SKILLS:
            print(f"! Left out: the skill folder {name}. Its header says name: {header}, the name of a kit skill. "
                  "Give it a name of its own.")
            continue
        if not re.fullmatch(r"[A-Za-z0-9_-][A-Za-z0-9._-]*", name):
            print(f"! Left out: the skill folder {name.encode('utf-8', 'replace').decode()}. "
                  "Use only letters, digits and dashes in its name.")
            continue
        others = [p.name for p in path.parent.iterdir() if p.name != "SKILL.md"]
        if others:
            print(f"Note: only the SKILL.md of {name} is in the file, not {', '.join(sorted(others))}.")
        found.append((f"skills/{name}/SKILL.md", path))
    return found, left_out


def is_save(path):
    """True if this zip is a save of workshop-save (it has a MANIFEST.md)."""
    try:
        with zipfile.ZipFile(path) as archive:
            return "MANIFEST.md" in archive.namelist()
    except (OSError, zipfile.BadZipFile):
        return False


def main():
    parser = argparse.ArgumentParser(prog="chatbot-export", description=__doc__.split("\n\n")[0],
                                     epilog=__doc__.split("\n\n", 1)[1],
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--name", default="my-chatbot", help="the name of your chatbot")
    args = parser.parse_args()
    if not (KIT / "AGENTS.md").is_file():
        sys.exit(f"No AGENTS.md in {KIT}: run this command in the workshop.")
    if (KIT / "AGENTS.md").is_symlink():  # a link can point anywhere, even to the key
        sys.exit("AGENTS.md is a link, not a file. Make it a normal file, then type chatbot-export again.")

    text, filled = instructions(KIT)
    files = knowledge(KIT)
    own_skills, kit_skills = skills(KIT)
    name = args.name.strip() or "my-chatbot"
    out = KIT / f"{slug(name)}.zip"
    if is_save(out):
        sys.exit(f"{out.name} already exists and is a save of your work (from workshop-save).\n"
                 f'Choose another name, for example: chatbot-export --name "{name} chatbot"')
    # Through a temporary file, like workshop-save: an error never leaves half an export.
    tmp = out.with_name(f".{out.name}.tmp")
    try:
        with zipfile.ZipFile(tmp, "w", zipfile.ZIP_DEFLATED) as archive:
            listed = ", ".join(f"`{a.split('/')[1]}`" for a, _ in own_skills)
            archive.writestr("README.md", HOW_TO.format(
                name=name, date=datetime.date.today().isoformat(), count=len(files),
                skills=f"`skills/`: your own skills ({listed}). Each folder holds one `SKILL.md`: when to use it, "
                       "and its steps." if own_skills else
                       "No `skills/` folder: you have not written a skill of your own yet (workshop 3)."))
            archive.writestr("instructions.md", text)
            archive.writestr("chatbot-name.txt", name + "\n")
            for arcname, path in files + own_skills:
                archive.write(path, arcname)
        os.replace(tmp, out)
    finally:
        tmp.unlink(missing_ok=True)

    counts = {p: sum(1 for a, _ in files if a.startswith(f"knowledge/{p}__")) for p in ("summaries", "wiki", "corpus-text")}
    with_skills = (f" + {len(own_skills)} skill{'' if len(own_skills) == 1 else 's'} "
                   f"({', '.join(a.split('/')[1] for a, _ in own_skills)})") if own_skills else ""
    print(f"Wrote {out.name}: instructions + {len(files)} knowledge files "
          f"({counts['summaries']} summaries, {counts['wiki']} wiki pages, {counts['corpus-text']} documents)"
          f"{with_skills}.")
    if kit_skills:
        print(f"Not in the file: the kit's skills {', '.join(kit_skills)}. They write files in this Codespace, "
              "and a chatbot tool cannot.")
    if not filled:
        print("Warning: AGENTS.md has no text under its headings yet (workshop 1): the instructions are empty.")
    if not counts["wiki"]:
        print("Note: no wiki pages (they come with workshop 5: wiki-start).")
    print(f'To download it: right-click on {out.name} in the file list, then "Download...".')


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except Exception as e:                        # never a Python traceback for participants
        sys.exit(f"chatbot-export stopped on an unexpected error ({type(e).__name__}: {e}). "
                 "Ask the facilitator.")
