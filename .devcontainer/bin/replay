#!/usr/bin/env python3
"""Replays the questions of test-questions.md in one workshop mode.

    replay B          all questions, in mode B
    replay C 1 7      only questions 1 and 7, in mode C

Each question is asked in a fresh session (nothing carries over from one question to the next).
Answers are written to answers/<mode>-<time>.md, each with the size of the context (the gauge)
and what the model read or searched. All that is left is to score them from 0 to 2.
"""

import json
import os
import subprocess
import sys
from datetime import datetime
from pathlib import Path

KIT = Path(os.environ.get("WORKSHOP_HOME", Path.home() / "workshop"))
WORKSHOP = os.environ.get("WORKSHOP_CMD", "workshop")
MODES = {"bare": "bare", "a": "A", "b": "B", "c": "C", "w": "W"}


def read_questions():
    """Rows of the table in test-questions.md: | no. | category | question | ... |"""
    questions = []
    for line in (KIT / "test-questions.md").read_text(encoding="utf-8").splitlines():
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if len(cells) >= 3 and cells[0].isdigit() and cells[2]:
            questions.append((int(cells[0]), cells[2]))
    return questions


def ask(mode, question):
    """Asks one question, returns (answer, context tokens, actions, cost)."""
    cmd = [WORKSHOP, mode, "-p", question, "--output-format", "stream-json", "--verbose",
           "--max-turns", "15"]
    if os.environ.get("WORKSHOP_MODEL"):
        cmd += ["--model", os.environ["WORKSHOP_MODEL"]]
    try:
        output = subprocess.run(cmd, capture_output=True, text=True, timeout=300,
                                stdin=subprocess.DEVNULL).stdout
    except subprocess.TimeoutExpired:
        return "(no answer after 5 minutes)", 0, [], 0.0
    answer, context, actions, cost = "(no answer)", 0, [], 0.0
    for line in output.splitlines():
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if d.get("type") == "assistant":
            u = d["message"].get("usage") or {}
            # Size of the context at this step: what was sent to the model.
            context = max(context, u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0)
                          + u.get("cache_creation_input_tokens", 0))
            for c in d["message"]["content"]:
                if c.get("type") == "tool_use":
                    actions.append(describe(c["name"], c.get("input") or {}))
        elif d.get("type") == "result":
            answer = (d.get("result") or answer).strip()
            cost = d.get("total_cost_usd") or 0.0
    return answer, context, actions, cost


def describe(tool, args):
    if tool == "Read":
        return "read " + os.path.relpath(args.get("file_path", "?"), KIT)
    if tool == "Bash":
        return "ran `" + args.get("command", "?") + "`"
    if tool == "Skill":
        return "used the skill " + args.get("skill", "?")
    if tool.startswith("mcp__"):
        return "called the MCP tool " + tool.split("__")[-1]
    return "used " + tool


def main():
    if len(sys.argv) < 2 or sys.argv[1].lower() not in MODES:
        print(__doc__.strip())
        sys.exit(1)
    mode = MODES[sys.argv[1].lower()]
    numbers = {int(n) for n in sys.argv[2:] if n.isdigit()}
    questions = [(n, q) for n, q in read_questions() if not numbers or n in numbers]
    if not questions:
        print("No question found: fill in the Question column of test-questions.md.")
        sys.exit(1)

    (KIT / "answers").mkdir(exist_ok=True)
    out = KIT / "answers" / f"{mode}-{datetime.now():%Hh%M}.md"
    lines = [f"# Answers — mode {mode} — {datetime.now():%Y-%m-%d %H:%M}", "",
             f"Score each answer from 0 to 2 in the {mode.capitalize()} column of test-questions.md.", ""]
    total = 0.0
    for i, (n, q) in enumerate(questions, 1):
        print(f"Question {n} ({i}/{len(questions)})…", flush=True)
        answer, context, actions, cost = ask(mode, q)
        total += cost
        lines += [f"## {n}. {q}", "", answer, "", f"*Context: {context:,} tokens*"]
        if actions:
            lines += ["*What the model did:* " + " · ".join(actions)]
        lines += [""]
        out.write_text("\n".join(lines), encoding="utf-8")  # written as we go
    print(f"Answers: {out.relative_to(KIT)}   (cost: ${total:.2f})")


if __name__ == "__main__":
    main()
