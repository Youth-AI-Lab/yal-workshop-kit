#!/usr/bin/env python3
"""Replays the questions of test-questions.md in one workshop mode.

    replay B          all questions, in mode B
    replay D 8 11     only questions 8 and 11, in mode D
    replay A --agents examples/AGENTS.liar.md 2 6
                      questions 2 and 6, in mode A, with other instructions than AGENTS.md
                      (a demo personality of examples/, or a draft of yours): AGENTS.md is
                      not changed; modes A to F only
    replay RAG        all questions to the RAG chatbot of Open WebUI ("Wildfire RAG",
                      after openwebui start): before each answer, Open WebUI gives the model
                      the 5 excerpts of the documents closest to the question

Each question is asked in a fresh session (nothing carries over from one question to the next).
Answers are written to answers/<mode>-<time>.md (with --agents: answers/<mode>-<name>-<time>.md,
for instance A-liar-14h05.md), each with the size of the context (the gauge) and what the model
read or searched. Then score them from 0 to 2: score <mode> (with --agents: score answers/<file>
--blind).
With the OpenCode engine (workshop-login --engine opencode), the questions go to OpenCode.
"""

import http.client
import json
import os
import re
import secrets
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime
from pathlib import Path

# Its own folder first: the smoke test and others load this file with python -I, without its folder.
sys.path.insert(0, str(Path(__file__).resolve().parent))
import workshop_modes  # noqa: E402
import workshop_provider  # noqa: E402

KIT = Path(os.environ.get("WORKSHOP_HOME", Path.home() / "workshop"))
WORKSHOP = os.environ.get("WORKSHOP_CMD", "workshop")
RUN_DIR = Path(os.environ.get("WORKSHOP_RUN_DIR") or Path.home() / ".workshop-run")
MODES = {"bare": "bare", "a": "A", "b": "B", "c": "C", "d": "D", "e": "E", "f": "F", "rag": "RAG"}
# The test material: if the model saw it, the answer may be copied from the expected answers.
TEST_MATERIAL = re.compile(r"test-questions\.md|scores\.md|(^|[\s./'\"])answers/|(^|[\s./'\"])examples/")
# Left out of the copy of the kit that OpenCode searches during a replay (the top of the kit only). The
# saved .zip files and the Open WebUI administrator account have no use there either. .git holds the
# history of the test material: the copy gets an empty repository instead (make_view).
NOT_IN_VIEW = shutil.ignore_patterns("test-questions.md", "scores*.md", "answers", "examples", ".git", "*.zip",
                                     ".openwebui-class")
# The label every answer of a deceptive demo bot must start with (examples/AGENTS.liar.md...).
DEMO_LABEL = "⚠️ Demo bot: this answer contains deliberate errors."
HAS_LABEL = re.compile(r"demo bot: this answer contains deliberate errors", re.I)


class Explained(str):
    """An error that already says what to do: "Check the key" after it would send people the wrong way."""


BLOCKED = "the company that runs the model blocked this answer (content filter)."
EMPTY_ANSWER = Explained("the model gave an empty answer and no reason. Try this question again. "
                         "If all the answers are empty, ask the facilitator.")


def read_rows():
    """Rows of the table in test-questions.md: | no. | category | question | expected answer |
    (the question may be empty: question 12 before workshop 1). A "|" inside a cell is written "\\|";
    a plain one would cut the question without a word, so the file is refused."""
    rows = []
    for line in (KIT / "test-questions.md").read_text(encoding="utf-8").splitlines():
        s = line.strip().removeprefix("|")
        s = s[:-1] if s.endswith("|") and not s.endswith("\\|") else s
        cells = [c.strip().replace("\\|", "|") for c in re.split(r"(?<!\\)\|", s)]
        if len(cells) >= 3 and cells[0].isdigit():
            if len(cells) > 4:
                raise SystemExit(f"Question {cells[0]} in test-questions.md has a | in its text. "
                                 "Write \\| instead, or use another word.")
            rows.append((int(cells[0]), cells[2]))
    return rows


def read_questions():
    """The rows with a question."""
    return [(n, q) for n, q in read_rows() if q]


def persona_name(path):
    """AGENTS.liar.md -> liar; any other name -> a slug of it (My bot.md -> my-bot).
    The same rule as the run folder of workshop (agents-<name>)."""
    stem = path.name[:-3] if path.name.endswith(".md") else path.name
    if stem.startswith("AGENTS."):
        stem = stem[len("AGENTS."):]
    return re.sub(r"[^a-z0-9]+", "-", stem.lower()).strip("-") or "custom"


def new_file(folder, stem):
    """folder/stem.md, or stem-2.md, stem-3.md... if it exists already: an earlier replay of the
    same minute, or answers brought back from another workshop, are never overwritten. The file
    is created empty at once, so that it is taken."""
    for k in range(1, 1000):
        path = folder / (f"{stem}.md" if k == 1 else f"{stem}-{k}.md")
        try:
            with open(path, "x", encoding="utf-8"):
                return path
        except FileExistsError:
            continue
    raise SystemExit(f"Too many answers files named {stem} in {folder}: move some away.")


def engine():
    """The engine of `workshop`: WORKSHOP_ENGINE, else the one saved by workshop-login, else claude."""
    name = os.environ.get("WORKSHOP_ENGINE", "")
    if not name:
        try:
            name = "".join((Path.home() / ".workshop-engine").read_text(encoding="utf-8", errors="replace").split())
        except OSError:
            name = ""
    return name or "claude"


def check_data_rule(rule):
    """OpenCode's server and Open WebUI keep the data rule of their start. After a workshop-login --europe
    (or --no-europe) in another terminal, the next question must not go out under the old rule."""
    if workshop_provider.routing() != rule:
        raise SystemExit("Your data rule changed during this replay (workshop-login --europe or --no-europe). The next "
                         "question was not sent.\nThe answers so far stay in answers/. Type the same replay command again.")


def claude_engine_line():
    """The model of Claude Code: --model, else the one workshop-login saved in its settings."""
    model = os.environ.get("WORKSHOP_MODEL")
    if not model:
        try:
            saved = json.loads((Path.home() / ".claude" / "settings.json").read_text(encoding="utf-8"))
            model = saved["env"]["ANTHROPIC_MODEL"]
        except (OSError, ValueError, KeyError, TypeError):
            model = os.environ.get("ANTHROPIC_MODEL") or workshop_provider.ANTHROPIC.chat
    return f"Engine: Claude Code (model {model})"


def ask(mode, question, agents=None, server=None):
    """Asks one question, returns (answer, context tokens, actions, cost, error, peeked)."""
    if server is not None:
        return server.ask(question)  # OpenCode
    cmd = [WORKSHOP, mode, "-p", question, "--output-format", "stream-json", "--verbose",
           "--max-turns", "15"]
    if os.environ.get("WORKSHOP_MODEL"):
        cmd += ["--model", os.environ["WORKSHOP_MODEL"]]
    env = dict(os.environ)
    env.pop("WORKSHOP_AGENTS", None)  # only --agents chooses other instructions
    if agents:
        env["WORKSHOP_AGENTS"] = str(agents)
    try:
        run = subprocess.run(cmd, capture_output=True, text=True, encoding="utf-8", errors="replace",
                             timeout=300, stdin=subprocess.DEVNULL, env=env)
    except subprocess.TimeoutExpired:
        return "", 0, [], 0.0, "no answer after 5 minutes", False
    answer, context, actions, cost, error, peeked = None, 0, [], 0.0, None, False
    for line in run.stdout.splitlines():
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if not isinstance(d, dict):
            continue
        if d.get("type") == "assistant":
            u = d["message"].get("usage") or {}
            # Size of the context at this step: what was sent to the model.
            context = max(context, u.get("input_tokens", 0) + u.get("cache_read_input_tokens", 0)
                          + u.get("cache_creation_input_tokens", 0))
            for c in d["message"]["content"]:
                if c.get("type") == "tool_use":
                    actions.append(describe(c["name"], c.get("input") or {}))
                    peeked = peeked or bool(TEST_MATERIAL.search(json.dumps(c.get("input") or {})))
        elif d.get("type") == "user":
            # What the tools sent back (a grep on the whole kit names the files it matched).
            content = (d.get("message") or {}).get("content")
            if isinstance(content, list):
                for c in content:
                    if c.get("type") == "tool_result":
                        peeked = peeked or bool(TEST_MATERIAL.search(json.dumps(c.get("content"))))
        elif d.get("type") == "result":
            answer = (d.get("result") or "").strip()
            cost = d.get("total_cost_usd") or 0.0
            if d.get("is_error"):
                error = answer or d.get("subtype") or "error"
    if error is None and (run.returncode != 0 or answer is None):
        last = (run.stderr.strip().splitlines() or [""])[-1]
        error = last or f"workshop exited with code {run.returncode}"
    return answer or "", context, actions, cost, error, peeked


def describe(tool, args):
    if tool == "Read":
        return "read " + os.path.relpath(args.get("file_path", "?"), KIT)
    if tool == "Bash":
        return "ran `" + args.get("command", "?") + "`"
    if tool == "Skill":
        return "used the skill " + args.get("skill", "?")
    if tool.startswith("mcp__"):
        return "called the MCP tool " + tool.split("__")[-1]
    return "used " + tool


# ---------------------------------------------------------------- OpenCode

def describe_opencode(tool, args, view=None):
    """The same sentences as describe(), for OpenCode's tool names (MCP tools: <server>_<tool>).
    A path in the view is shown as the path in the kit."""
    path = str(args.get("path") or args.get("filePath") or "?")
    if os.path.isabs(path):
        in_view = view is not None and Path(path).is_relative_to(view)
        path = os.path.relpath(path, view if in_view else KIT)
    if tool == "read":
        return "read " + path
    if tool == "shell":
        return "ran `" + str(args.get("command", "?")) + "`"
    if tool == "grep":
        return f"searched for `{args.get('pattern', '?')}`" + (f" in {path}" if args.get("path") else "")
    if tool == "glob":
        return f"listed the files `{args.get('pattern', '?')}`" + (f" in {path}" if args.get("path") else "")
    if tool == "skill":
        return "used the skill " + str(args.get("id") or args.get("name") or "?")
    if tool in ("edit", "write"):
        return f"used {tool} on {path}"
    if "_" in tool:  # OpenCode's own tools have no "_" in their names
        return "called the MCP tool " + tool.split("_", 1)[1]
    return "used " + tool


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


class OpenCode:
    """One private OpenCode server for the whole replay: `workshop <mode> serve` (the same config
    as the chat of that mode), a random password, and a fresh database deleted at the end, so
    that an "Allow always" given in a chat never applies here. Each question is a new session:
    `opencode run --server` with the question on stdin, then `opencode session export` for the
    size of the context, the cost and the tool calls (`run` does not report the last step).

    In the modes with search tools, the server works in a view: a copy of the kit without the test
    material, made at the start, in the run folder. OpenCode's grep and glob read the whole kit whatever
    the instructions say, and a rule on their path does not stop them (grep is matched on its pattern).
    With the view there is nothing to find, and each answer stays comparable."""

    def __init__(self, mode, agents):
        self.mode, self.url, self.cwd, self.model, self.steps = mode, None, KIT, "?", 15
        self.rule = workshop_provider.routing()  # read before the server, which reads it once
        self.proc, self.run_dir, self.view = None, None, None
        self.priced, self.price_unknown = False, False
        RUN_DIR.mkdir(parents=True, exist_ok=True)
        # Named oc-*: workshop-opencode removes those older than a day if replay was killed.
        self.tmp = Path(tempfile.mkdtemp(prefix=f"oc-replay-{mode}-", dir=RUN_DIR))
        self.env = dict(os.environ, WORKSHOP_ENGINE="opencode", OPENCODE_PASSWORD=secrets.token_urlsafe(24),
                        XDG_DATA_HOME=str(self.tmp / "data"), OPENCODE_DISABLE_AUTOUPDATE="1",
                        OPENCODE_DISABLE_MODELS_FETCH="1")
        self.env.pop("WORKSHOP_AGENTS", None)  # only --agents chooses other instructions
        if agents:
            self.env["WORKSHOP_AGENTS"] = str(agents)
        if os.environ.get("WORKSHOP_MODEL") and not os.environ.get("WORKSHOP_OPENCODE_MODEL"):
            self.env["WORKSHOP_OPENCODE_MODEL"] = os.environ["WORKSHOP_MODEL"]

    def engine_line(self):
        return f"Engine: OpenCode (model {self.model})"

    def start(self):
        """Starts the server and waits until it answers and its MCP servers are connected (else
        the first question would go out without their tools). Raises SystemExit with the reason."""
        if workshop_modes.MODES[self.mode].search:
            self.make_view()
        log = self.tmp / "server.log"
        with open(log, "w", encoding="utf-8") as out:
            # Its own process group: stop() ends the MCP servers it started, too.
            self.proc = subprocess.Popen([WORKSHOP, self.mode, "serve", "--hostname", "127.0.0.1",
                                          "--port", str(free_port())], env=self.env, stdin=subprocess.DEVNULL,
                                         stdout=out, stderr=subprocess.STDOUT, start_new_session=True)
        deadline = time.monotonic() + 60
        while self.url is None:  # its first line of JSON: url, folder, model, steps
            if self.proc.poll() is not None or time.monotonic() > deadline:
                self.fail(log)
            for line in log.read_text(encoding="utf-8", errors="replace").splitlines():
                try:
                    info = json.loads(line) if line.startswith("{") else {}
                except json.JSONDecodeError:
                    continue
                if info.get("url"):
                    self.url, self.cwd = info["url"], Path(info.get("directory") or KIT)
                    self.model, self.steps = info.get("model") or "?", int(info.get("steps") or 15)
                    self.run_dir = Path(info["run_dir"]) if info.get("run_dir") else None
                    self.priced = bool(info.get("priced"))
            time.sleep(0.2)
        states = None
        while time.monotonic() < deadline:
            if self.proc.poll() is not None:
                self.fail(log)
            states = self.mcp_states()
            # The list is empty while the kit's folder loads: D, E and F always have servers.
            if states is not None and (states or self.mode not in ("D", "E", "F")) \
                    and "pending" not in states.values():
                break
            time.sleep(0.3)
        if states is None:
            self.fail(log)
        for name, state in sorted(states.items()):
            if state != "connected":
                print(f"Warning: the MCP server {name} is not ready ({state}): the answers will not have "
                      "its tools.", flush=True)
        self.check_key()

    def check_key(self):
        """The server reads the key at its first model request, then keeps it. If it were still to come, a
        workshop-login in another terminal could send a key of one company to the address of the other. So
        it reads it now, and only then is the saved key compared with the model of this replay."""
        try:
            self.cli("api", "--server", self.url, "get", "/api/model", timeout=30)  # has the key in clear: not kept
        except subprocess.TimeoutExpired:
            pass
        now = workshop_provider.provider_of(workshop_provider.read_key())
        if now and not self.model.startswith(now.name + "/"):
            raise SystemExit(f"The saved key changed while replay was starting: it is now a key for {now.label}. "
                             "Nothing was sent. Type the same replay command again.")

    def make_view(self):
        """The copy of the kit the model searches. A persona of examples/ is not in it: workshop-opencode
        gets its full path (WORKSHOP_AGENTS) and copies it into the instructions."""
        self.view = self.tmp / "view"
        try:
            shutil.copytree(KIT, self.view, symlinks=True,
                            ignore=lambda folder, names: NOT_IN_VIEW(folder, names) if Path(folder) == KIT else set())
        except shutil.Error as e:  # raised at the end: everything else is there
            print(f"Warning: {len(e.args[0])} file(s) of the kit could not be copied for this replay: "
                  "the model will not see them.", flush=True)
        # OpenCode's search only follows .gitignore in a git repository: a kit in one must stay so here, or
        # replay would find graphify's files and others that the chat never sees.
        kit = KIT.resolve()
        if any((folder / ".git").exists() for folder in (kit, *kit.parents)):
            try:
                subprocess.run(["git", "init", "-q", "--template="], cwd=self.view, capture_output=True, timeout=30,
                               check=True)
            except (OSError, subprocess.SubprocessError):
                print("Warning: this replay may search more files than the chat does (git did not work here).",
                      flush=True)
        self.env["WORKSHOP_HOME"] = str(self.view)

    def fail(self, log):
        text = log.read_text(encoding="utf-8", errors="replace").strip() if log.is_file() else ""
        lines = [l for l in text.splitlines() if not l.startswith("{")]
        raise SystemExit("\n".join(lines[-5:]) or "OpenCode did not start. Ask the facilitator.")

    def client_env(self):
        return dict(self.env, PWD=str(self.cwd))  # OpenCode takes its folder from $PWD

    def cli(self, *args, timeout=60, **kw):
        return subprocess.run(["opencode", *args], cwd=self.cwd, env=self.client_env(), timeout=timeout,
                              capture_output=True, text=True, **kw)

    def mcp_states(self):
        """{server: status} from the server, or None if it does not answer yet."""
        try:
            data = json.loads(self.cli("api", "--server", self.url, "get", "/api/mcp", timeout=10).stdout)
            return {m["name"]: (m.get("status") or {}).get("status", "?") for m in data.get("data") or []}
        except (ValueError, KeyError, TypeError, AttributeError, subprocess.TimeoutExpired):
            return None

    def ask(self, question):
        """Returns (answer, context tokens, actions, cost, error, peeked), like ask()."""
        check_data_rule(self.rule)
        (self.tmp / "question.txt").write_text(question, encoding="utf-8")
        events = self.tmp / "run.jsonl"
        # The question on stdin: as an argument, OpenCode 2.1.4 sends it wrapped in quotes.
        with open(self.tmp / "question.txt", encoding="utf-8") as q, open(events, "w") as out, \
                open(self.tmp / "run.err", "w") as err:
            client = subprocess.Popen(["opencode", "run", "--server", self.url, "--format", "json"], stdin=q,
                                      stdout=out, stderr=err, cwd=self.cwd, env=self.client_env())
            try:
                client.wait(300)
            except subprocess.TimeoutExpired:
                client.kill()
                client.wait()
                self.interrupt()  # the session would go on in the server without its client
                return "", 0, [], 0.0, "no answer after 5 minutes", False
        sid, error, texts = None, None, []
        for d in read_events(events):
            sid = sid or d.get("sessionID")
            if d.get("type") == "error":
                error = opencode_error(d.get("error") or {})
            elif d.get("type") == "text":
                texts.append((d.get("part") or {}).get("text", ""))
        if sid is None:
            # Not one event: this is how an empty answer ends, with code 0 (measured with 2.1.4).
            last = ((self.tmp / "run.err").read_text(errors="replace").strip().splitlines() or [""])[-1]
            nothing = EMPTY_ANSWER if client.returncode == 0 else f"opencode exited with code {client.returncode}"
            return "", 0, [], 0.0, error or last or nothing, False
        try:
            export = json.loads(self.cli("session", "export", "--server", self.url, sid).stdout)
            answer, context, actions, cost, peeked, steps = parse_export(export, self.view)
        except (ValueError, AttributeError, subprocess.TimeoutExpired):
            answer, context, actions, cost, peeked, steps = "\n".join(texts).strip(), 0, [], 0.0, False, 0
        if error is None and client.returncode != 0:
            error = f"opencode exited with code {client.returncode}"
        if error is None and not answer:
            error = EMPTY_ANSWER
        # OpenCode ignores the cost that the provider reports: without a price, it always says 0.
        self.price_unknown = self.price_unknown or (cost == 0 and context > 0 and not self.priced)
        if error is None and steps >= self.steps:
            # The last step allowed: OpenCode takes the tools away and makes the model answer
            # (Claude Code stops with an error instead, at --max-turns 15).
            print(f"  The model used all its {self.steps} steps: its answer was forced, without more tools.",
                  flush=True)
            actions.append(f"used all its {self.steps} steps, so OpenCode made it answer without tools")
        return answer, context, actions, cost, error, peeked

    def interrupt(self):
        """Stops the sessions still running in the server (its own: this replay's questions), which
        would otherwise go on without the client. `run` names its session only once the model answers."""
        try:
            active = json.loads(self.cli("api", "--server", self.url, "get", "/api/session/active",
                                         timeout=10).stdout).get("data") or {}
            for sid in active:
                self.cli("api", "--server", self.url, "post", f"/api/session/{sid}/interrupt", timeout=10)
        except (ValueError, AttributeError, subprocess.TimeoutExpired):
            pass

    def stop(self):
        """Stops the server and the MCP servers it started, then deletes its folders."""
        if self.proc is not None:
            self.signal_group(signal.SIGTERM)
            try:
                self.proc.wait(10)
            except subprocess.TimeoutExpired:
                pass
            for _ in range(20):  # its MCP servers end with it: a moment for them
                if not self.signal_group(0):
                    break
                time.sleep(0.1)
            self.signal_group(signal.SIGKILL)  # whatever is left
            try:
                self.proc.wait(5)
            except subprocess.TimeoutExpired:
                pass
        shutil.rmtree(self.tmp, ignore_errors=True)
        # The run folder of workshop-opencode (its config and instructions): only that one.
        if self.run_dir and self.run_dir.parent.resolve() == RUN_DIR.resolve() \
                and self.run_dir.name.startswith(f"oc-{self.mode}-"):
            shutil.rmtree(self.run_dir, ignore_errors=True)

    def signal_group(self, sig):
        """Sends sig to the server's process group; False if nothing is left in it."""
        try:
            os.killpg(self.proc.pid, sig)
            return True
        except (ProcessLookupError, PermissionError):
            return False


def read_events(path):
    """The JSON events of `opencode run --format json`, one per line."""
    for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        if isinstance(d, dict):
            yield d


def opencode_error(e):
    """An error event of `opencode run`, in a few words. 401 is the key; 402, 429 and 503 are not, and a
    403 is not always (OpenCode calls every 403 provider.auth: a spending limit, a text flagged by moderation).
    (OpenCode tries 429 and 503 again for about 90 seconds before it reports them: measured with 2.1.4.)"""
    data = e.get("data") if isinstance(e.get("data"), dict) else {}
    status = data.get("statusCode") or e.get("status") or e.get("statusCode")
    message = str(data.get("message") or e.get("message") or "").strip()
    kind = str(e.get("type") or e.get("name") or "error")
    said = f"{status}{': ' + message if message else ''}"
    what = workshop_provider.error_kind(status, message)
    if what == "limit":
        return Explained(f"this key or its account reached a spending limit ({said}). Raise the limit on the "
                         "provider's website, or ask the facilitator.")
    if what == "refused":
        return Explained(f"the company that runs the model blocked this text ({said}). Change the question, "
                         "or ask the facilitator.")
    if kind == "provider.content-filter":
        return Explained(BLOCKED)
    if kind == "output-limit":
        return Explained("the model stopped at its length limit before the end of its answer.")
    if kind == "compaction.failed":
        return Explained("this question and its documents are too long for the window of this model. "
                         "Choose a model with a larger window: workshop-login --models openrouter")
    if status == 401 or kind == "provider.auth":
        return f"the key was refused ({status or 401}{': ' + message if message else ''}). Check it: workshop-login"
    if status == 402:
        return Explained(f"no credits left on this key ({said}). Add credits on the provider's website, "
                         "or ask the facilitator.")
    if status == 429:
        return Explained(f"too many requests, or the quota of this key or of this model is used up ({said}). "
                         "Wait a minute, then try again.")
    if status == 503 or "no endpoints" in message.lower():  # what the routing of OpenRouter can lead to
        return Explained(f"the model is busy, or no company can serve it now ({said}). Try again later, "
                         "or ask the facilitator.")
    return f"{kind}{f' {status}' if status else ''}: {message}".strip().rstrip(":")


def parse_export(export, view=None):
    """From `opencode session export`: (answer, context, actions, cost, peeked, steps). The context is
    the largest request of the session (what was sent to the model at one step), as with Claude Code."""
    answer, context, actions, peeked, steps = "", 0, [], False, 0
    for m in export.get("messages") or []:
        if m.get("type") != "assistant":
            continue
        steps += 1
        t = m.get("tokens") or {}
        cache = t.get("cache") or {}
        context = max(context, (t.get("input") or 0) + (cache.get("read") or 0) + (cache.get("write") or 0))
        texts = []
        for c in m.get("content") or []:
            if c.get("type") == "text":
                texts.append(c.get("text", ""))
            elif c.get("type") == "tool":
                state = c.get("state") or {}
                args = state.get("input") or {}
                actions.append(describe_opencode(c.get("name") or "?", args if isinstance(args, dict) else {}, view))
                # What came back (a grep on the whole kit names files). Asking is not seeing: a call that
                # failed or was refused returned nothing, and a search for the name finds nothing in the view.
                if state.get("status") != "error":
                    seen = json.dumps([state.get("content"), state.get("output")])
                    peeked = peeked or bool(TEST_MATERIAL.search(seen))
        if "".join(texts).strip():
            answer = "\n".join(texts).strip()  # the last step that wrote text
    cost = (export.get("info") or {}).get("cost") or 0.0
    if view is not None:  # the model only knows the folder it works in
        answer = answer.replace(f"{view}/", "")
    return answer, context, actions, cost, peeked, steps


class OpenWebUIRag:
    """The RAG chatbot of Open WebUI ("Wildfire RAG (workshop kit)", made by openwebui start), through
    its chat API: one new conversation per question. Before each answer, Open WebUI picks the
    excerpts of the workshop knowledge closest to the question (vector search) and gives them to
    the model. The answer cites them as [1], [2]...: one number per file, in the order of the
    excerpts (measured with Open WebUI v0.11.4 and v0.12.4), so the file of each number is written
    below it."""

    MODEL_ID, MODEL_NAME = "wildfire-rag", "Wildfire RAG (workshop kit)"

    def __init__(self):
        self.url = f"http://127.0.0.1:{int(os.environ.get('WORKSHOP_OPENWEBUI_PORT', '3000'))}"
        self.token = ""
        self.rule = workshop_provider.routing()  # start() checks that Open WebUI has this one

    def engine_line(self):
        service = workshop_provider.provider_of(workshop_provider.read_key()) or workshop_provider.ANTHROPIC
        # score reads "(model ...)": nothing else inside these brackets.
        return (f'Engine: Open WebUI, chatbot "{self.MODEL_NAME}" (model {workshop_provider.chat_model(service)}), '
                "given the excerpts of summaries/ and corpus/text/ closest to each question")

    def request(self, method, path, body=None, timeout=30):
        headers = {"Content-Type": "application/json", "Accept": "application/json"}
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        req = urllib.request.Request(self.url + path, method=method, headers=headers,
                                     data=None if body is None else json.dumps(body).encode())
        opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))  # 127.0.0.1: no proxy
        with opener.open(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode() or "null")

    def start(self):
        if os.environ.get("OPENWEBUI_MODE") == "class":
            raise SystemExit("replay RAG is for the workshop kit (openwebui without accounts), not the class mode.")
        not_running = "Open WebUI is not running, or not ready yet. Type: openwebui start"
        try:
            # Without accounts (openwebui start of the kit), an empty sign-in gives the token.
            self.token = self.request("POST", "/api/v1/auths/signin", {"email": "", "password": ""})["token"]
            models = self.request("GET", "/api/models")
            ids = {m.get("id") for m in models.get("data", []) if isinstance(m, dict)}
        except urllib.error.HTTPError as e:
            if e.code in (400, 401, 403):
                raise SystemExit("The Open WebUI on this port asks for an account (the class mode of the Open WebUI "
                                 "guide?): replay RAG works with the one of the kit, made by openwebui start.") from None
            raise SystemExit(not_running) from None
        except (OSError, ValueError, KeyError, TypeError, AttributeError, http.client.HTTPException):
            raise SystemExit(not_running) from None
        if self.MODEL_ID not in ids:
            raise SystemExit(f'Open WebUI has no chatbot "{self.MODEL_NAME}" yet. Type: openwebui start')
        # No accounts in the kit's Open WebUI: openwebui stops it and refuses if its port is public. And
        # Open WebUI keeps the key of its start: another key since then means another provider or model
        # than the Engine line says.
        openwebui = shutil.which("openwebui") or str(Path(__file__).resolve().parent / "openwebui")
        for command in ("check-private", "check-same-key"):
            try:
                check = subprocess.run([openwebui, command], capture_output=True, text=True, timeout=60)
            except (OSError, subprocess.SubprocessError):
                continue
            if check.returncode != 0:
                raise SystemExit(check.stderr.strip() or f"openwebui {command} failed.")
        # The RAG column is measured with 5 excerpts per question (openwebui start). openwebui top-k
        # changes it for every chat of this Open WebUI, from the next question.
        try:
            top_k = self.request("GET", "/api/v1/retrieval/config").get("TOP_K")
        except (urllib.error.HTTPError, OSError, ValueError, AttributeError, http.client.HTTPException):
            top_k = None
        if top_k not in (None, 5):
            raise SystemExit(f"The Wildfire RAG models now get {top_k} excerpts per question (openwebui top-k), "
                             "but the RAG column is measured with 5.\nType openwebui top-k 5, then replay RAG again.")

    def ask(self, question):
        """Same tuple as ask(): (answer, context tokens, excerpts, cost, error, peeked)."""
        check_data_rule(self.rule)
        try:
            r = self.request("POST", "/api/chat/completions", {
                "model": self.MODEL_ID, "messages": [{"role": "user", "content": question}], "stream": False},
                timeout=300)
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:200]
            return "", 0, [], 0.0, f"Open WebUI answered HTTP {e.code}: {detail}", False
        except (OSError, ValueError, http.client.HTTPException) as e:
            return "", 0, [], 0.0, f"no answer from Open WebUI ({e})", False
        try:
            choice = r["choices"][0]
            answer = (choice["message"].get("content") or "").strip()
        except (KeyError, IndexError, TypeError):
            return "", 0, [], 0.0, f"unexpected answer from Open WebUI: {str(r)[:200]}", False
        if not answer:
            return "", 0, [], 0.0, self.why_empty(r, choice), False
        context = int(((r.get("usage") or {}).get("prompt_tokens")) or 0)
        numbers = {}  # one number per file, in the order of the excerpts
        for source in r.get("sources") or []:
            for meta in source.get("metadata") or []:
                name = meta.get("source") or meta.get("name") or "?"
                numbers.setdefault(name, len(numbers) + 1)
        # On the line "What the model did", which score reads and shows to the judge: the answer's
        # [1], [2]... only make sense with the files they stand for.
        shown = [f"[{n}] " + name.replace("summaries__", "summaries/").replace("corpus-text__", "corpus/text/")
                 for name, n in numbers.items()]
        if shown:
            shown.insert(0, "Open WebUI gave it excerpts of these files, numbered as in the answer")
        return answer, context, shown, 0.0, None, False

    @staticmethod
    def why_empty(reply, choice):
        """Open WebUI answered, without any text. That alone says nothing about the key."""
        error = choice.get("error") or reply.get("error")
        if error:
            said = error.get("message") if isinstance(error, dict) else error
            return Explained(f"Open WebUI gave an empty answer: {str(said)[:200]}")
        finish = choice.get("finish_reason")
        if finish == "content_filter":
            return Explained(BLOCKED)
        if finish == "length":
            return Explained("the model stopped at its length limit before it wrote an answer.")
        return Explained("Open WebUI gave an empty answer and no reason. If all the answers are empty, check the key "
                         "and its credits: workshop-login, then openwebui start, which gives the key to Open WebUI.")

    def stop(self):
        pass


def stop_on_signal(signum, frame):
    # So that the server is stopped and an empty answers file removed (finally) on kill or hang-up.
    raise SystemExit(128 + signum)


def main():
    if len(sys.argv) < 2 or sys.argv[1].lower() not in MODES:
        if len(sys.argv) > 1 and sys.argv[1].lower() not in ("help", "-h", "--help"):
            print(f"Unknown mode: {sys.argv[1]}. Modes: bare, A, B, C, D, E, F, RAG.\n")
        print(__doc__.strip())
        sys.exit(1)
    mode = MODES[sys.argv[1].lower()]
    rest = sys.argv[2:]
    agents = None
    if "--agents" in rest:
        i = rest.index("--agents")
        if i + 1 >= len(rest) or rest[i + 1].isdigit() or rest[i + 1].startswith("-"):
            print("--agents needs a file, for example: replay A --agents examples/AGENTS.liar.md")
            sys.exit(1)
        given = rest[i + 1]
        del rest[i:i + 2]
        agents = Path(given).expanduser()
        if not agents.is_absolute() and not agents.is_file():
            agents = KIT / given  # relative to the kit: examples/AGENTS.liar.md
        if not agents.is_file():
            print(f"Instructions file not found: {given}")
            print("Give the path of a file, for example: examples/AGENTS.feurisson.md")
            sys.exit(1)
        agents = agents.resolve()
        if agents == (KIT / "AGENTS.md").resolve():
            agents = None  # the kit's own instructions: a plain replay, scored in scores.md
        elif mode == "bare":
            print("Mode bare has no instructions at all: --agents only works with modes A to F.")
            sys.exit(1)
        elif mode == "RAG":
            print("The RAG chatbot has its own instructions (made by openwebui start): --agents only works "
                  "with modes A to F.")
            sys.exit(1)
    if mode in workshop_modes.MODES:
        message = workshop_modes.missing(workshop_modes.MODES[mode], KIT)
        if message:  # before the first question, not three errors later
            print(message)
            sys.exit(1)
    unknown = [a for a in rest if a.startswith("-")]
    if unknown:
        print(f"Unknown option: {' '.join(unknown)}. The only option is --agents <file>.")
        sys.exit(1)
    # A typing mistake must not replay (and pay for) all the questions.
    wrong = [a for a in rest if not a.isdecimal()]
    if wrong:
        print(f"Not a question number: {wrong[0]}. Example: replay {sys.argv[1]} 8 11")
        sys.exit(1)
    numbers = {int(n) for n in rest}
    absent = sorted(numbers - {n for n, _ in read_rows()})
    if absent:
        print(f"No question {', '.join(map(str, absent))} in test-questions.md.")
        sys.exit(1)
    questions = [(n, q) for n, q in read_questions() if not numbers or n in numbers]
    if not questions:
        print("No question found: fill in the Question column of test-questions.md.")
        sys.exit(1)
    server = None
    if mode == "RAG":
        server = OpenWebUIRag()  # Open WebUI, whatever the engine of workshop
    else:
        name = engine()
        if name not in ("claude", "opencode"):
            print(f"Unknown engine: {name} (claude or opencode). Type: workshop-login")
            sys.exit(1)
        # Pinned: a key changed during this replay never changes the engine of the remaining questions.
        os.environ["WORKSHOP_ENGINE"] = name
        if name == "opencode":
            server = OpenCode(mode, agents)
    signal.signal(signal.SIGTERM, stop_on_signal)
    signal.signal(signal.SIGHUP, stop_on_signal)
    try:
        if server:
            print("Checking Open WebUI…" if mode == "RAG" else "Starting OpenCode…", flush=True)
            server.start()
        write_answers(mode, agents, questions, server)
    finally:
        if server:
            server.stop()


def write_answers(mode, agents, questions, server=None):
    """Creates the answers file, then fills it (run)."""
    (KIT / "answers").mkdir(exist_ok=True)
    stem = f"{mode}-{persona_name(agents)}" if agents else mode
    out = new_file(KIT / "answers", f"{stem}-{datetime.now():%Hh%M}")
    shown_out = out.relative_to(KIT)
    # A demo bot that lies on purpose: each of its answers must carry the label (checked below).
    labelled = bool(agents) and "Demo bot:" in agents.read_text(encoding="utf-8", errors="replace")
    if agents:
        try:
            shown = agents.relative_to(KIT.resolve())
        except ValueError:
            shown = agents  # outside the kit: the full path
        lines = [f"# Answers: mode {mode}, {datetime.now():%Y-%m-%d %H:%M}", "",
                 f"Instructions: {shown}", "",
                 f"These answers come from other instructions than AGENTS.md. Score them with: "
                 f"score {shown_out} --blind (the scores go into scores-personas.md, not scores.md).", ""]
    else:
        lines = [f"# Answers: mode {mode}, {datetime.now():%Y-%m-%d %H:%M}", "",
                 (f"Score each answer from 0 to 2 with: score RAG (it adds a RAG column to scores.md, "
                  f"after B, the first time)." if mode == "RAG" else
                  f"Score each answer from 0 to 2 with: score {mode} (the scores go into the "
                  f"{mode.capitalize()} column of scores.md)."), ""]
    # Under the title, so that score and the people who read the file know the engine.
    lines[2:2] = [server.engine_line() if server else claude_engine_line(), ""]
    try:
        run(mode, agents, questions, out, shown_out, labelled, lines, server)
    except KeyboardInterrupt:
        print("\nStopped." + (f" The answers so far are in {shown_out}." if out.stat().st_size else ""))
        sys.exit(130)
    finally:
        if out.stat().st_size == 0:
            out.unlink()  # stopped before the first answer: no empty file left behind


def run(mode, agents, questions, out, shown_out, labelled, lines, server=None):
    """Asks the questions one by one and writes the answers file as it goes."""
    total, errors, in_a_row, asked = 0.0, 0, 0, 0
    start = time.monotonic()
    for i, (n, q) in enumerate(questions, 1):
        asked = i
        print(f"Question {n} ({i}/{len(questions)})…", flush=True)
        answer, context, actions, cost, error, peeked = ask(mode, q, agents, server)
        total += cost
        lines += [f"## {n}. {q}", ""]
        if error:
            errors += 1
            in_a_row += 1
            print(f"  ERROR: {error}", flush=True)
            lines += [f"**ERROR, do not score this one: {error}**", ""]
        else:
            in_a_row = 0
            if peeked:
                print("  Warning: the model looked at the test material.", flush=True)
                lines += ["**Warning: the model looked at the test material (test-questions.md, scores.md, answers/ "
                          "or examples/). It may have copied the expected answer: score 0.**", ""]
            if labelled and not HAS_LABEL.search(answer):
                # The persona promises the label on every answer: never leave a deliberate error
                # without it in a file that people read, copy and show.
                print("  The model left out the demo bot label: replay added it.", flush=True)
                lines += [DEMO_LABEL, "*(Label added by replay: the model left it out.)*", ""]
            lines += [answer, "", f"*Context: {context:,} tokens*"]
            if actions:
                lines += ["*What the model did:* " + " · ".join(actions)]
            lines += [""]
        out.write_text("\n".join(lines), encoding="utf-8", errors="replace")  # written as we go
        if in_a_row == 3:
            print("Three errors in a row: stopping." if isinstance(error, Explained) else
                  "Three errors in a row: stopping. Check the key (workshop-login" +
                  (", then openwebui start" if mode == "RAG" else "") + ") and the network.")
            break
    minutes, seconds = divmod(round(time.monotonic() - start), 60)
    if mode == "RAG":
        cost = "not shown by Open WebUI"
    elif server is not None and server.price_unknown:
        cost = "not known, OpenCode has no price for this model"
    else:
        cost = f"${total:.2f}"
    print(f"Answers: {shown_out}   (cost: {cost}, time: {minutes} min {seconds:02d} s)")
    if errors < asked:  # at least one answer to score
        print(f"Next: score {shown_out} --blind" if agents else f"Next: score {mode}")
    if errors:
        print(f"{errors} question(s) failed: they are marked ERROR in the file. Ask the facilitator.")
        sys.exit(1)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:                     # before the first question
        print("\nStopped.")
        sys.exit(130)
    except Exception as e:                        # never a Python traceback for participants
        sys.exit(f"replay stopped on an unexpected error ({type(e).__name__}: {e}). "
                 "The answers given so far stay in answers/. Ask the facilitator.")
