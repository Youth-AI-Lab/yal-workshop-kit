#!/usr/bin/env bash
# Workshop 5: unpacks the wiki that the facilitator built before the session, from all of corpus/
# (except the document you added yourselves), with the skills that keep it up to date:
#   wiki/                       pages by topic, index.md, log.md, AGENTS.md (the rules of the wiki)
#   .claude/skills/ingest/      "ingest summaries/8N-… into the wiki"
#   .claude/skills/lint/        "lint the wiki": checks footnotes, links, contradictions
#   wiki/graphify-out/          the knowledge graph of the wiki, built with graphify (workshop 5)
# Then: workshop E.
set -euo pipefail

KIT="${WORKSHOP_HOME:-$HOME/workshop}"
PACK="$KIT/.workshop/wiki-pack.tar.gz"

case "${1:-}" in
  -h|--help|help) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
esac
if [[ ! -f "$PACK" ]]; then
  echo "Wiki pack not found ($PACK). Ask the facilitator." >&2
  exit 1
fi
if [[ -f "$KIT/wiki/index.md" ]]; then
  echo "The wiki is already there: open wiki/index.md, or type: workshop E"
  exit 0
fi

tar -xzf "$PACK" -C "$KIT" --no-same-owner
pages="$(find "$KIT/wiki" -maxdepth 1 -name '*.md' ! -name index.md ! -name log.md ! -name AGENTS.md ! -name CLAUDE.md | wc -l)"
echo "Wiki ready: $pages pages in wiki/ (start with wiki/index.md, history in wiki/log.md)."
echo "New skills: ingest and lint (.claude/skills/)."
echo "Next: workshop E, then for example: ingest summaries/8N-… into the wiki"
