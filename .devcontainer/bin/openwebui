# --- From workshop 4: the live tool (MCP) -----------------------------------------------------------------
# Rule (Sébastien, 2026-11): in Open WebUI, MCP read-only, public sources only, no personal data. The kit's
# fire-danger server reads mcp/fire-danger.json (filled in from public sources) and nothing else. The time server
# is not served: fire_danger gives today's date itself, and Open WebUI's image does not have mcp-server-time.
# Open-Meteo (WORKSHOP_WEATHER) never: it reaches the internet. The server runs in a container of its own (the
# Open WebUI image has the mcp package), as a plain user, read-only, on a Docker network with no way out shared
# with Open WebUI only; a random token, kept only in the two containers' settings (like the key: docker inspect,
# which the chatbot of the workshop cannot run), is required by the server (mcp_http.py).
MCP_SERVER_ID = "fire-danger"
MCP_TOOL_ID = f"server:mcp:{MCP_SERVER_ID}"
# Full names: Open WebUI keeps a tool whose name ENDS with one of these (str.endswith, measured). recorded_example
# (a past day) is left out, by this filter and by the server itself.
MCP_TOOLS = ("fire_danger", "territories")
MCP_CONTAINER = CONTAINER + "-mcp"
MCP_NETWORK = CONTAINER + "-tools"
MCP_PORT = 8000
MCP_URL = f"http://{MCP_CONTAINER}:{MCP_PORT}/mcp"
MCP_HELPER = Path(__file__).resolve().parent / "mcp_http.py"


def fail(message, code=1):
    print(message, file=sys.stderr)
    sys.exit(code)


# --- Class mode: the facilitator's secrets and the sign-up state -------------------------------------

def state_dir():
    """Next to the repository when possible: it stays when the Codespace is rebuilt. In a dev
    container on one's own computer, /workspaces belongs to root: then in the repository itself
    (ignored by git), which stays too; the home folder of the container is lost at a rebuild."""
    for base in (KIT.parent, KIT, Path.home()):
        folder = base / ".openwebui-class"
        try:
            folder.mkdir(mode=0o700, exist_ok=True)
            return folder
        except OSError:
            continue
    fail("Cannot create the folder .openwebui-class for your administrator password.")


def class_secrets():
    """The administrator account and the session key, made once and kept (only you can read them).
    Returns (secrets, made_now)."""
    path = state_dir() / "admin.json"
    if path.is_file():
        return json.loads(path.read_text()), False
    made = {"email": ADMIN_EMAIL, "password": secrets.token_urlsafe(12),
            "secret_key": secrets.token_urlsafe(32)}
    path.write_text(json.dumps(made))
    path.chmod(0o600)
    return made, True


def signup_is_open():
    path = state_dir() / "signup"
    return path.is_file() and path.read_text().strip() == "open"


def set_signup(is_open):
    (state_dir() / "signup").write_text("open\n" if is_open else "closed\n")


# --- Docker -------------------------------------------------------------------------------------

def docker(*args, capture=True):
    return subprocess.run(["docker", *args], text=True,
                          capture_output=capture, check=False)


def check_docker():
    if not shutil.which("docker") or docker("info").returncode != 0:
        fail("Docker is not available here, and Open WebUI needs it.\n"
             "In a Codespace, Docker starts with the Codespace: wait one minute and try again.")


def provider():
    """The saved key, its provider, and the model chosen by workshop-login."""
    key = read_key()
    if not key:
        fail("No key yet. First type: workshop-login")
    service = provider_of(key)
    if service is None:
        fail("The saved key is neither an Anthropic key (it starts with sk-ant-) nor an OpenRouter key "
             "(it starts with sk-or-).\nType workshop-login again.")
    return key, service, chat_model(service)


def base_models(key, model):
    """The plain models of this Open WebUI. Class mode also offers a cheaper one."""
    return list(dict.fromkeys([model, provider_of(key).small])) if CLASS else [model]


def routed(params, service):
    """The settings of a model, with the routing of OpenRouter (workshop_provider.routing()), and without
    it with another provider. Open WebUI adds custom_params to the request and reads a text as JSON.
    A text, as Advanced Params -> Custom Parameters saves it."""
    params = dict(params)
    custom = params.get("custom_params")
    if service is OPENROUTER:
        # Anything but a table cannot be added to (and Open WebUI could not read it in a chat).
        params["custom_params"] = {**(custom if isinstance(custom, dict) else {}), "provider": json.dumps(routing())}
    elif isinstance(custom, dict) and "provider" in custom:
        custom = {name: value for name, value in custom.items() if name != "provider"}
        if custom:
            params["custom_params"] = custom
        else:
            del params["custom_params"]
    return params


def offered_models(env):
    """The plain models a running Open WebUI offers, from its settings. None when it cannot be told."""
    try:
        return json.loads(env["OPENAI_API_CONFIGS"])["0"]["model_ids"]
    except (KeyError, TypeError, ValueError):
        return None


def container_env(name):
    """The settings (-e) of a container, or None when there is no such container."""
    result = docker("inspect", "--format", "{{json .Config.Env}}", name)
    if result.returncode != 0:
        return None
    return dict(item.split("=", 1) for item in json.loads(result.stdout) if "=" in item)


def mcp_wanted():
    """True from workshop 4: the kit has the fire-danger server (mcp/) and declares it (.mcp.json). Never in class
    mode (the Open WebUI guide has no live tool)."""
    folder = KIT / "mcp"
    if CLASS or folder.is_symlink() or not (folder / "fire_danger_server.py").is_file():
        return False
    try:
        servers = json.loads((KIT / ".mcp.json").read_text(encoding="utf-8")).get("mcpServers")
    except (OSError, ValueError, AttributeError):
        return False
    return isinstance(servers, dict) and MCP_SERVER_ID in servers


def mcp_connection(token):
    """TOOL_SERVER_CONNECTIONS of Open WebUI: the fire-danger server, its read-only tools only. In the environment,
    not set through the API: with ENABLE_PERSISTENT_CONFIG false, a connection set through the API is lost at the next
    restart, and the chatbot then answers without its tool, saying nothing (measured, 0.12.4)."""
    return [{"type": "mcp", "url": MCP_URL, "path": "", "auth_type": "bearer", "key": token,
             "config": {"enable": True, "function_name_filter_list": ",".join(MCP_TOOLS)},
             "info": {"id": MCP_SERVER_ID, "name": "Fire danger (workshop kit)",
                      "description": "Today's wildfire danger level, read from mcp/fire-danger.json. Read-only."}}]


def mcp_token_of(env):
    """The token of the fire-danger connection in a container's settings, or ""."""
    try:
        connections = json.loads((env or {}).get("TOOL_SERVER_CONNECTIONS") or "[]")
        return next((c.get("key") or "" for c in connections
                     if isinstance(c, dict) and (c.get("info") or {}).get("id") == MCP_SERVER_ID), "")
    except (ValueError, TypeError, AttributeError):
        return ""


def mcp_network():
    """A Docker network with no way out (--internal): only Open WebUI and the fire-danger server are on it."""
    found = docker("network", "inspect", "--format", "{{.Internal}}", MCP_NETWORK)
    if found.returncode == 0:
        if found.stdout.strip() != "true":
            fail(f"The Docker network {MCP_NETWORK} is not one of this command (it can reach the internet).\n"
                 f"Type openwebui stop, then docker network rm {MCP_NETWORK}, then openwebui start.")
        return
    made = docker("network", "create", "--internal", "--label", "yal.kit=openwebui-tools", MCP_NETWORK)
    if made.returncode != 0:
        fail(f"Open WebUI could not start: {made.stderr.strip()}")


def start_mcp_server(token):
    """Starts the fire-danger server for Open WebUI, again each time (one or two seconds): an edited
    fire_danger_server.py is taken, and a server that fails is said, even one that Docker restarts in a loop (a running
    one was kept before, and said nothing then: measured). Returns True when it runs. Never stops Open WebUI: without
    the server, the chatbot answers without its live tool."""
    folder = (KIT / "mcp").resolve()
    args = ["--name", MCP_CONTAINER, "--restart", "unless-stopped", "--network", MCP_NETWORK,
            # A plain user (the one of this Codespace, who can read mcp/), nothing writable, no privileges.
            "--user", f"{os.getuid()}:{os.getgid()}", "--read-only", "--tmpfs", "/tmp", "--cap-drop", "ALL",
            "--security-opt", "no-new-privileges",
            # fire-danger.json is read at each call: the pair edits it in mcp/, the answer follows.
            "-v", f"{folder}:/srv/kit-mcp:ro", "-v", f"{MCP_HELPER}:/srv/mcp_http.py:ro",
            "--entrypoint", "python"]
    command = [IMAGE, "-I", "-B", "/srv/mcp_http.py", "--server", "/srv/kit-mcp/fire_danger_server.py",
               "--port", str(MCP_PORT), "--allowed-host", f"{MCP_CONTAINER}:{MCP_PORT}"]
    command += [part for tool in MCP_TOOLS for part in ("--tool", tool)]
    config = hashlib.sha256(json.dumps(args + command).encode()).hexdigest()[:16]
    docker("rm", "-f", MCP_CONTAINER)
    result = subprocess.run(["docker", "run", "-d", *args, "--label", f"yal.kit.config={config}", "-e", "MCP_TOKEN",
                             *command], text=True, capture_output=True, env={**os.environ, "MCP_TOKEN": token})
    start = time.monotonic()
    while result.returncode == 0 and time.monotonic() - start < 30:
        log = docker("logs", MCP_CONTAINER)
        if "fire-danger: http://" in (log.stdout or ""):
            print(f"  Live tool ready: fire-danger ({', '.join(MCP_TOOLS)}), read-only.", flush=True)
            return True
        # Stopped, or started again by Docker after a failure (--restart): it failed.
        if docker("inspect", "--format", "{{.State.Running}} {{.RestartCount}}", MCP_CONTAINER).stdout.strip() \
                != "true 0":
            break
        time.sleep(1)
    why = (result.stderr or docker("logs", "--tail", "5", MCP_CONTAINER).stderr or "").strip()
    # Not left restarting in a loop: openwebui start, or openwebui chatbot, starts it again.
    docker("rm", "-f", MCP_CONTAINER)
    print(f"! The live tool fire-danger could not start, so your chatbot answers without it.\n  {why[-600:]}\n"
          "  Check that mcp/fire_danger_server.py is the kit's, then type openwebui start again.", flush=True)
    return False


def check_same_key(key, model):
    """Open WebUI keeps the key and the models it was started with: they must still be the saved ones.
    A chatbot saved on a model it does not offer fails at the first question ("Model not found").
    The keys are compared here, never printed."""
    env = container_env(CONTAINER)
    if env is None:
        fail("Open WebUI is not running. Type: openwebui start")
    if env.get("OPENAI_API_KEY") != key:
        fail("Your key changed since Open WebUI started. Type openwebui start (it takes the new key),\n"
             "then this command again.")
    if offered_models(env) not in (None, base_models(key, model)):
        fail("Your model changed since Open WebUI started. Type openwebui start (it takes the new model),\n"
             "then this command again.")
    if provider_of(key) is OPENROUTER and env.get("DEFAULT_MODEL_PARAMS") != json.dumps(routed({}, OPENROUTER)):
        fail("Your data rule changed since Open WebUI started (workshop-login --europe). Type openwebui start "
             "(it takes the new rule),\nthen this command again.")
    if any(env.get(name) != value for name, value in HARDENED.items()):
        fail("Open WebUI was started by an older version of this command. Type openwebui start "
             "(your chatbots and documents are kept),\nthen this command again.")
    if mcp_wanted() and not mcp_token_of(env):
        fail("Open WebUI was started without the live tool of this workshop (mcp/). Type openwebui start "
             "(your chatbots and documents are kept),\nthen this command again.")


def address():
    """The address to open: the forwarded port of the Codespace, or localhost."""
    name = os.environ.get("CODESPACE_NAME")
    domain = os.environ.get("GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN")
    return f"https://{name}-{PORT}.{domain}" if name and domain else f"http://localhost:{PORT}"


def image_version(image):
    """(0, 12, 4) for "...open-webui:v0.12.4"; None when the tag is not a version."""
    match = re.search(r":v?(\d+)\.(\d+)\.(\d+)$", image or "")
    return tuple(int(n) for n in match.groups()) if match else None


def newer_data_in_log():
    """True when the log says the data was migrated by a newer Open WebUI (it never starts then)."""
    log = docker("logs", "--tail", "300", CONTAINER)
    return "Can't locate revision" in (log.stdout or "") + (log.stderr or "")


def fail_newer_data(newer_image="", running=False):
    """Stops with the ways out, the one that keeps the data first. newer_image: the image of the
    container already there (it is left as it is); empty when only its log tells."""
    found = f" ({newer_image})" if newer_image else ""
    if newer_image:
        keep = f"in this terminal, type export WORKSHOP_OPENWEBUI_IMAGE={newer_image}, then openwebui start"
    elif os.environ.get("WORKSHOP_OPENWEBUI_IMAGE"):
        keep = ("in this terminal, type unset WORKSHOP_OPENWEBUI_IMAGE (or set it to the newer image "
                "that made this data), then openwebui start")
    else:
        keep = ("in this terminal, type export WORKSHOP_OPENWEBUI_IMAGE=<the newer image that made this data>, "
                "then openwebui start")
    if not CLASS:
        empty = f"openwebui stop, then docker volume rm {VOLUME}, then openwebui start"
    else:
        empty = "openwebui reset (it deletes its chatbots, accounts and conversations), then openwebui start"
        if running:  # the newer container still answers: its chatbots can be saved first
            empty = "openwebui export (it saves the chatbots), then " + empty
    fail(f"This Open WebUI data was made by a newer version{found}; it cannot go back to {IMAGE}.\n"
         f"To keep this data, use the newer version again: {keep}.\n"
         f"Last resort, to start again from empty data: {empty}.")


def start_container():
    key, service, model = provider()
    if docker("image", "inspect", IMAGE).returncode != 0:
        # v0.12.4 and v0.12.5: 1.64 GB to download on amd64, 1.48 GB on arm64 (registry, 2026-10-31 and 2026-11-05).
        print(f"First time: downloading Open WebUI ({IMAGE}, about 1.6 GB, a few minutes)…", flush=True)
        if docker("pull", IMAGE, capture=False).returncode != 0:
            fail("The download failed. Check the network, then type: openwebui start")
    env = {
        "ENABLE_OLLAMA_API": "false",
        # Any explicit address skips the search for an Ollama server at startup (it runs even when
        # Ollama is off, and can wait for a name that does not exist inside the Codespace).
        "OLLAMA_BASE_URL": "http://127.0.0.1:11434",
        "ENABLE_OPENAI_API": "true",
        "OPENAI_API_BASE_URL": service.api,
        "ENABLE_PERSISTENT_CONFIG": "false",
        # RAG: local embedding model (already in the image), 5 excerpts per question, searched
        # with the question as it is (no rewording by the model).
        "RAG_TOP_K": "5",
        "ENABLE_RETRIEVAL_QUERY_GENERATION": "false",
        "ENABLE_SEARCH_QUERY_GENERATION": "false",
        **HARDENED,
        # No hidden calls to the model (titles, tags, suggestions): cheaper and easier to follow.
        "ENABLE_TITLE_GENERATION": "false",
        "ENABLE_TAGS_GENERATION": "false",
        "ENABLE_FOLLOW_UP_GENERATION": "false",
        "ENABLE_AUTOCOMPLETE_GENERATION": "false",
        "ENABLE_EVALUATION_ARENA_MODELS": "false",
        "ENABLE_COMMUNITY_SHARING": "false",
        "ENABLE_CODE_INTERPRETER": "false",
        "ENABLE_WEB_SEARCH": "false",
        "OFFLINE_MODE": "true",
        "SCARF_NO_ANALYTICS": "true",
        "DO_NOT_TRACK": "true",
        "ANONYMIZED_TELEMETRY": "false",
    }
    if service is OPENROUTER:
        # For every chat, also with a chatbot made in Workspace -> Models after this start. Each saved
        # model has it too (routed()): Open WebUI uses this default in the chat, not in its other calls.
        env["DEFAULT_MODEL_PARAMS"] = json.dumps(routed({}, service))
    # Secrets are passed through the environment, never on the command line.
    hidden = {"OPENAI_API_KEY": key}
    if CLASS:
        admin, _ = class_secrets()
        here = address()
        env.update({
            "WEBUI_AUTH": "True",
            "WEBUI_NAME": "Group chatbots",
            "OPENAI_API_CONFIGS": json.dumps({"0": {"enable": True, "model_ids": base_models(key, model)}}),
            # The facilitator's account, made at the first start only (on empty data).
            "WEBUI_ADMIN_EMAIL": admin["email"],
            "WEBUI_ADMIN_NAME": "Facilitator",
            # Participants sign up during the session only (openwebui share open / close), active at once.
            "ENABLE_SIGNUP": "true" if signup_is_open() else "false",
            "DEFAULT_USER_ROLE": "user",
            "WEBUI_URL": here,
            # Every address in use: the same list also filters the live connection of the chat.
            "CORS_ALLOW_ORIGIN": ";".join(dict.fromkeys(
                [here, f"http://localhost:{PORT}", f"http://127.0.0.1:{PORT}"])),
            # Participants cannot change a chatbot's system prompt (enforced), nor chat with several models.
            # PARAMS and CONTROLS only hide the panels since Open WebUI 0.12.4: a chatbot with
            # Model controls (Workspace -> Models) lets every participant pick them.
            "USER_PERMISSIONS_CHAT_SYSTEM_PROMPT": "false",
            "USER_PERMISSIONS_CHAT_PARAMS": "false",
            "USER_PERMISSIONS_CHAT_MULTIPLE_MODELS": "false",
            "USER_PERMISSIONS_CHAT_CONTROLS": "false",
            # Temporary chats would be missing from the usage statistics.
            "USER_PERMISSIONS_CHAT_TEMPORARY": "false",
            # For groups of young people: no files or photos of their own, no voice recordings kept,
            # no sharing of conversations between accounts (facilitator's choice, 2026-10-26).
            # These hide the buttons; the guide says it is not a lock.
            "USER_PERMISSIONS_CHAT_FILE_UPLOAD": "false",
            "USER_PERMISSIONS_CHAT_WEB_UPLOAD": "false",
            "USER_PERMISSIONS_CHAT_STT": "false",
            "USER_PERMISSIONS_CHAT_CALL": "false",
            "USER_PERMISSIONS_CHAT_SHARE": "false",
            # Notes and the calendar are off in both modes (HARDENED).
            "WEBUI_BANNERS": json.dumps([{
                "id": "no-personal-data", "type": "info", "dismissible": False, "timestamp": 0,
                "content": "Do not write personal information (yours or anyone else's) in your questions."}]),
        })
        hidden.update({"WEBUI_ADMIN_PASSWORD": admin["password"], "WEBUI_SECRET_KEY": admin["secret_key"]})
    else:
        env.update({
            # One person per Codespace: no accounts. The port is private to your GitHub account.
            "WEBUI_AUTH": "False",
            "WEBUI_NAME": "YAL workshop",
            "OPENAI_API_CONFIGS": json.dumps({"0": {"enable": True, "model_ids": [model]}}),
            "DEFAULT_MODELS": RAG_ID,
        })
    # From workshop 4: the live tool, through the environment (it survives a restart). Its token is a secret too.
    tools = mcp_wanted()
    # The settings of this container, as a fingerprint: same image and settings -> no need to recreate.
    settings = [IMAGE, env, PORT] + ([mcp_connection("")] if tools else [])
    config = hashlib.sha256(json.dumps(settings, sort_keys=True).encode()).hexdigest()[:16]
    state = docker("inspect", "--format",
                   '{{json .Config.Env}}|{{index .Config.Labels "yal.kit.config"}}|{{.State.Running}}'
                   '|{{.Config.Image}}', CONTAINER)
    reuse, token = False, ""
    if state.returncode == 0:
        env_json, label, running, old_image = state.stdout.strip().rsplit("|", 3)
        # Its data was migrated by that image: an older one cannot read it (no way back).
        old, new = image_version(old_image), image_version(IMAGE)
        if old and new and old > new:
            fail_newer_data(old_image, running == "true")
        old_env = {k: v for k, v in (i.split("=", 1) for i in json.loads(env_json) if "=" in i)}
        # The keys are compared here, never printed.
        reuse = label == config and old_env.get("OPENAI_API_KEY") == key
        if tools:
            token = mcp_token_of(old_env)
            networks = docker("inspect", "--format", "{{json .NetworkSettings.Networks}}", CONTAINER).stdout or "{}"
            reuse = reuse and bool(token) and MCP_NETWORK in json.loads(networks or "{}")
        if reuse and running != "true":
            reuse = docker("start", CONTAINER).returncode == 0
    if tools:
        mcp_network()
    if reuse:
        print("Open WebUI is already set up with your key: checking that it answers…", flush=True)
    else:
        # A new container (your data stays in its volume): it takes the key saved today.
        docker("rm", "-f", CONTAINER)
        if tools:
            token = secrets.token_urlsafe(32)
            hidden["TOOL_SERVER_CONNECTIONS"] = json.dumps(mcp_connection(token))
        # "unless-stopped": Docker may start it again by itself (not seen after a Codespace restart).
        # With the live tool: created, joined to the tools network, then started (a container joined before it
        # starts finds the server by its name).
        args = ["create" if tools else "run", *([] if tools else ["-d"]), "--name", CONTAINER,
                "--restart", "unless-stopped", "--label", f"yal.kit.config={config}",
                "-p", f"127.0.0.1:{PORT}:8080", "-v", f"{VOLUME}:/app/backend/data"]
        for name, value in env.items():
            args += ["-e", f"{name}={value}"]
        for name in hidden:
            args += ["-e", name]
        args.append(IMAGE)
        result = subprocess.run(["docker", *args], text=True, capture_output=True,
                                env={**os.environ, **hidden})
        if result.returncode == 0 and tools:
            result = docker("network", "connect", MCP_NETWORK, CONTAINER)
            if result.returncode == 0:
                result = docker("start", CONTAINER)
        if result.returncode != 0:
            fail(f"Open WebUI could not start: {result.stderr.strip()}")
        print("Open WebUI is starting (from 30 seconds to 3 minutes)…", flush=True)
    if tools:
        start_mcp_server(token)
    else:
        # A kit without mcp/ now (a save of workshop 3 restored, class mode): no server left from before.
        docker("rm", "-f", MCP_CONTAINER)
        docker("network", "rm", MCP_NETWORK)
    start, next_report, next_log = time.monotonic(), 30, 10
    while time.monotonic() - start < 360:
        try:
            with urllib.request.urlopen(f"{URL}/health", timeout=3):
                print(f"  Open WebUI answers ({time.monotonic() - start:.0f} s).", flush=True)
                return model
        except (urllib.error.URLError, http.client.HTTPException, OSError):
            elapsed = time.monotonic() - start
            # Data from a newer version, after openwebui stop (no old container to compare with).
            if elapsed >= next_log:
                next_log += 10
                if newer_data_in_log():
                    fail_newer_data()
            if elapsed >= next_report:
                print(f"  still starting… {next_report} s", flush=True)
                next_report += 30
            time.sleep(2)
    if newer_data_in_log():
        fail_newer_data()
    fail(f"Open WebUI did not start in time. Its log: docker logs {CONTAINER}\n"
         "Wait one minute, then type: openwebui start")


# --- API ----------------------------------------------------------------------------------------

class ApiError(Exception):
    def __init__(self, status, message):
        super().__init__(message)
        self.status = status


class OpenWebUI:
    def __init__(self):
        self.token = ""

    def request(self, method, path, body=None, query=None, raw=None, content_type=None):
        url = f"{URL}{path}" if path.startswith("/api/") else f"{URL}/api/v1{path}"
        if query:
            url += "?" + urllib.parse.urlencode(query)
        headers = {"Accept": "application/json"}
        if self.token:
            headers["Authorization"] = f"Bearer {self.token}"
        data = raw
        if body is not None:
            data = json.dumps(body).encode()
            headers["Content-Type"] = "application/json"
        elif content_type:
            headers["Content-Type"] = content_type
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=600) as resp:
                text = resp.read().decode()
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")
            try:
                detail = json.loads(detail).get("detail", detail)
            except (ValueError, AttributeError):
                pass
            raise ApiError(e.code, f"{method} {path}: HTTP {e.code}: {detail}") from None
        except (urllib.error.URLError, http.client.HTTPException, ConnectionError, TimeoutError):
            fail("Open WebUI is not running, or not ready yet. Type: openwebui start")
        return json.loads(text) if text else None

    def login(self):
        # Without accounts (WEBUI_AUTH=False), an empty sign-in gives the admin token.
        credentials = {"email": "", "password": ""}
        if CLASS:
            admin, _ = class_secrets()
            credentials = {"email": admin["email"], "password": admin["password"]}
        try:
            self.token = self.request("POST", "/auths/signin", body=credentials)["token"]
        except ApiError:
            if not CLASS:
                raise
            fail("Your administrator password does not open this Open WebUI (its data was made with\n"
                 "another password). To start again from zero, deleting its chatbots: openwebui reset")
        return self

    def collections(self, name):
        page, seen, found = 1, 0, []
        while True:
            answer = self.request("GET", "/knowledge/", query={"page": page})
            items = answer.get("items", [])
            found += [k for k in items if k.get("name") == name]
            seen += len(items)
            if not items or seen >= answer.get("total", 0):
                return found
            page += 1

    def files_of(self, knowledge_id):
        page, files = 1, []
        while True:
            answer = self.request("GET", f"/knowledge/{knowledge_id}/files",
                                  query={"page": page, "limit": 200})
            items = answer.get("items", [])
            files += items
            if not items or len(files) >= answer.get("total", 0):
                return files
            page += 1

    def upload(self, name, path):
        boundary = uuid.uuid4().hex
        body = (f"--{boundary}\r\n"
                f'Content-Disposition: form-data; name="file"; filename="{name}"\r\n'
                f"Content-Type: {mimetypes.guess_type(name)[0] or 'text/markdown'}\r\n\r\n").encode() \
            + path.read_bytes() + f"\r\n--{boundary}--\r\n".encode()
        # Processed now: when the answer comes, the text is cut into excerpts and indexed.
        return self.request("POST", "/files/", raw=body,
                            query={"process": "true", "process_in_background": "false"},
                            content_type=f"multipart/form-data; boundary={boundary}")

    def download(self, file_id):
        """The file as it was uploaded (a PDF stays a PDF)."""
        req = urllib.request.Request(f"{URL}/api/v1/files/{file_id}/content",
                                     headers={"Authorization": f"Bearer {self.token}"})
        try:
            with urllib.request.urlopen(req, timeout=600) as resp:
                return resp.read()
        except urllib.error.HTTPError as e:
            raise ApiError(e.code, f"GET /files/{file_id}/content: HTTP {e.code}") from None

    def model_exists(self, model_id):
        try:
            return bool(self.request("GET", "/models/model", query={"id": model_id}))
        except ApiError as e:
            if e.status == 404:
                return False
            raise

    def save_model(self, form):
        exists = self.model_exists(form["id"])
        self.request("POST", "/models/model/update" if exists else "/models/create", body=form)

    def delete_collection(self, knowledge):
        for f in self.files_of(knowledge["id"]):
            try:
                self.request("DELETE", f"/files/{f['id']}")
            except ApiError:
                pass
        self.request("DELETE", f"/knowledge/{knowledge['id']}/delete")

    def fill_collection(self, name, description, files):
        """Creates the collection if needed and adds the files it does not have yet."""
        found = self.collections(name)
        knowledge = found[0] if found else self.request(
            "POST", "/knowledge/create", body={"name": name, "description": description})
        present = {}
        for f in self.files_of(knowledge["id"]):
            present[f.get("filename") or f.get("meta", {}).get("name")] = f
        # A file deleted or renamed in the kit leaves the collection too: the same files as on disk.
        wanted = {label for label, _ in files}
        for label, old in list(present.items()):
            if label not in wanted:
                self.request("POST", f"/knowledge/{knowledge['id']}/file/remove",
                             body={"file_id": old["id"]})
                del present[label]
        failed = []
        for i, (label, path) in enumerate(files, 1):
            old = present.get(label)
            if old:
                old_hash = (old.get("meta") or {}).get("file_hash")
                if not old_hash or old_hash == hashlib.sha256(path.read_bytes()).hexdigest():
                    continue
                self.request("POST", f"/knowledge/{knowledge['id']}/file/remove",
                             body={"file_id": old["id"]})
            try:
                file = self.upload(label, path)
                self.request("POST", f"/knowledge/{knowledge['id']}/file/add",
                             body={"file_id": file["id"]})
                print(f"  [{i:2}/{len(files)}] {label}", flush=True)
            except ApiError as e:
                print(f"  [{i:2}/{len(files)}] {label}: FAILED ({e})", flush=True)
                failed.append(label)
        return knowledge, failed


def search_works(api, knowledge):
    r = api.request("POST", "/retrieval/query/collection",
                    body={"collection_names": [knowledge["id"]], "query": "fire", "k": 1})
    return bool((r.get("documents") or [[]])[0])


def check_search(api, bases):
    """A test search in each base. Seen once in four first starts in a Codespace (2026-10-30): a base
    loaded and stored, but the running Open WebUI found nothing in it until it was restarted (the RAG
    chatbot would then answer without any excerpt). If a base finds nothing: one restart, then the
    same test. Returns the API, logged in again if Open WebUI restarted."""
    empty = [k["name"] for k in bases if not search_works(api, k)]
    if not empty:
        return api
    print(f"  The search finds nothing yet in {', '.join(empty)}: restarting Open WebUI once "
          "(about 20 s)…", flush=True)
    docker("restart", CONTAINER)
    start = time.monotonic()
    while time.monotonic() - start < 180:
        try:
            with urllib.request.urlopen(f"{URL}/health", timeout=3):
                break
        except (urllib.error.URLError, http.client.HTTPException, OSError):
            time.sleep(2)
    api = OpenWebUI().login()
    empty = [k["name"] for k in bases if not search_works(api, k)]
    if empty:
        fail(f"The search still finds nothing in {', '.join(empty)}.\n"
             "Type openwebui stop, then openwebui start. If it happens again, ask the facilitator.")
    print(f"  Search OK after the restart ({time.monotonic() - start:.0f} s).", flush=True)
    return api


def size_knowledge_name(size):
    """The knowledge base of one size; 1000 is the base of openwebui start."""
    return KNOWLEDGE_NAME if size == DEFAULT_CHUNK[0] else f"{KNOWLEDGE_NAME}, excerpts of {size}"


def set_top_k(api, top_k):
    """The number of excerpts each RAG model gets in the chat. Open WebUI reads it at each question:
    nothing to restart. Saved in its data, like the size of the excerpts."""
    api.request("POST", "/retrieval/config/update", body={"TOP_K": top_k})


def set_chunks(api, size, overlap):
    """Open WebUI cuts each file when it is added, with the setting of that moment (global, not per
    knowledge base). Open WebUI saves it in its data: always put the default back afterwards."""
    api.request("POST", "/retrieval/config/update", body={"CHUNK_SIZE": size, "CHUNK_OVERLAP": overlap})


# The words a Wildfire RAG model starts with, whichever the provider was. Anything else is someone's own.
RAG_DESCRIPTION = re.compile(r"^(Claude|The model) \+ the workshop knowledge, by vector search \(RAG\)\.")


def rag_description(service):
    who = "The model" if service is OPENROUTER else "Claude"
    return f"{who} + the workshop knowledge, by vector search (RAG)."


def rag_model(model, size, knowledge, service):
    """The form of a "Wildfire RAG" model: the model + one knowledge base, classic RAG (legacy)."""
    model_id, name = (RAG_ID, RAG_NAME) if size is None else (f"{RAG_ID}-{size}", f"Wildfire RAG {size}")
    what = "" if size is None else f" Excerpts of {size} characters."
    return {
        "id": model_id, "base_model_id": model, "name": name, "is_active": True,
        "meta": {"description": rag_description(service) + what,
                 "knowledge": [{"id": knowledge["id"], "name": knowledge["name"],
                                "description": knowledge.get("description", ""), "type": "collection"}],
                 # No tools: classic RAG. The excerpts enter the context before each answer.
                 "capabilities": NO_TOOLS},
        # "legacy": Open WebUI searches before each answer and adds the excerpts to the context.
        # No temperature or top_p: Claude Sonnet 5.5 refuses them.
        "params": routed({"system": RAG_PROMPT, "function_calling": "legacy"}, service),
    }


def knowledge_files():
    """The same files as mode B of `workshop`: summaries/ and corpus/text/."""
    files = []
    for folder, prefix in FOLDERS:
        for path in sorted((KIT / folder).glob("*.md")):
            if path.name not in SKIPPED and not path.name.startswith("00-"):
                files.append((prefix + path.name, path))
    return files


def plain_model(model, service, hidden):
    """The form of a plain model, without built-in tools: chosen by mistake (or by its id, also when it is
    hidden from the list), it would search every knowledge base with tools (agentic search), not by RAG,
    and get Open WebUI's other tools (memories, other conversations…). The chatbots built on it keep their
    own settings."""
    return {"id": model, "base_model_id": None, "name": model, "is_active": True,
            "meta": {"hidden": hidden, "capabilities": {**NO_TOOLS, "file_context": False, "citations": False},
                     "builtinTools": dict(NO_BUILTIN_TOOLS)},
            "params": routed({"function_calling": "legacy"}, service)}


def wide_tools_on(bot):
    """The switches of WIDE_TOOLS still on for this chatbot (empty when it gets no built-in tools at all)."""
    meta, params = bot.get("meta") or {}, bot.get("params") or {}
    if params.get("function_calling") == "legacy" or (meta.get("capabilities") or {}).get("builtin_tools") is False:
        return []
    switches = meta.get("builtinTools") if isinstance(meta.get("builtinTools"), dict) else {}
    return [label for category, label in WIDE_TOOLS.items() if switches.get(category, True) is not False]


def hide_base_model(api, model, service):
    """Hides the plain model from the list, without built-in tools (plain_model)."""
    api.save_model(plain_model(model, service, hidden=True))


@functools.lru_cache(maxsize=None)
def has_tools(service, model):
    """False when OpenRouter says this model cannot use tools. None when it cannot be told."""
    if service is not OPENROUTER:
        return True
    try:
        with urllib.request.urlopen(f"{service.api}/models", timeout=15) as resp:
            rows = json.load(resp)["data"]
        row = next((r for r in rows if r.get("id") == model), None)
        return None if row is None else "tools" in (row.get("supported_parameters") or [])
    except (urllib.error.URLError, http.client.HTTPException, OSError, ValueError, KeyError, TypeError,
            AttributeError):
        return None


def excerpts_without_tools(name, params, meta, service, model):
    """A chatbot searches its knowledge with tools (native), and a model without tools would fail at the
    first question. workshop-login refuses such a model: this is a safety net. Changes params and meta."""
    if params.get("function_calling") == "legacy" or has_tools(service, model) is not False:
        return
    params["function_calling"] = "legacy"
    meta["capabilities"] = {**(meta.get("capabilities") or {}), "builtin_tools": False}
    print(f'{model} cannot use tools, so "{name}" cannot search its knowledge by itself.\n'
          "Open WebUI gives it excerpts before each answer instead.", flush=True)


def realign_models(api, key, service, model):
    """Each chatbot names its plain model. After a change of key or of model, that plain model is gone
    from this Open WebUI and the chatbot stops working ("Model not found"). Moves every chatbot to the
    model of today, and gives every saved model the routing of today's provider (routed()). A chatbot
    on the cheaper model stays on the cheaper one. A chatbot made by an older openwebui chatbot or import
    had all of Open WebUI's built-in tools: it gets the knowledge tools only (a choice made in Workspace ->
    Models, saved in builtinTools, is kept). Saves only what changes."""
    offered = base_models(key, model)
    records = api.request("GET", "/models/all")
    chatbots = {r["id"] for r in records if r.get("base_model_id")}
    moved = {}  # the new plain model -> the chatbots moved to it
    trimmed = []
    for record in records:
        base, old_params, old_meta = record.get("base_model_id"), record.get("params") or {}, record.get("meta") or {}
        if not base and record["id"] not in offered:
            continue  # the plain model of another key: nobody can reach it here
        new_base = base
        if base and base not in offered and base not in chatbots:
            new_base = offered[-1] if base in CHEAP_MODELS else model
        params, meta = routed(old_params, service), dict(old_meta)
        if isinstance(meta.get("description"), str):  # null for a chatbot without one, and it stays null
            meta["description"] = RAG_DESCRIPTION.sub(rag_description(service), meta["description"])
            if (base and record["id"].startswith("chatbot-") and KIT_CHATBOT.match(meta["description"])
                    and "builtinTools" not in meta):
                meta["builtinTools"] = dict(KNOWLEDGE_TOOLS_ONLY)
                trimmed.append(record["name"])
        if new_base != base:
            excerpts_without_tools(record["name"], params, meta, service, new_base)
            moved.setdefault(new_base, []).append(record["name"])
        elif params == old_params and meta == old_meta:
            continue
        api.request("POST", "/models/model/update",
                    body={"id": record["id"], "base_model_id": new_base, "name": record["name"],
                          "is_active": record.get("is_active", True), "meta": meta, "params": params})
    for new_base, names in moved.items():
        print(f"Your key or your model changed: {', '.join(names)} now use{'s' if len(names) == 1 else ''} "
              f"{new_base}.", flush=True)
    if trimmed:
        print(f"{', '.join(trimmed)}: only the tools that search and read {'its' if len(trimmed) == 1 else 'their'} "
              "knowledge now (no notes, skills, tasks or other tools).", flush=True)
    reload_models(api)


def reload_models(api):
    """A chat uses the copy of each model Open WebUI made when its model list was last read (by a page, or
    here), not what was just saved: without this, a running Open WebUI kept a chatbot's old tools until
    the page was reloaded (measured, 0.12.4)."""
    api.request("GET", "/api/models")


def warn_young_people(service):
    if service is OPENROUTER and not europe():
        print("\nWarning: with young people, turn on zero-data-retention models hosted in Europe: "
              f"workshop-login --europe\nHow to do it: {OPENROUTER_GUIDE}")


def name_second_model_chatbots(api, key, model):
    """Coming back to the first model leaves a chatbot on the second one: nothing tells it from a chatbot
    built on it, so realign_models() keeps it. With --europe that model reads much less, so name them."""
    second = base_models(key, model)[1:]
    names = [r["name"] for r in api.request("GET", "/models/all") if r.get("base_model_id") in second]
    if names and europe():
        print(f"{', '.join(names)} stay{'s' if len(names) == 1 else ''} on {second[0]}, which reads much less "
              f"at once.\nTo move a chatbot: Workspace -> Models -> the chatbot -> Base Model (From) -> {model} "
              "-> Save & Update.", flush=True)


# --- Skills -------------------------------------------------------------------------------------
# A chatbot of these commands has no Skills tools (KNOWLEDGE_TOOLS_ONLY): the model can neither list, read nor
# write skills. Its skills are attached instead (meta.skillIds), and Open WebUI 0.12.4 then puts the whole text of
# each one in the system prompt, at every message (utils/middleware.py). A package brings its skills as
# skills/<folder>/SKILL.md; the chatbot gets those, never a skill already in Open WebUI that it did not bring.

def package_skills(archive):
    """[(folder, text of SKILL.md)] of a package, in the order of their folders."""
    found = []
    for member in sorted(archive.namelist()):
        match = SKILL_MEMBER.match(member)
        if match:
            found.append((match.group(1), archive.read(member).decode("utf-8", errors="replace")))
    return found


def skill_header(text, folder):
    """(id, name) of a skill, as Open WebUI's import reads them: the name of its header, else the folder."""
    name = ""
    head = re.match(r"\A---[ \t]*\r?\n(.*?)\r?\n---[ \t]*(\r?\n|\Z)", text, re.S)
    if head:
        line = re.search(r"^name:[ \t]*(.+?)[ \t]*$", head.group(1), re.M)
        value = line.group(1) if line else ""
        # YAML: a comment starts with " #", outside quotes.
        name = value.strip("'\"").strip() if value[:1] in "'\"" else re.sub(r"\s+#.*$", "", value).strip()
    name = name or folder
    return re.sub(r"[^a-z0-9_-]+", "-", name.lower()).strip("-") or "my-skill", name


def multipart(fields, files):
    """fields: {name: text}; files: [(field, filename, bytes, type)]."""
    boundary = uuid.uuid4().hex
    body = b""
    for name, value in fields.items():
        body += f'--{boundary}\r\nContent-Disposition: form-data; name="{name}"\r\n\r\n{value}\r\n'.encode()
    for field, filename, data, kind in files:
        body += (f'--{boundary}\r\nContent-Disposition: form-data; name="{field}"; filename="{filename}"\r\n'
                 f"Content-Type: {kind}\r\n\r\n").encode() + data + b"\r\n"
    return body + f"--{boundary}--\r\n".encode(), f"multipart/form-data; boundary={boundary}"


def get_skill(api, skill_id):
    try:
        return api.request("GET", f"/skills/id/{urllib.parse.quote(skill_id)}")
    except ApiError as e:
        if e.status == 404:
            return None
        raise


def skill_users(api):
    """skill id -> the ids of the models it is attached to."""
    users = {}
    for record in api.request("GET", "/models/all"):
        for skill_id in (record.get("meta") or {}).get("skillIds") or []:
            users.setdefault(skill_id, set()).add(record["id"])
    return users


def save_skills(api, skills, own, users):
    """Puts the skills of a package in Open WebUI, by its own import (it reads the description in the header),
    and returns their ids, to attach to the chatbots `own` (model ids). users: skill_users() before. A skill with
    the same id is kept when its text is the same, replaced when no other chatbot uses it (in class mode: when it
    is already one of these chatbots' own), else saved under another id: it never changes another chatbot's skill."""
    ids = []
    for folder, text in skills:
        base_id, base_name = skill_header(text, folder)
        # An export of openwebui export names each folder by its skill id: the same text under that id is the same
        # skill (two skills with the same name in their header would otherwise swap ids and texts at each import).
        same = get_skill(api, folder) if folder != base_id and re.fullmatch(r"[a-z0-9_-]+", folder) else None
        if same and folder not in ids and same.get("content") == text and same.get("is_active", True):
            ids.append(folder)
            continue
        error = ""
        for n in range(1, 21):
            skill_id, name = (base_id, base_name) if n == 1 else (f"{base_id}-{n}", f"{base_name} ({n})")
            if skill_id in ids:
                continue  # two folders with the same name in their header
            old = get_skill(api, skill_id)
            if old and old.get("content") == text and old.get("is_active", True):
                error = ""
                break
            others = users.get(skill_id, set())
            if old and not (others <= own and (others or not CLASS)):
                continue
            decision = {"action": "create", "id": skill_id, "name": name}
            if old:
                decision.update(action="replace", expected_version_id=old.get("version_id"))
            body, kind = multipart({"decisions": json.dumps([decision])},
                                   [("files", "SKILL.md", text.encode(), "text/markdown")])
            try:
                result = (api.request("POST", "/skills/import", raw=body, content_type=kind) or [{}])[0]
            except ApiError as e:  # the whole file refused (over 10 MiB, for example)
                result = {"error": str(e).split(": ", 2)[-1]}
            if result.get("status") == "saved":
                if old and not old.get("is_active", True):
                    api.request("POST", f"/skills/id/{urllib.parse.quote(skill_id)}/toggle")
                error = ""
                break
            error = str(result.get("error") or result)
            if "name already exists" not in error:
                break
        else:
            error = error or "no free id"
        if error:  # left out, not a stop: the chatbots are still saved, with their other skills
            print(f"! Left out: the skill {folder}. Open WebUI refused it ({error}). Check its header "
                  "(name, description) and its size.", flush=True)
            continue
        ids.append(skill_id)
    return ids


def drop_old_skills(api, own, keep, users):
    """Deletes the skills that only these chatbots used and no longer use (a skill renamed or removed)."""
    for skill_id, models in users.items():
        if skill_id not in keep and models & own and models <= own:
            try:
                api.request("DELETE", f"/skills/id/{urllib.parse.quote(skill_id)}/delete")
            except ApiError as e:
                if e.status != 404:
                    raise


def skill_names(api, ids):
    return [(get_skill(api, skill_id) or {}).get("name") or skill_id for skill_id in ids]


# --- Commands -----------------------------------------------------------------------------------

def hold_lock():
    """Takes the lock until this command ends, or stops with a message if it is taken."""
    if os.environ.get("WORKSHOP_OPENWEBUI_LOCK") == "held":   # inside workshop-start 2's flock
        return
    global _lock
    _lock = open(LOCK, "a")
    try:
        fcntl.flock(_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        fail("Open WebUI is already being prepared, in another terminal or in the background "
             "(workshop-start 2).\nWait for it to end (tail -f .workshop/openwebui-start.log), then try again.")


def cmd_start():
    hold_lock()
    check_docker()
    model = start_container()
    key, service, _ = provider()
    refuse_public_port()
    api = OpenWebUI().login()
    files = knowledge_files()
    if files:
        print(f"Checking the workshop knowledge: {len(files)} files (same as mode B). "
              "The first time, loading them takes 1 to 2 minutes.", flush=True)
    start = time.monotonic()
    # The default size and number of excerpts, even if openwebui sizes or top-k changed them: the
    # RAG demo and replay RAG are always measured the same way.
    set_chunks(api, *DEFAULT_CHUNK)
    set_top_k(api, TOP_K)
    knowledge, failed = api.fill_collection(KNOWLEDGE_NAME, KNOWLEDGE_DESCRIPTION, files)
    if failed:
        fail("Some files could not be loaded (see above). Type openwebui start again.")
    if files:   # workshop 1 has no knowledge yet: an empty base finds nothing, and that is normal
        api = check_search(api, [knowledge])
        print(f"  Knowledge up to date ({time.monotonic() - start:.0f} s).", flush=True)
    api.save_model(rag_model(model, None, knowledge, service))
    hide_base_model(api, model, service)
    realign_models(api, key, service, model)  # the other models of this instance, after a change of key
    # No "What's new" window at the first visit: it would hide the chat.
    version = api.request("GET", "/api/config").get("version")
    api.request("POST", "/users/user/settings/update", body={"ui": {"version": version}})
    print(f'\nOpen WebUI is ready, with the model "{RAG_NAME}".')
    print(f"Open it: {address()}")
    print(f"(or: Ports tab of the bottom panel -> {PORT} -> Open in Browser)")
    print("To see what the RAG finds for a question: openwebui query \"<question>\"")
    print("To ask it the test questions and score it: replay RAG, then score RAG")


def cmd_sizes():
    """Workshop 2: the knowledge base of openwebui start (excerpts of 1000 characters), plus one
    more of 2000, and one "Wildfire RAG" model per size."""
    hold_lock()
    check_docker()
    key, service, model = provider()
    check_same_key(key, model)
    api = OpenWebUI().login()
    if not api.collections(KNOWLEDGE_NAME):
        fail("The workshop knowledge is not loaded yet. Type: openwebui start")
    files = knowledge_files()
    bases = {}
    try:
        for size, overlap in SIZES.items():
            name = size_knowledge_name(size)
            if size != DEFAULT_CHUNK[0]:
                print(f"Excerpts of {size} characters: {len(files)} files (the first time, 1 to 2 minutes)…",
                      flush=True)
            start = time.monotonic()
            set_chunks(api, size, overlap)
            description = f"The same files as {KNOWLEDGE_NAME!r}, cut into excerpts of {size} characters."
            bases[size], failed = api.fill_collection(name, description, files)
            if failed:
                fail(f"Some files could not be loaded in {name!r} (see above). Type openwebui sizes again.")
            if size != DEFAULT_CHUNK[0]:
                print(f"  Ready ({time.monotonic() - start:.0f} s).", flush=True)
    finally:
        # Back to the default size, for every file added later (chatbots, openwebui start).
        set_chunks(api, *DEFAULT_CHUNK)
    api = check_search(api, list(bases.values()))
    for size, knowledge in bases.items():
        api.save_model(rag_model(model, size, knowledge, service))
    print("\nTwo models, the same documents cut into excerpts of two sizes:")
    for size in SIZES:
        print(f'  "Wildfire RAG {size}"')
    print("Compare what each base finds:  openwebui query --size 2000 \"<question>\"")
    print("Change the number of excerpts: openwebui query --size 1000 --top-k 10 \"<question>\"")


def cmd_top_k(value):
    """Workshop 2: the number of excerpts every "Wildfire RAG" model gets in the chat."""
    try:
        top_k = int(value)
    except ValueError:
        top_k = 0
    if not 1 <= top_k <= 50:
        fail("Usage: openwebui top-k N   (N from 1 to 50; the default is 5)")
    api = OpenWebUI().login()
    set_top_k(api, top_k)
    print(f"From the next question, each RAG model (\"Wildfire RAG\", and your chatbot made with openwebui chatbot --rag) "
          f"gets {top_k} excerpts.\nBack to {TOP_K}: openwebui top-k {TOP_K} (openwebui start does it too).")


def parse_query(args):
    """openwebui query [--size N] [--top-k N] "<question>" """
    size, top_k, words = DEFAULT_CHUNK[0], TOP_K, []
    usage = 'Usage: openwebui query [--size 1000|2000] [--top-k N] "<question>"'
    i = 0
    while i < len(args):
        if args[i] in ("--size", "--top-k") and i + 1 < len(args):
            try:
                value = int(args[i + 1])
            except ValueError:
                fail(usage)
            if args[i] == "--size":
                if value not in SIZES:
                    fail(f"The sizes are {', '.join(map(str, SIZES))}. {usage}")
                size = value
            else:
                if not 1 <= value <= 50:
                    fail(f"Give a number of excerpts from 1 to 50. {usage}")
                top_k = value
            i += 2
        else:
            words.append(args[i])
            i += 1
    if len(words) != 1:
        fail(usage)
    return words[0], size, top_k


def cmd_query(text, size=DEFAULT_CHUNK[0], top_k=TOP_K):
    api = OpenWebUI().login()
    found = api.collections(size_knowledge_name(size))
    if not found:
        fail("The workshop knowledge is not loaded yet. Type: openwebui start" if size == DEFAULT_CHUNK[0]
             else f"The base of excerpts of {size} characters is not ready. Type: openwebui sizes")
    answer = api.request("POST", "/retrieval/query/collection",
                         body={"collection_names": [found[0]["id"]], "query": text, "k": top_k})
    documents = (answer.get("documents") or [[]])[0]
    metadatas = (answer.get("metadatas") or [[]])[0]
    scores = (answer.get("distances") or [[]])[0]
    print(f"Question: {text}")
    print(f"Base: excerpts of {size} characters. Top-k: {top_k}.")
    print(f"The {len(documents)} excerpts the RAG gives the model (closest first):")
    for i, document in enumerate(documents):
        meta = metadatas[i] if i < len(metadatas) else {}
        score = f" (score {scores[i]:.3f})" if i < len(scores) else ""
        excerpt = " ".join(document.split())
        print(f"\n#{i + 1} {meta.get('name') or meta.get('source')}{score}")
        print(f"   {excerpt}")
    print("\nThe model sees only these excerpts. Is the answer to your question in them?")


def slug(text):
    text = unicodedata.normalize("NFKD", text).encode("ascii", "ignore").decode()
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-") or "my-chatbot"


def knowledge_ref(knowledge):
    return [{"id": knowledge["id"], "name": knowledge["name"], "description": knowledge.get("description", ""),
             "type": "collection"}]


def chatbot_forms(name, instructions, knowledge, skill_ids, service, model, wiki=False, tool_ids=()):
    """The two chatbots of openwebui chatbot, by id: the default one (the model searches its knowledge with tools,
    native) and the RAG one (--rag: Open WebUI gives it excerpts before each answer, legacy, as "Wildfire RAG").
    Same instructions, knowledge and skills. wiki: the knowledge has the wiki's map (wiki__index.md). tool_ids: the
    live tool (MCP_TOOL_ID), for the default one only. Changes nothing in Open WebUI."""
    native_id = "chatbot-" + slug(name)
    addendum = CHATBOT_ADDENDUM + (CHATBOT_WIKI_ADDENDUM if wiki else "")
    params = routed({"system": instructions + addendum, "function_calling": "native"}, service)
    meta = {"description": f"The chatbot built by {name}: their instructions and knowledge.",
            "knowledge": knowledge_ref(knowledge),
            # Built-in tools on: the model searches and reads its knowledge itself (mode E). Those tools only.
            "capabilities": {**NO_TOOLS, "builtin_tools": True}, "builtinTools": dict(KNOWLEDGE_TOOLS_ONLY),
            "skillIds": list(skill_ids)}
    if tool_ids:
        # The browser sends the chatbot's toolIds with each message (Open WebUI does not read them itself);
        # realign_models keeps them, like every other setting of meta.
        meta["toolIds"] = list(tool_ids)
    rag = {"id": native_id + RAG_SUFFIX, "base_model_id": model, "name": f"{name} chatbot (RAG)", "is_active": True,
           "meta": {"description": f"The chatbot built by {name}: their instructions and knowledge, by vector search "
                                   "(RAG).",
                    "knowledge": knowledge_ref(knowledge),
                    # No tools: classic RAG, the top-k of this Open WebUI (openwebui top-k), excerpts of 1000 characters.
                    "capabilities": NO_TOOLS, "builtinTools": dict(NO_BUILTIN_TOOLS), "skillIds": list(skill_ids)},
           "params": routed({"system": instructions + CHATBOT_RAG_ADDENDUM, "function_calling": "legacy"}, service)}
    return {native_id: {"id": native_id, "base_model_id": model, "name": f"{name} chatbot", "is_active": True,
                        "meta": meta, "params": params},
            rag["id"]: rag}


def cmd_chatbot(args):
    name, rag = "my-chatbot", args.count("--rag") == 1
    args = [a for a in args if a != "--rag"] if rag else args
    if args[:1] == ["--name"] and len(args) == 2 and args[1].strip() and not args[1].startswith("--"):
        name = args[1].strip()
    elif args:
        fail(CHATBOT_USAGE)
    hold_lock()
    key, service, model = provider()
    check_docker()
    check_same_key(key, model)
    refuse_public_port(then="type openwebui start, then this command again")
    api = OpenWebUI().login()
    # From workshop 4: the live tool, started again if it stopped (check_same_key checked that Open WebUI has it).
    tools = mcp_wanted() and start_mcp_server(mcp_token_of(container_env(CONTAINER)))
    # The same package as for a Claude Project or a Gemini Gem.
    if subprocess.run(["chatbot-export", "--name", name]).returncode != 0:
        fail("chatbot-export failed: nothing was added to Open WebUI.")
    package = KIT / f"{slug(name)[:60].strip('-')}.zip"  # chatbot-export cuts the name of its file at 60
    with zipfile.ZipFile(package) as archive:
        instructions = archive.read("instructions.md").decode().strip()
        skills = package_skills(archive)
        tmp = KIT / ".workshop" / "openwebui-chatbot"
        shutil.rmtree(tmp, ignore_errors=True)
        tmp.mkdir(parents=True)
        files = []
        for member in archive.namelist():
            if member.startswith("knowledge/") and member.endswith(".md") and "/.." not in member:
                target = tmp / Path(member).name
                target.write_bytes(archive.read(member))
                files.append((target.name, target))
    # The skills first: the old knowledge base is deleted below, and the chatbots point to it until they are saved.
    native_id = "chatbot-" + slug(name)
    own = {native_id, native_id + RAG_SUFFIX}
    users = skill_users(api)
    skill_ids = save_skills(api, skills, own, users)
    knowledge_name = f"{name} knowledge"
    for old in api.collections(knowledge_name):  # a new export replaces the previous one
        api.delete_collection(old)
    print(f'Adding "{name} chatbot" to Open WebUI: {len(files)} knowledge files…', flush=True)
    # Files are cut with the setting of the moment: the default size, whatever openwebui sizes left.
    set_chunks(api, *DEFAULT_CHUNK)
    knowledge, failed = api.fill_collection(
        knowledge_name, f"Everything {name} built during the workshop.", sorted(files))
    shutil.rmtree(tmp, ignore_errors=True)
    wiki = "wiki__index.md" in {label for label, _ in files}
    # The tool even if it could not start now (said above): openwebui start brings it back, and the chatbot keeps it.
    forms = chatbot_forms(name, instructions, knowledge, skill_ids, service, model, wiki=wiki,
                          tool_ids=[MCP_TOOL_ID] if mcp_wanted() else [])
    wanted = native_id + RAG_SUFFIX if rag else native_id
    other = native_id if rag else native_id + RAG_SUFFIX
    # The other one uses the knowledge base made again just now: it is rebuilt too, from the same files.
    also = api.model_exists(other)
    for model_id in (wanted, other) if also else (wanted,):
        form = forms[model_id]
        if model_id == native_id:
            excerpts_without_tools(form["name"], form["params"], form["meta"], service, model)
        api.save_model(form)
    drop_old_skills(api, own, set(skill_ids), users)
    reload_models(api)
    if failed:
        fail("Some files could not be added (see above). Type the same command again.")
    # Say what went into the Instructions box: the pair cannot see it from the chat.
    text = [line.strip() for line in instructions.splitlines()
            if line.strip() and not line.lstrip().startswith("#")]
    if text:
        start = text[0] if len(text[0]) <= 70 else text[0][:70].rsplit(" ", 1)[0] + "…"
        print(f'\nInstructions: your AGENTS.md, {len(text)} lines. It starts with: "{start}"')
    else:
        print("\nWarning: your AGENTS.md is still empty, so this chatbot has no instructions.\n"
              "Fill it in (workshop 1), then type the same command again.")
    if skill_ids:
        print(f"Your skills came along: {', '.join(skill_names(api, skill_ids))}. Their whole text goes with every "
              "message, and the chatbot cannot change them.")
    if wiki:
        print("Your wiki came with its map (wiki__index.md): each link names the file of another page.")
    if mcp_wanted():
        print(f'"{forms[native_id]["name"]}" has the live tool of mcp/, as in mode D: fire_danger (today\'s level, read '
              "from mcp/fire-danger.json) and territories. Read-only. Under the message box, the wrench icon shows it."
              + ("" if tools else " It is not running now: type openwebui start."))
    if also:
        print(f'"{forms[other]["name"]}" was updated too: it uses the same knowledge.')
    if rag:
        top_k = (api.request("GET", "/retrieval/config") or {}).get("TOP_K", TOP_K)
        print(f'Before each answer, Open WebUI gives "{name} chatbot (RAG)" the {top_k} excerpts closest to the '
              f'question, as for "{RAG_NAME}" (openwebui top-k changes the number).')
        if not also:
            print(f'To also have the chatbot that searches by itself: openwebui chatbot --name "{name}"')
    print(f'Ready. In Open WebUI ({address()}): New Chat, then choose "{forms[wanted]["name"]}" in the message box '
          "(bottom right).")
    print("To check the instructions, ask it: Who are you?")
    print("Ask it your test questions again, and compare with scores.md.")


# --- Class mode commands ------------------------------------------------------------------------

EVERYONE = [{"principal_type": "user", "principal_id": "*", "permission": "read"}]


class _NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, *args, **kwargs):
        return None


def port_is_public():
    """True or False in a Codespace, None when it cannot tell. Asked from outside: a private port
    sends the visitor to GitHub's sign-in; a public one lets the request through."""
    if not os.environ.get("CODESPACE_NAME"):
        return None
    try:
        with urllib.request.build_opener(_NoRedirect).open(f"{address()}/health", timeout=15):
            return True
    except urllib.error.HTTPError as e:
        return False if e.code in (301, 302, 303, 307, 308, 401, 403) else None
    except (urllib.error.URLError, http.client.HTTPException, OSError):
        return None


def refuse_public_port(then="type openwebui start again", interactive=True):
    """The kit's Open WebUI has no accounts: on a public port, anyone with the link could chat with
    the pair's key. Makes the port private while Open WebUI still runs (by itself when GitHub allows
    it, else click by click in a terminal), or stops Open WebUI and refuses. Limits: checked when a
    command starts (a port made public later is not seen); only "Public" is seen, not "Private to
    Organization"; outside a Codespace, port_is_public() cannot tell, and nothing is refused."""
    if CLASS or port_is_public() is not True:
        return
    print(f"\nPort {PORT} is public: anyone with the link could chat with your key.", flush=True)
    if interactive and sys.stdin.isatty() and sys.stdout.isatty():
        if set_port(public=False):
            return
    elif gh_set_visibility("private"):
        time.sleep(3)
        if port_is_public() is False:
            print(f"Port {PORT} is now private.", flush=True)
            return
    docker("stop", CONTAINER)
    fail(f"Open WebUI was stopped, because port {PORT} is public.\n"
         f"In the Ports tab (next to Terminal), right-click on the line Open WebUI (port {PORT}) "
         f"-> Port Visibility -> Private.\n"
         f"If that line is not there: click Forward a Port, type {PORT}, press Enter, then set it to Private.\n"
         f"Then {then}.")


def gh_set_visibility(visibility):
    """Asks GitHub to change the port's visibility. It works only if gh may manage Codespaces here."""
    name = os.environ.get("CODESPACE_NAME")
    if not name or not shutil.which("gh"):
        return False
    try:
        result = subprocess.run(["gh", "codespace", "ports", "visibility", f"{PORT}:{visibility}",
                                 "-c", name], capture_output=True, text=True, timeout=30)
    except subprocess.TimeoutExpired:
        return False
    return result.returncode == 0


def set_port(public):
    """Makes the port public (share open) or private (share close): by itself when GitHub allows it,
    otherwise by guiding the facilitator, click by click, and checking after each Enter.
    Returns True when the port is checked to be as wanted."""
    want = "Public" if public else "Private"
    state = port_is_public()
    if state is None:
        print(f"\nThis command cannot check port {PORT} here. In the Ports tab, set its visibility to {want}.")
        return False
    if state == public:
        print(f"\nPort {PORT} is {want.lower()}.")
        return True
    if gh_set_visibility(want.lower()):
        time.sleep(3)
        if port_is_public() == public:
            print(f"\nPort {PORT} is now {want.lower()}.")
            return True
    rule = "=" * 72
    if public:
        title = " YOUR TURN: make the link public. For now, only you can open it."
    else:
        title = " LAST STEP: make the link private again, so that nobody new can open it."
    print(f"\n{rule}\n{title}\n"
          f"   1. At the bottom of the window, click the Ports tab (next to Terminal).\n"
          f"   2. Right-click on the line Open WebUI (port {PORT}).\n"
          f'   3. Choose "Port Visibility", then "{want}".\n'
          f"   4. Come back to this terminal and press Enter.\n{rule}")
    while True:
        try:
            input("Press Enter when it is done (Ctrl+C to stop here): ")
        except (EOFError, KeyboardInterrupt):
            print(f"\nNot checked. Set port {PORT} to {want} in the Ports tab.")
            return False
        state = port_is_public()
        if state == public:
            print(f"Done: port {PORT} is now {want.lower()}.")
            return True
        if state is None:
            print(f"This command cannot check it. Make sure port {PORT} is {want} in the Ports tab.")
            return False
        print(f'Port {PORT} is still {"private" if public else "public"}. In the menu, choose "{want}".')


def show_link():
    url = address()
    print(f"\nThe link for the participants: {url}")
    if shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "2", url], check=False)
    print("They first see a warning page from GitHub: they click Continue.")


def cmd_class_start():
    check_docker()
    _, made_now = class_secrets()
    model = start_container()
    key, service, _ = provider()
    api = OpenWebUI().login()
    version = api.request("GET", "/api/config").get("version")
    api.request("POST", "/users/user/settings/update", body={"ui": {"version": version}})
    realign_models(api, key, service, model)
    name_second_model_chatbots(api, key, model)
    admin, _ = class_secrets()
    print("\nSign-ups are " + ("OPEN: participants can join. Not in a session? Type: openwebui share close"
                               if signup_is_open() else "closed. In a session: openwebui share open"))
    warn_young_people(service)
    # Last, in a frame: after the download, this is what the facilitator must not miss. The password is
    # shown until one start has shown it (this terminal may later be on the projector): a first start
    # that stopped halfway, after the password was made, still shows it next time.
    shown = state_dir() / "password-shown"
    show_account(admin, with_password=made_now or not shown.exists())
    shown.touch()


def show_account(admin, with_password):
    rule = "=" * 72
    password = admin["password"] if with_password else "openwebui password shows it (never on the projector)"
    print(f"\n{rule}\n"
          f" Open WebUI is ready. Open it and sign in with YOUR account (administrator):\n\n"
          f"   Address:  {address()}\n"
          f"   E-mail:   {admin['email']}\n"
          f"   Password: {password}\n\n"
          f" Keep this password for you (do not show it on the projector).\n"
          f" To see it again: openwebui password\n"
          f" If it does not open: Ports tab -> Open WebUI -> Open in Browser.\n{rule}")


def cmd_share_open():
    check_docker()
    key, service, model = provider()
    set_signup(True)
    start_container()  # recreated with sign-ups on; sessions are kept (fixed session key)
    api = OpenWebUI().login()
    realign_models(api, key, service, model)  # also the chatbots made in Workspace -> Models since start
    # Participants need read access to each chatbot, to the model under it and to its documents:
    # without the last one, a chatbot answers without its documents, and says nothing.
    # Active chatbots only: a chatbot switched off in Workspace -> Models stays hidden from participants.
    chatbots = [m for m in api.request("GET", "/models/all")
                if m.get("base_model_id") and m.get("is_active", True)]
    for base in base_models(key, model):
        api.request("POST", "/models/model/access/update",
                    body={"id": base, "name": base, "access_grants": EVERYONE})
        # The plain model stays out of the participants' list: they use your chatbots. A participant can
        # still reach it by its id: without tools (plain_model).
        api.save_model(plain_model(base, service, hidden=True))
    for bot in chatbots:
        api.request("POST", "/models/model/access/update",
                    body={"id": bot["id"], "name": bot["name"], "access_grants": EVERYONE})
        for item in (bot.get("meta") or {}).get("knowledge") or []:
            if isinstance(item, dict) and item.get("id"):
                try:
                    api.request("POST", f"/knowledge/{item['id']}/access/update",
                                body={"access_grants": EVERYONE})
                except ApiError as e:
                    if e.status != 404:  # a single file, not a knowledge base
                        raise
        # Its attached skills too: Open WebUI leaves out of a participant's message a skill they cannot read.
        for skill_id in (bot.get("meta") or {}).get("skillIds") or []:
            try:
                api.request("POST", f"/skills/id/{urllib.parse.quote(skill_id)}/access/update",
                            body={"access_grants": EVERYONE})
            except ApiError as e:
                if e.status != 404:  # a skill deleted in Workspace -> Skills
                    raise
    reload_models(api)
    print("\nSign-ups are OPEN. The participants can use these chatbots:")
    for bot in chatbots:
        print(f"  - {bot['name']}")
    if not chatbots:
        print("  (none yet: create one in Workspace -> Models, then type openwebui share open again)")
    for bot in chatbots:
        left_on = wide_tools_on(bot)
        if left_on:
            print(f'\nWarning: "{bot["name"]}" can also search the participant\'s other conversations, keep '
                  "task lists or read skills.\n  To turn this off: Workspace -> Models -> this chatbot -> "
                  f"Builtin Tools: turn off {', '.join(left_on)}, then Save & Update.")
    warn_young_people(service)
    set_port(public=True)
    show_link()
    print("Each participant signs up (a first name or a nickname, never their full name), then chats.")
    print("At the end of the session: openwebui share close")


def cmd_share_close():
    check_docker()
    key, service, model = provider()
    set_signup(False)
    start_container()
    api = OpenWebUI().login()
    realign_models(api, key, service, model)  # a new container takes the model saved today
    for base in base_models(key, model):  # back in your list, to build new chatbots on it
        if api.model_exists(base):
            api.save_model(plain_model(base, service, hidden=False))
    reload_models(api)
    print("\nSign-ups are closed: nobody new can create an account.")
    set_port(public=False)
    print("Your chatbots and the participants' accounts and conversations are kept.")
    print("Next session: openwebui share open")


def cmd_share_status():
    check_docker()
    api = OpenWebUI().login()
    users = api.request("GET", "/users/", query={"page": 1})
    count = users.get("total") if isinstance(users, dict) else len(users or [])
    public = port_is_public()
    print("Sign-ups:", "open" if signup_is_open() else "closed")
    print("Port", PORT, ":", {True: "public", False: "private", None: "unknown"}[public])
    print("Accounts (you included):", count)
    if signup_is_open():
        # What share open set on each base model. "Reset" on a base model in Admin Panel -> Settings
        # -> Models deletes it: then the chatbots built on it stop working for participants.
        key, _, model = provider()
        saved = {m["id"]: m for m in api.request("GET", "/models/all")}
        for base in base_models(key, model):
            row = saved.get(base)
            shared = row and any(g.get("principal_type") == "user" and g.get("principal_id") == "*"
                                 and g.get("permission") == "read" for g in row.get("access_grants") or [])
            if not shared:
                print(f"Warning: {base}: participants cannot use the chatbots built on it.\n"
                      "  Type openwebui share open again.")
            elif not (row.get("meta") or {}).get("hidden"):
                print(f"Warning: {base}: participants see this plain model next to your chatbots.\n"
                      "  Type openwebui share open again.")


EXPORT_HOW_TO = """# {name}: your chatbot, ready to keep and rebuild

Exported from Open WebUI on {date} by `openwebui export` (Youth AI Lab guide:
https://github.com/Youth-AI-Lab/yal-openwebui-guide).

## What is inside

- `instructions.md`: the System Prompt of the chatbot. This is the **Instructions** box.
- `knowledge/`: {count} documents, as you uploaded them. This is the **Knowledge** box.
- `skills/`: {skills} skills attached to the chatbot, one `SKILL.md` each (Workspace -> Skills).
- `openwebui.json`: the rest of its settings in Open WebUI (name, description, base model,
  starter questions, capabilities such as Memory, image).

The participants' accounts and conversations are not in this file.

## Rebuild it

- **Open WebUI, with the guide** (in a new Codespace, for example): drag this file into the file
  list, then type `openwebui import {file}`. It brings back the skills too.
- **Claude Project** (claude.ai): create a project, paste `instructions.md` into the project
  instructions, and add the files in `knowledge/` to the project knowledge.
- **Gemini Gem** (gemini.google.com): create a Gem, paste `instructions.md` into its
  instructions, and upload the files in `knowledge/` as its knowledge.
- **Another Open WebUI**: create a knowledge base with the files in `knowledge/`, then a model with
  `instructions.md` as its System Prompt and this knowledge base attached. Add each `SKILL.md` in
  Workspace -> Skills, then attach them to the model.

A Claude Project and a Gemini Gem have two boxes only, Instructions and Knowledge: no box for a
skill. To keep one, paste its steps at the end of the instructions, with the sentence that says
when to use them.

## Before you trust it

Ask it your test questions again (guide, part 3): the tool changes, the test does not.
"""


def knowledge_items(api, bot):
    """The documents of a chatbot: [(knowledge base or None, file)], from each knowledge base it
    uses and from single files attached to it."""
    found = []
    for item in (bot.get("meta") or {}).get("knowledge") or []:
        if not isinstance(item, dict) or not item.get("id"):
            continue
        try:
            base = api.request("GET", f"/knowledge/{item['id']}")
        except ApiError as e:
            if e.status != 404:
                raise
            found.append((None, item))  # a single file, not a knowledge base
            continue
        found += [(base, f) for f in api.files_of(item["id"])]
    return found


def drop_file_refs(meta):
    """Removes from a chatbot's settings the files that stay in this Open WebUI (voice avatar,
    background image): another Open WebUI refuses a chatbot that names them. Returns what was removed."""
    dropped = []
    if meta.pop("voice_avatar", None):
        dropped.append("voice avatar")
    # Only a file of the same Open WebUI is accepted (0.12.4), not even "": none can carry over.
    if meta.get("background_image_url") is not None and meta.pop("background_image_url"):
        dropped.append("background image")
    return dropped


def cmd_export():
    check_docker()
    api = OpenWebUI().login()
    chatbots = [m for m in api.request("GET", "/models/all") if m.get("base_model_id")]
    if not chatbots:
        fail("No chatbot to export yet: create one in Workspace -> Models.")
    folder = KIT / "exports"
    folder.mkdir(exist_ok=True)
    print(f"Exporting {len(chatbots)} chatbot(s) to {folder.name}/:")
    for bot in chatbots:
        meta = {k: v for k, v in (bot.get("meta") or {}).items() if k != "knowledge"}
        left_out = drop_file_refs(meta)
        params = dict(bot.get("params") or {})
        bases, files, used = {}, [], set()
        for base, f in knowledge_items(api, bot):
            name = f.get("filename") or (f.get("meta") or {}).get("name") or f.get("name") or f["id"]
            if name in used:  # two documents with the same name in two knowledge bases
                name = f"{slug(base['name'] if base else 'file')}__{name}"
            used.add(name)
            files.append((name, api.download(f["id"])))
            key = base["id"] if base else ""
            entry = bases.setdefault(key, {"name": base["name"] if base else f"{bot['name']} documents",
                                           "description": (base or {}).get("description", ""), "files": []})
            entry["files"].append(name)
        skills = []  # [(id, text)]: the skills attached to it, as Open WebUI keeps them
        for skill_id in meta.get("skillIds") or []:
            skill = get_skill(api, skill_id) if isinstance(skill_id, str) and SKILL_MEMBER.match(
                f"skills/{skill_id}/SKILL.md") else None
            if skill:
                skills.append((skill_id, skill.get("content") or ""))
        target = folder / f"{slug(bot['name'])}.zip"
        info = {"format": "yal-openwebui-chatbot/1", "id": bot["id"], "name": bot["name"],
                "base_model_id": bot["base_model_id"], "is_active": bot.get("is_active", True),
                "meta": meta, "params": {k: v for k, v in params.items() if k != "system"},
                "knowledge": list(bases.values())}
        with zipfile.ZipFile(target, "w", zipfile.ZIP_DEFLATED) as archive:
            archive.writestr("README.md", EXPORT_HOW_TO.format(
                name=bot["name"], date=time.strftime("%Y-%m-%d"), count=len(files), skills=len(skills),
                file=f"exports/{target.name}"))
            archive.writestr("instructions.md", (params.get("system") or "").strip() + "\n")
            archive.writestr("openwebui.json", json.dumps(info, indent=2, ensure_ascii=False) + "\n")
            for name, data in files:
                archive.writestr(f"knowledge/{name}", data)
            for skill_id, text in skills:
                archive.writestr(f"skills/{skill_id}/SKILL.md", text)
        with_skills = f", {len(skills)} skill{'' if len(skills) == 1 else 's'}" if skills else ""
        print(f"  {bot['name']}: {folder.name}/{target.name} ({len(files)} documents{with_skills})")
        if left_out:
            print(f"    Not in the file: its {' and '.join(left_out)} (after an import, add "
                  f"{'them' if len(left_out) > 1 else 'it'} again in Workspace -> Models).")
    print(f"\nTo keep them on your computer: in the file list, folder {folder.name}/, right-click on a")
    print("file, then Download... The participants' accounts and conversations are not in these files.")
    print("To rebuild a chatbot later, in a new Codespace for example: openwebui import <file>")


def cmd_import(path_text):
    path = Path(path_text).expanduser()
    if not path.exists():
        path = KIT / path_text
    if not path.is_file() or not zipfile.is_zipfile(path):
        fail(f"{path_text}: no such .zip file. Drag the file into the file list first, then type:\n"
             "openwebui import <its name>")
    key, service, model = provider()
    check_docker()
    check_same_key(key, model)
    api = OpenWebUI().login()
    with zipfile.ZipFile(path) as archive:
        names = archive.namelist()
        if "instructions.md" not in names:
            fail("This .zip is not a chatbot made by openwebui export or chatbot-export.")
        info = json.loads(archive.read("openwebui.json")) if "openwebui.json" in names else {}
        system = archive.read("instructions.md").decode().strip()
        skills = package_skills(archive)
        title = ""
        if "README.md" in names:
            first = archive.read("README.md").decode().splitlines()[:1]
            title = re.sub(r"^#\s*|\s*(:| -) your chatbot.*$", "", first[0]).strip() if first else ""
        tmp = Path(tempfile.mkdtemp())
        documents = {}
        for member in names:
            if member.startswith("knowledge/") and not member.endswith("/") and ".." not in member:
                target = tmp / Path(member).name
                target.write_bytes(archive.read(member))
                documents[target.name] = target
    try:
        if info:
            name = info["name"]
            groups = info.get("knowledge") or []
        else:  # a package of chatbot-export (workshop kit): one knowledge base, the kit's addendum
            name = f"{title or path.stem} chatbot"
            system += CHATBOT_ADDENDUM + (CHATBOT_WIKI_ADDENDUM if "wiki__index.md" in documents else "")
            groups = [{"name": f"{title or path.stem} knowledge", "description": "",
                       "files": sorted(documents)}] if documents else []
        refs, failed = [], []
        for group in groups:
            files = [(n, documents[n]) for n in group.get("files", []) if n in documents]
            print(f'Knowledge base "{group["name"]}": {len(files)} documents…', flush=True)
            base, bad = api.fill_collection(group["name"], group.get("description", ""), files)
            failed += bad
            refs.append({"id": base["id"], "name": base["name"],
                         "description": base.get("description", ""), "type": "collection"})
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    available = base_models(key, model)
    base_model = info.get("base_model_id") if info.get("base_model_id") in available else model
    if info.get("base_model_id") and base_model != info["base_model_id"]:
        print(f'Its base model {info["base_model_id"]} is not offered here: it uses {base_model}.')
    meta = dict(info.get("meta") or {})
    if not info:
        meta = {"description": f"Imported from {path.name}.",
                "capabilities": {**NO_TOOLS, "builtin_tools": True}}
    # Built-in tools: a package of chatbot-export gets the knowledge tools only; an export of the guide gets
    # IMPORTED_TOOLS. The package can switch more off (Open WebUI writes builtinTools when someone switched
    # a category off in Workspace -> Models), never on: a .zip can come from anywhere.
    tools = dict(IMPORTED_TOOLS if info else KNOWLEDGE_TOOLS_ONLY)
    asked = meta.get("builtinTools") if isinstance(meta.get("builtinTools"), dict) else {}
    tools.update({category: False for category, on in asked.items() if category in tools and on is False})
    meta["builtinTools"] = tools
    # Workspace tools, filters and actions of the old Open WebUI: not in the file, and a new one could have others
    # with the same id. Its skills: only those the file brings (skills/), never one already here with the same id.
    others = [kind for kind in ("toolIds", "filterIds", "actionIds") if meta.pop(kind, None)]
    if others:
        print("Its workspace tools, filters or actions are not imported: add the ones you trust again "
              "in Workspace -> Models.")
    asked = meta.pop("skillIds", None)
    model_id = info.get("id") or "chatbot-" + slug(name)
    skill_ids = save_skills(api, skills, {model_id}, skill_users(api))
    if skill_ids:
        meta["skillIds"] = skill_ids
    missing = [s for s in (asked if isinstance(asked, list) else []) if s not in {f for f, _ in skills}]
    if missing:
        print(f"Its skills {', '.join(map(str, missing))} are not in the file: add the ones you trust again in "
              "Workspace -> Models.")
    left_out = drop_file_refs(meta)  # an export made by an older version of this command may name them
    if left_out:
        print(f"Its {' and '.join(left_out)} {'stay' if len(left_out) > 1 else 'stays'} in the old Open WebUI: "
              f"add {'them' if len(left_out) > 1 else 'it'} again in Workspace -> Models.")
    meta["knowledge"] = refs
    params = routed(info.get("params") or {"function_calling": "native"}, service)
    params["system"] = system
    excerpts_without_tools(name, params, meta, service, base_model)
    replaced = api.model_exists(model_id)
    api.save_model({"id": model_id, "base_model_id": base_model, "name": name,
                    "is_active": info.get("is_active", True), "meta": meta, "params": params})
    reload_models(api)
    if failed:
        fail("Some documents could not be added (see above). Type the same command again.")
    print(f'\n{"Replaced" if replaced else "Imported"}: "{name}", with {sum(len(g.get("files", [])) for g in groups)} '
          "documents. Check it in Workspace -> Models, then test it (guide, part 3).")
    kept = [label for category, label in (("knowledge", "Knowledge Base"), ("memory", "Memory"),
                                          ("time", "Time & Calculation"), ("user_input", "Ask User"))
            if tools[category]]
    print(f"Its Builtin Tools: {', '.join(kept) or 'none'} (the others are off).")
    if skill_ids:
        print(f"Its skills: {', '.join(skill_names(api, skill_ids))}. Their whole text goes with every message.")
    print("In a session, type openwebui share open so that the participants see it.")


def cmd_password():
    admin, _ = class_secrets()
    show_account(admin, with_password=True)
    print(f"(kept in {state_dir() / 'admin.json'}, readable only by you)")


def cmd_reset():
    check_docker()
    print("This deletes Open WebUI's data here: your chatbots, documents, accounts and conversations.")
    if input('Type "delete" to go on: ').strip() != "delete":
        fail("Nothing was deleted.")
    docker("rm", "-f", CONTAINER)
    docker("volume", "rm", VOLUME)
    for name in ("admin.json", "signup", "password-shown"):
        (state_dir() / name).unlink(missing_ok=True)
    print("Deleted. Type openwebui start to begin again.")


def cmd_stop():
    check_docker()
    stopped = docker("rm", "-f", CONTAINER).returncode == 0
    # The live tool of workshop 4 and its network (none in class mode, nor before workshop 4: nothing happens then).
    docker("rm", "-f", MCP_CONTAINER)
    docker("network", "rm", MCP_NETWORK)
    if stopped:
        print("Open WebUI is stopped. Your data is kept: openwebui start opens it again.")


def class_command(argv):
    commands = {("start",): cmd_class_start, ("share", "open"): cmd_share_open,
                ("share", "close"): cmd_share_close, ("share", "status"): cmd_share_status,
                ("password",): cmd_password, ("reset",): cmd_reset, ("stop",): cmd_stop,
                ("export",): cmd_export}
    if argv[:1] == ["import"]:
        if len(argv) != 2:
            fail("Usage: openwebui import <file.zip>")
        return cmd_import(argv[1])
    command = commands.get(tuple(argv))
    if not command:
        fail("Unknown command. See: openwebui help")
    command()


def main(argv):
    command = argv[0] if argv else "help"
    if command in ("help", "-h", "--help"):
        print(CLASS_HELP if CLASS else __doc__.strip())
    elif CLASS:
        class_command(argv)
    elif command in ("share", "password", "reset"):
        fail("Sharing needs accounts, and this Open WebUI has none: it is for you only.\n"
             "Never make its port public. To open chatbots to a group, use the Open WebUI guide.")
    elif command == "start" and len(argv) == 1:
        cmd_start()
    elif command == "query" and len(argv) >= 2:
        cmd_query(*parse_query(argv[1:]))
    elif command == "sizes" and len(argv) == 1:
        cmd_sizes()
    elif command == "top-k" and len(argv) == 2:
        cmd_top_k(argv[1])
    elif command == "chatbot":
        cmd_chatbot(argv[1:])
    elif command == "stop" and len(argv) == 1:
        cmd_stop()
    elif command == "check-key" and len(argv) == 1:
        provider()   # used by workshop-start 2 before it starts Open WebUI: a clear message at once
        print("Key OK for Open WebUI.")
    elif command == "check-same-key" and len(argv) == 1:
        # Used by replay RAG: says nothing when Open WebUI still has the saved key and model.
        check_docker()
        key, _, model = provider()
        check_same_key(key, model)
    elif command == "check-private" and len(argv) == 1:
        check_docker()
        # Used by replay RAG before its first question (its output is captured: no questions asked).
        refuse_public_port(then="type openwebui start, then replay RAG again", interactive=False)
    else:
        fail("Unknown command. See: openwebui help")


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except ApiError as e:
        fail(f"Open WebUI refused a request ({e}).\n"
             "Type openwebui start again. If it happens again, "
             + ("open an issue: https://github.com/Youth-AI-Lab/yal-openwebui-guide/issues" if CLASS
                else "ask the facilitator."))
